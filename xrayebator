_migrate_dead_stealth_routes_2026() {
  local profile_file uuid ports_json removals_json='[]'
  local changed_profiles=()

  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ -f "$profile_file" ]] || continue
    if ! jq -e '
      any((.routes // [])[];
        .label == "tcp-stealth-8443" or .label == "tcp-stealth-2053"
      )
    ' "$profile_file" >/dev/null 2>&1; then
      continue
    fi

    uuid=$(jq -r '.uuid // empty' "$profile_file" 2>/dev/null)
    ports_json=$(jq -c '[
      (.routes // [])[] |
      select(.label == "tcp-stealth-8443" or .label == "tcp-stealth-2053") |
      .port |
      select(type == "number")
    ] | unique' "$profile_file" 2>/dev/null)
    if [[ -z "$uuid" ]] || ! jq -e 'type == "array" and length > 0' <<< "$ports_json" >/dev/null 2>&1; then
      echo -e "${RED}  ✗ Некорректный legacy stealth route: $(basename "$profile_file")${NC}"
      return 2
    fi

    removals_json=$(jq -c --arg uuid "$uuid" --argjson ports "$ports_json" \
      '. + [{uuid:$uuid, ports:$ports}]' <<< "$removals_json") || return 2
    changed_profiles+=("$profile_file")
  done

  [[ ${#changed_profiles[@]} -gt 0 ]] || return 1

  if ! safe_jq_write --argjson removals "$removals_json" '
    .inbounds |= map(
      . as $inbound |
      [
        $removals[] |
        select((.ports | index($inbound.port)) != null) |
        .uuid
      ] as $remove_uuids |
      if ($remove_uuids | length) > 0 then
        .settings.clients = (
          (.settings.clients // []) |
          map(. as $client | select(($remove_uuids | index($client.id)) == null))
        ) |
        if (.settings.clients | length) == 0 then empty else . end
      else
        .
      end
    )
  ' "$CONFIG_FILE"; then
    echo -e "${RED}  ✗ Не удалось удалить legacy stealth UUID из config.json${NC}"
    return 2
  fi

  for profile_file in "${changed_profiles[@]}"; do
    if ! safe_jq_write '
