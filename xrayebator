_selfsteal_ensure_443_inbound() {
  local domain=$1
  if jq -e '.inbounds[]? | select(.port == 443)' "$CONFIG_FILE" >/dev/null 2>&1; then
    return 0
  fi

  local short_id
  short_id=$(openssl rand -hex 4)
  local inbound
  inbound=$(jq -n \
    --arg domain "$domain" \
    --arg dest "$SELFSTEAL_DEST" \
    --arg private_key "$PRIVATE_KEY" \
    --arg short_id "$short_id" \
    '{
      listen:"0.0.0.0",
      port:443,
      protocol:"vless",
      settings:{clients:[],decryption:"none"},
      streamSettings:{
        network:"tcp",
        security:"reality",
        realitySettings:{
          show:false,
          dest:$dest,
          xver:0,
          serverNames:[$domain],
          privateKey:$private_key,
          shortIds:[$short_id]
        }
      },
      sniffing:{enabled:true,destOverride:["http","tls","quic"],routeOnly:true},
      tag:"inbound-443"
    }')

  safe_jq_write --argjson inbound "$inbound" '.inbounds += [$inbound]' "$CONFIG_FILE"
}

_selfsteal_apply_to_reality_inbounds() {
  local domain=$1
  local reality_ports
  local rollback_config=""
  reality_ports=$(jq -r '.inbounds[]? | select(.streamSettings.security == "reality") | .port' "$CONFIG_FILE" 2>/dev/null)
  backup_config "selfsteal_$domain" rollback_config || return 1

  if ! _selfsteal_ensure_443_inbound "$domain"; then
    echo -e "${RED}✗ Не удалось создать служебный inbound 443${NC}"
    return 1
  fi

  if ! safe_jq_write --arg domain "$domain" --arg dest "$SELFSTEAL_DEST" '
    .inbounds |= map(
      if .streamSettings.security == "reality" then
        .streamSettings.realitySettings.dest = $dest |
        .streamSettings.realitySettings.serverNames = [$domain] |
        if .streamSettings.network == "xhttp" then
          .streamSettings.xhttpSettings.host = $domain
        else
          .
        end
      else
        .
      end
    )
  ' "$CONFIG_FILE"; then
    echo -e "${RED}✗ Не удалось применить self-steal к Reality inbound${NC}"
    return 1
  fi

  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    return 1
  fi

  local port
  for port in $reality_ports; do
    update_all_profiles_on_port "$port" "sni" "$domain" || {
      echo -e "${RED}✗ Не удалось синхронизировать SNI в profile JSON для порта $port${NC}"
      return 1
    }
  done
  update_all_profiles_on_port 443 "sni" "$domain" >/dev/null 2>&1 || true
}

