      echo -e "  ${CYAN}sudo xrayebator awg-31 --on|--off${NC} — режим AWG 3.1 (HeaderProtection+RandomTrailers; JSON)"
      echo ""
      echo -e "${YELLOW}Файлы:${NC}"
      echo -e "  config:    /usr/local/etc/xray/config.json"
      echo -e "  profiles:  /usr/local/etc/xray/profiles/"
      echo -e "  backups:   /usr/local/etc/xray/backups/"
      echo -e "  backends:  /usr/local/etc/xrayebator/backends.json"
      echo -e "  docs:      https://github.com/howdeploy/Xrayebator"
      exit 0
      ;;
    *)
      echo -e "${RED}✗ Неизвестная команда: $1${NC}"
      echo -e "${YELLOW}Подсказка:${NC} запустите ${CYAN}sudo xrayebator --help${NC}"
      exit 1
      ;;
  esac
fi
