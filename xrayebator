# ═══ Файловая блокировка (B5-fix) ═══
# Сериализует мутации config.json между независимыми процессами (GUI + CLI + cron).
# В средах без flock (Git Bash/тесты) — безопасный no-op.
_lock_acquire() {
  if ! command -v flock >/dev/null 2>&1; then return 0; fi
  # Явно открываем fd, чтобы flock удержал блокировку весь срок жизни функции.
  exec {XB_LOCK_FD}>"$LOCK_FILE" 2>/dev/null || return 0
  flock "$XB_LOCK_FD" 2>/dev/null || return 0
  return 0
}
_lock_release() {
  if [[ -n "${XB_LOCK_FD:-}" ]]; then
    flock -u "$XB_LOCK_FD" 2>/dev/null
    exec {XB_LOCK_FD}>&- 2>/dev/null
    XB_LOCK_FD=""
  fi
  return 0
}

# ═══ Детекция IPv6-only VPS (shared helper) ═══
