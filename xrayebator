# Versions before 3.0 installed this exact bare UDP/443 block. It can break
# Telegram while a separate TCP route probe remains green. Remove only the
# canonical project-managed object; operator rules with extra selectors stay.
# Returns: 0=changed, 1=no-op, 2=write/read failure.
migrate_legacy_managed_udp443_block_v3() {
  local legacy_rule_count
  legacy_rule_count=$(jq -r '
    [
      .routing.rules[]?
      | select(. == {
