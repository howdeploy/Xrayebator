_reality_dest_for_sni() {
  local sni="$1"
  local selfsteal_domain selfsteal_dest
  selfsteal_domain=$(_selfsteal_domain_value 2>/dev/null || true)
  if [[ -n "$selfsteal_domain" && "$sni" == "$selfsteal_domain" ]]; then
    selfsteal_dest=$(cat "$SELFSTEAL_DEST_FILE" 2>/dev/null || true)
    [[ -z "$selfsteal_dest" ]] && selfsteal_dest="$SELFSTEAL_DEST"
    echo "$selfsteal_dest"
    return 0
  fi
  echo "$sni:443"
}

_default_sni_for_transport() {
  local transport="$1"
  local selfsteal_domain=""
  selfsteal_domain=$(_selfsteal_domain_value)
  if [[ -n "$selfsteal_domain" ]]; then
    echo "$selfsteal_domain"
    return 0
  fi

  case "$transport" in
    grpc)
      echo "www.cloudflare.com"
      ;;
    tcp-xudp)
      echo "api-maps.yandex.ru"
      ;;
    *)
      local from_list
      from_list=$(grep -v '^#' "$SNI_LIST" 2>/dev/null | grep -v '^[[:space:]]*$' | head -n 1 | cut -d'|' -f1)
      # Дефолт 2026-10-06: www.cloudflare.com — самый стабильный (глобальный
      # anycast, TLS1.3, не режется ТСПУ). Список обычно перекрывает фолбэк:
      # берётся первая строка sni_list.txt, она держится cloudflare-first.
      [[ -z "$from_list" ]] && from_list="www.cloudflare.com"
