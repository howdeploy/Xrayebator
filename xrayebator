_selfsteal_domain_value() {
  local d
  d=$(cat "$SELFSTEAL_DOMAIN_FILE" 2>/dev/null || true)
  if [[ -n "$d" && "$d" =~ ^[a-zA-Z0-9.-]+$ ]]; then
    echo "$d"
  fi
}

_reality_dest_for_sni() {
  local sni="$1"
  local selfsteal_domain selfsteal_dest
  selfsteal_domain=$(_selfsteal_domain_value 2>/dev/null || true)
  if [[ -n "$selfsteal_domain" && "$sni" == "$selfsteal_domain" ]]; then
    selfsteal_dest=$(cat "$SELFSTEAL_DEST_FILE" 2>/dev/null || true)
    [[ -z "$selfsteal_dest" ]] && selfsteal_dest="$SELFSTEAL_DEST"
    echo "$selfsteal_dest"
    return 0
  fi
  echo "$sni:443"
}

_default_sni_for_transport() {
  local transport="$1"
  local selfsteal_domain=""
  selfsteal_domain=$(_selfsteal_domain_value)
  if [[ -n "$selfsteal_domain" ]]; then
    echo "$selfsteal_domain"
    return 0
  fi

  case "$transport" in
    grpc)
      echo "www.cloudflare.com"
      ;;
    tcp-xudp)
      echo "api-maps.yandex.ru"
      ;;
    *)
      local from_list
      from_list=$(grep -v '^#' "$SNI_LIST" 2>/dev/null | grep -v '^[[:space:]]*$' | head -n 1 | cut -d'|' -f1)
      [[ -z "$from_list" ]] && from_list="www.google.com"
      echo "$from_list"
      ;;
  esac
}

_selfsteal_ensure_443_inbound() {
  local domain=$1
  if jq -e '.inbounds[]? | select(.port == 443)' "$CONFIG_FILE" >/dev/null 2>&1; then
    return 0
  fi

  local short_id
  short_id=$(openssl rand -hex 4)
  local inbound
  inbound=$(jq -n \
    --arg domain "$domain" \
    --arg dest "$SELFSTEAL_DEST" \
    --arg private_key "$PRIVATE_KEY" \
    --arg short_id "$short_id" \
    '{
      listen:"0.0.0.0",
      port:443,
      protocol:"vless",
      settings:{clients:[],decryption:"none"},
      streamSettings:{
        network:"tcp",
        security:"reality",
        realitySettings:{
          show:false,
          dest:$dest,
          xver:0,
          serverNames:[$domain],
          privateKey:$private_key,
          shortIds:[$short_id]
        }
      },
      sniffing:{enabled:true,destOverride:["http","tls","quic"],routeOnly:true},
      tag:"inbound-443"
    }')

  safe_jq_write --argjson inbound "$inbound" '.inbounds += [$inbound]' "$CONFIG_FILE"
}

_selfsteal_apply_to_reality_inbounds() {
  local domain=$1
  local reality_ports
  local rollback_config=""
  reality_ports=$(jq -r '.inbounds[]? | select(.streamSettings.security == "reality") | .port' "$CONFIG_FILE" 2>/dev/null)
  backup_config "selfsteal_$domain" rollback_config || return 1

  if ! _selfsteal_ensure_443_inbound "$domain"; then
    echo -e "${RED}✗ Не удалось создать служебный inbound 443${NC}"
    return 1
  fi

  if ! safe_jq_write --arg domain "$domain" --arg dest "$SELFSTEAL_DEST" '
    .inbounds |= map(
      if .streamSettings.security == "reality" then
        .streamSettings.realitySettings.dest = $dest |
        .streamSettings.realitySettings.serverNames = [$domain] |
        if .streamSettings.network == "xhttp" then
          .streamSettings.xhttpSettings.host = $domain
        else
          .
        end
      else
        .
      end
    )
  ' "$CONFIG_FILE"; then
    echo -e "${RED}✗ Не удалось применить self-steal к Reality inbound${NC}"
    return 1
  fi

  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    return 1
  fi

  local port
  for port in $reality_ports; do
    update_all_profiles_on_port "$port" "sni" "$domain" || {
      echo -e "${RED}✗ Не удалось синхронизировать SNI в profile JSON для порта $port${NC}"
      return 1
    }
  done
  update_all_profiles_on_port 443 "sni" "$domain" >/dev/null 2>&1 || true
}

install_selfsteal_stub_menu() {
  show_ascii
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
  echo -e "${BLUE}    СОБСТВЕННЫЙ ДОМЕН / SELF-STEAL ЗАГЛУШКА   ${NC}"
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}\n"

  local domain
  echo -n -e "${YELLOW}Домен для Reality SNI: ${NC}"
  read -r domain
  if [[ -z "$domain" || ! "$domain" =~ ^[a-zA-Z0-9.-]+$ ]]; then
    echo -e "${RED}✗ Некорректный домен${NC}"
    sleep 2
    return 1
  fi

  local server_ip resolved_ip
  server_ip=$(get_server_ip)
  resolved_ip=$(getent hosts "$domain" 2>/dev/null | awk '{print $1}' | head -1)
  if [[ -n "$resolved_ip" && -n "$server_ip" && "$resolved_ip" != "$server_ip" ]]; then
    echo -e "${YELLOW}  ⚠ DNS $domain → $resolved_ip, VPS IP = $server_ip${NC}"
    echo -n -e "${YELLOW}Продолжить? (y/N): ${NC}"
    local cont
    read -r cont
    [[ "$cont" =~ ^[yYдД]$ ]] || return 1
  fi

  local template
  template=$(_selfsteal_template_menu)

  local email
  echo -n -e "${YELLOW}Email для Let's Encrypt: ${NC}"
  read -r email
  if [[ -z "$email" || ! "$email" =~ ^[^@]+@[^@]+\.[^@]+$ ]]; then
    echo -e "${RED}✗ Некорректный email${NC}"
    sleep 2
    return 1
  fi

  echo -e "${CYAN}  → Установка nginx + certbot...${NC}"
  if ! apt-get install -y nginx certbot >/dev/null 2>&1; then
    echo -e "${RED}✗ apt-get install nginx certbot не удалось${NC}"
    return 1
  fi

  local certbot_bin
  if [[ -x /snap/bin/certbot ]]; then
    certbot_bin="/snap/bin/certbot"
  else
    certbot_bin=$(command -v certbot 2>/dev/null || true)
  fi
  if [[ -z "$certbot_bin" || ! -x "$certbot_bin" ]]; then
    echo -e "${RED}✗ certbot не найден${NC}"
    return 1
  fi

  local webroot="/var/www/xrayebator-selfsteal-acme"
  local stub_root="/var/www/xrayebator-reality-stub"
  mkdir -p "$webroot/.well-known/acme-challenge"
  chmod -R 755 "$webroot"
  _selfsteal_write_template "$template" "$domain" "$stub_root" || return 1

  cat > /etc/nginx/sites-available/xrayebator-selfsteal << NGINX_SELFSTEAL_HTTP
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    location ^~ /.well-known/acme-challenge/ {
        root ${webroot};
        default_type text/plain;
    }

    location / {
        return 404;
    }
}
NGINX_SELFSTEAL_HTTP

  ln -sf /etc/nginx/sites-available/xrayebator-selfsteal /etc/nginx/sites-enabled/xrayebator-selfsteal
  if ! nginx -t >/tmp/nginx-xrayebator-selfsteal.log 2>&1; then
    echo -e "${RED}✗ nginx -t failed${NC}"
    cat /tmp/nginx-xrayebator-selfsteal.log
    return 1
  fi
  systemctl enable --now nginx >/dev/null 2>&1 || return 1
  systemctl reload nginx >/dev/null 2>&1 || return 1

  if command -v ufw &>/dev/null && ufw status | grep -q "Status: active"; then
    ufw limit 80/tcp >/dev/null 2>&1
    ufw reload >/dev/null 2>&1
  fi

  echo -e "${CYAN}  → Выпуск сертификата для $domain...${NC}"
  if ! "$certbot_bin" certonly \
      --cert-name "$domain" \
      --webroot \
      --webroot-path "$webroot" \
      -d "$domain" \
      --non-interactive \
      --agree-tos \
      -m "$email" \
      --deploy-hook "systemctl reload nginx" \
      >/tmp/certbot-selfsteal.log 2>&1; then
    echo -e "${RED}✗ certbot не смог выдать сертификат. Лог: /tmp/certbot-selfsteal.log${NC}"
    tail -30 /tmp/certbot-selfsteal.log
    return 1
  fi
  # P0-certbot-fix: регистрируем cert в root-owned манифесте.
  _certbot_register "$domain"

  local cert_dir="/etc/letsencrypt/live/${domain}"
  if [[ ! -f "$cert_dir/fullchain.pem" || ! -f "$cert_dir/privkey.pem" ]]; then
    echo -e "${RED}✗ cert files не найдены: $cert_dir${NC}"
    return 1
  fi

  cat > /etc/nginx/sites-available/xrayebator-selfsteal << NGINX_SELFSTEAL_TLS
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    location ^~ /.well-known/acme-challenge/ {
        root ${webroot};
        default_type text/plain;
    }

    location / {
        return 404;
    }
}

server {
    listen ${SELFSTEAL_DEST} ssl http2;
    server_name ${domain};

    ssl_certificate ${cert_dir}/fullchain.pem;
    ssl_certificate_key ${cert_dir}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root ${stub_root};
    index index.html;
    add_header X-Robots-Tag "noindex, nofollow, nosnippet" always;

    location / {
        try_files \$uri /index.html;
    }
}
NGINX_SELFSTEAL_TLS

  if ! nginx -t >/tmp/nginx-xrayebator-selfsteal.log 2>&1; then
    echo -e "${RED}✗ nginx TLS config failed${NC}"
    cat /tmp/nginx-xrayebator-selfsteal.log
    return 1
  fi
  systemctl reload nginx >/dev/null 2>&1 || return 1

  echo -e "${YELLOW}Применить SNI=$domain и dest=$SELFSTEAL_DEST ко всем Reality inbound? (y/N): ${NC}"
  local apply_now
  read -r apply_now
  if [[ "$apply_now" =~ ^[yYдД]$ ]]; then
    _selfsteal_apply_to_reality_inbounds "$domain" || return 1
  fi

  echo "$domain" > "$SELFSTEAL_DOMAIN_FILE"
  echo "$template" > "$SELFSTEAL_TEMPLATE_FILE"
  echo "$SELFSTEAL_DEST" > "$SELFSTEAL_DEST_FILE"
  chown root:root "$SELFSTEAL_DOMAIN_FILE" "$SELFSTEAL_TEMPLATE_FILE" "$SELFSTEAL_DEST_FILE" 2>/dev/null || true

  echo -e "${GREEN}✓ Self-steal заглушка готова: $domain → $SELFSTEAL_DEST${NC}"
  echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
  read -r _
}

