        select(.label != "tcp-stealth-8443" and .label != "tcp-stealth-2053")
      ) |
      if (.routes | length) == 0 then
        error("profile would have no routes")
      else
        .transport = .routes[0].transport |
        .port = .routes[0].port |
        .fingerprint = (.routes[0].fingerprint // "firefox") |
        .sni = .routes[0].sni |
        .pq_enabled = (.routes[0].pq_enabled // false) |
        if .routes[0].transport == "xhttp" then
