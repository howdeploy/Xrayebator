          "network": "udp",
          "port": 443,
          "outboundTag": "block"
        })
    ] | length
  ' "$CONFIG_FILE" 2>/dev/null) || return 2

  [[ "$legacy_rule_count" =~ ^[0-9]+$ ]] || return 2
  if [[ "$legacy_rule_count" -eq 0 ]]; then
    echo -e "${GREEN}✓ Legacy UDP/443 block отсутствует${NC}"
