_detect_ipv6_only() {
  if ip -4 addr show scope global 2>/dev/null | grep -q 'inet '; then
    return 1
  fi
  if ip route get 1.1.1.1 2>/dev/null | grep -q .; then
    return 1
  fi
  return 0
}

_ipv6_query_strategy() {
  if _detect_ipv6_only; then
    echo "UseIP"
  else
    echo "UseIPv4"
