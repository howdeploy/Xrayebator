      shift
      fp_change_command "$@"
      ;;
    sni-change)
      shift
      sni_change_command "$@"
      ;;
    sni-list)
      shift
      sni_list_command
      ;;
    port-change)
      shift
      port_change_command "$@"
      ;;
    bypass)
      shift
      bypass_command "$@"
      ;;
    backend-status)
      _backend_status_json
      ;;
    hysteria2-install)
      shift
      hysteria2_install_command "$@"
      ;;
    hysteria2-uninstall)
      hysteria2_uninstall_command
      ;;
    hysteria2-status)
      hysteria2_status_command
      ;;
    hysteria2-grant)
      shift
      hysteria2_grant_command "$@"
      ;;
    hysteria2-subbody)
      shift
      hysteria2_subbody_command "$@"
      ;;
    hysteria2-link)
      shift
      hysteria2_link_command "$@"
      ;;
    awg-install)
      shift
      awg_install_command "$@"
      ;;
    awg-uninstall)
      awg_uninstall_command
      ;;
    awg-status)
      awg_status_command
      ;;
    awg-grant)
      shift
      awg_grant_command "$@"
      ;;
    awg-conf)
      shift
      awg_conf_command "$@"
      ;;
    awg-31)
      shift
      awg_31_command "$@"
      ;;
    ""|menu)
      main_menu
      ;;
    --help|-h|help)
      echo -e "${CYAN}Xrayebator${NC} — менеджер Xray Reality VPN (обход DPI в РФ)"
      echo ""
      echo -e "${YELLOW}Использование:${NC}"
      echo -e "  ${CYAN}sudo xrayebator${NC}                  — открыть интерактивное меню"
      echo -e "  ${CYAN}sudo xrayebator update [branch]${NC}  — обновить Xray-core (main/dev/experimental)"
      echo -e "  ${CYAN}sudo xrayebator quickstart --email EMAIL${NC}  — авторазвёртывание: подписка+IP-TLS+HAPP profile"
      echo -e "  ${CYAN}sudo xrayebator quickstart --without-email${NC}  — то же, но ACME-регистрация без email (без уведомлений)"
      echo -e "  ${CYAN}sudo xrayebator inspect --json${NC}          — read-only диагностика установки (для GUI-импорта)"
      echo -e "  ${CYAN}sudo xrayebator happ-setup${NC}       — создать/переиспользовать HAPP multi-route профиль"
      echo -e "  ${CYAN}sudo xrayebator probe-test${NC}       — проверить доступность SNI с VPS"
      echo -e "  ${CYAN}sudo xrayebator profiles${NC}          — JSON-список профилей"
      echo -e "  ${CYAN}sudo xrayebator profile-create --name N [--transport T] [--port P] [--count N] [--expire 2006-12-31]${NC}"
      echo -e "                               — создать профиль/семейство профилей (JSON)"
      echo -e "  ${CYAN}sudo xrayebator profile-delete --name N${NC} — удалить профиль (JSON)"
      echo -e "  ${CYAN}sudo xrayebator fp-change --name N [--route R] --fp FINGERPRINT${NC} — сменить fingerprint (JSON)"
      echo -e "  ${CYAN}sudo xrayebator profile-revoke --name N [--full]${NC} — новый sub_token; --full: и новый uuid, старые клиенты отваливаются (JSON)"
      echo -e "  ${CYAN}sudo xrayebator profile-expire --name N --expire 2006-12-31|epoch|none${NC} — срок действия профиля (JSON)"
      echo -e "  ${CYAN}sudo xrayebator expire-check${NC} — применить наступившие сроки (для systemd-таймера) (JSON)"
      echo -e "  ${CYAN}sudo xrayebator sni-list${NC} — список допустимых SNI (JSON)"
      echo -e "  ${CYAN}sudo xrayebator sni-change --name N [--route R] --sni S${NC} — сменить SNI (JSON; обновит все профили на порту)"
      echo -e "  ${CYAN}sudo xrayebator port-change --name N [--route R] --port P|random${NC} — сменить порт (JSON; reconnect клиентов)"
      echo -e "  ${CYAN}sudo xrayebator bypass list${NC} — список доменов в обходе (JSON)"
      echo -e "  ${CYAN}sudo xrayebator bypass add --domain D${NC} — добавить домен в обход (JSON)"
      echo -e "  ${CYAN}sudo xrayebator bypass remove --domain D${NC} — убрать домен из обхода (JSON)"
