    *) echo -e "${RED}Неверный выбор${NC}"; sleep 2; return ;;
  esac
}

create_profile_all_routes() {
  local name="$1"
  local pause_after="${2:-pause}"
  local subscription_output="${3:-show_subscription}"
  local uuid
  uuid=$(uuidgen)

  local sub_token
  sub_token=$(openssl rand -hex 16)
  if [[ ! "$sub_token" =~ ^[a-f0-9]{32}$ ]]; then
    echo -e "${RED}✗ Не удалось сгенерировать sub_token (openssl?)${NC}"
    return 1
  fi

  local default_sni grpc_sni xudp_sni
  default_sni=$(_default_sni_for_transport "tcp")
  grpc_sni=$(_default_sni_for_transport "grpc")
  xudp_sni=$(_default_sni_for_transport "tcp-xudp")

  local routes_tmp
  routes_tmp=$(mktemp /tmp/xrayebator-routes.XXXXXX) || {
    echo -e "${RED}✗ mktemp failed${NC}"
    return 1
  }

  _append_route_json() {
    local route_label="$1" transport="$2" port="$3" sni="$4" fingerprint="$5" pq_enabled="$6" grpc_service_name="$7" xhttp_path="$8"
    if ! jq -n \
      --arg route_label "$route_label" \
      --arg transport "$transport" \
      --argjson port "$port" \
      --arg sni "$sni" \
      --arg fingerprint "$fingerprint" \
      --argjson pq_enabled "$pq_enabled" \
      --arg grpc_service_name "$grpc_service_name" \
      --arg xhttp_path "$xhttp_path" \
      '{
        "label": $route_label,
        transport: $transport,
        port: $port,
        sni: $sni,
        fingerprint: $fingerprint
      }
      + (if $pq_enabled then {pq_enabled: true, schema_version: 2} else {} end)
      + (if $grpc_service_name != "" then {grpc_service_name: $grpc_service_name} else {} end)
      + (if $xhttp_path != "" then {xhttp_path: $xhttp_path} else {} end)' >> "$routes_tmp"; then
      echo -e "${RED}✗ Не удалось собрать JSON маршрута ${route_label}${NC}"
      return 1
    fi
  }

  local defaults port grpc_service_name xhttp_path

  defaults=$(build_transport_defaults "xhttp") || { rm -f "$routes_tmp"; return 1; }
  IFS='|' read -r port _ xhttp_path <<< "$defaults"
  reserve_port "$port"
  _append_route_json "xhttp-legacy" "xhttp" "$port" "$default_sni" "$DEFAULT_CLIENT_FINGERPRINT" false "" "$xhttp_path" || { rm -f "$routes_tmp"; return 1; }

  defaults=$(build_transport_defaults "xhttp") || { rm -f "$routes_tmp"; return 1; }
  IFS='|' read -r port _ xhttp_path <<< "$defaults"
  reserve_port "$port"
  _append_route_json "xhttp-pq" "xhttp" "$port" "$default_sni" "$DEFAULT_CLIENT_FINGERPRINT" true "" "$xhttp_path" || { rm -f "$routes_tmp"; return 1; }

  defaults=$(build_transport_defaults "tcp-mux") || { rm -f "$routes_tmp"; return 1; }
  IFS='|' read -r port _ _ <<< "$defaults"
  reserve_port "$port"
  _append_route_json "tcp-mux" "tcp-mux" "$port" "$default_sni" "$DEFAULT_CLIENT_FINGERPRINT" false "" "" || { rm -f "$routes_tmp"; return 1; }

  defaults=$(build_transport_defaults "grpc") || { rm -f "$routes_tmp"; return 1; }
  IFS='|' read -r port grpc_service_name _ <<< "$defaults"
  reserve_port "$port"
  _append_route_json "grpc" "grpc" "$port" "$grpc_sni" "$DEFAULT_CLIENT_FINGERPRINT" false "$grpc_service_name" "" || { rm -f "$routes_tmp"; return 1; }

  defaults=$(build_transport_defaults "tcp") || { rm -f "$routes_tmp"; return 1; }
  IFS='|' read -r port _ _ <<< "$defaults"
  reserve_port "$port"
  _append_route_json "tcp-vision" "tcp" "$port" "$default_sni" "$DEFAULT_CLIENT_FINGERPRINT" false "" "" || { rm -f "$routes_tmp"; return 1; }

  defaults=$(build_transport_defaults "tcp-utls") || { rm -f "$routes_tmp"; return 1; }
  IFS='|' read -r port _ _ <<< "$defaults"
  reserve_port "$port"
  _append_route_json "tcp-utls-firefox" "tcp-utls" "$port" "$default_sni" "firefox" false "" "" || { rm -f "$routes_tmp"; return 1; }

  defaults=$(build_transport_defaults "tcp-xudp") || { rm -f "$routes_tmp"; return 1; }
  IFS='|' read -r port _ _ <<< "$defaults"
  reserve_port "$port"
  _append_route_json "tcp-xudp" "tcp-xudp" "$port" "$xudp_sni" "$DEFAULT_CLIENT_FINGERPRINT" false "" "" || { rm -f "$routes_tmp"; return 1; }

  local routes_json
  routes_json=$(jq -s '.' "$routes_tmp") || {
    rm -f "$routes_tmp"
    echo -e "${RED}✗ Не удалось собрать JSON маршрутов${NC}"
    return 1
  }
  rm -f "$routes_tmp"

  local route_count
  route_count=$(jq 'length' <<< "$routes_json") || {
    echo -e "${RED}✗ Не удалось проверить количество маршрутов${NC}"
    return 1
  }
  if [[ "$route_count" != "7" ]]; then
    echo -e "${RED}✗ Multi-route профиль собран некорректно: маршрутов ${route_count}, ожидалось 7${NC}"
    return 1
  fi

  if ! jq -n \
      --arg name "$name" \
      --arg uuid "$uuid" \
      --arg sub_token "$sub_token" \
      --arg created "$(date +%Y-%m-%d\ %H:%M:%S)" \
      --argjson routes "$routes_json" \
      '{
        name: $name,
        uuid: $uuid,
        schema_version: 3,
        multi_route: true,
        primary_route: "xhttp-legacy",
        sub_token: $sub_token,
        created: $created,
        routes: $routes
      }
      + {
        transport: $routes[0].transport,
        port: $routes[0].port,
        fingerprint: $routes[0].fingerprint,
        sni: $routes[0].sni,
        xhttp_path: $routes[0].xhttp_path,
        pq_enabled: ($routes[0].pq_enabled // false)
      }' > "$PROFILES_DIR/$name.json"; then
    rm -f "$PROFILES_DIR/$name.json"
    echo -e "${RED}✗ Не удалось создать JSON профиля${NC}"
    return 1
  fi

  local rollback_config=""
  if ! backup_config "create_profile_$name" rollback_config; then
    rm -f "$PROFILES_DIR/$name.json"
    return 1
  fi

  local created_ports=()
  local route_index label transport sni fingerprint pq grpc xhttp
  for ((route_index=0; route_index<route_count; route_index++)); do
    label=$(jq -r --argjson i "$route_index" '.[$i].label' <<< "$routes_json")
    transport=$(jq -r --argjson i "$route_index" '.[$i].transport' <<< "$routes_json")
    port=$(jq -r --argjson i "$route_index" '.[$i].port' <<< "$routes_json")
    sni=$(jq -r --argjson i "$route_index" '.[$i].sni' <<< "$routes_json")
    fingerprint=$(jq -r --argjson i "$route_index" '.[$i].fingerprint' <<< "$routes_json")
    pq=$(jq -r --argjson i "$route_index" '.[$i].pq_enabled // false' <<< "$routes_json")
    grpc=$(jq -r --argjson i "$route_index" '.[$i].grpc_service_name // ""' <<< "$routes_json")
    xhttp=$(jq -r --argjson i "$route_index" '.[$i].xhttp_path // ""' <<< "$routes_json")
    echo -e "${CYAN} → Маршрут ${label}: ${transport} :${port}${NC}"
    if ! add_inbound "$uuid" "$transport" "$port" "$sni" "$fingerprint" "$grpc" "$xhttp" "$pq"; then
      # A12-fix: откат через _restore_config_backup сохраняет владельца/права и проходит
      # фиксированную логику, а не голый cp в обход fix_xray_permissions.
      if [[ -n "$rollback_config" ]]; then
        _restore_config_backup "$rollback_config" >/dev/null 2>&1
        fix_xray_permissions >/dev/null 2>&1 || true
      fi
      rm -f "$PROFILES_DIR/$name.json"
      local p
      for p in "${created_ports[@]}"; do
        close_firewall_port "$p"
      done
      echo -e "${RED}✗ Не удалось создать маршрут ${label}; профиль удалён, config.json откатан${NC}"
      if [[ "$pause_after" != "no_pause" ]]; then
        echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
        read -r _
      fi
      return 1
    fi
    created_ports+=("$port")
  done

  if ! safe_restart_xray "$rollback_config"; then
    rm -f "$PROFILES_DIR/$name.json"
    local p
    for p in "${created_ports[@]}"; do
      close_firewall_port "$p"
    done
    echo ""
    echo -e "${RED}╔═══════════════════════════════════════════════${NC}"
    echo -e "${RED}         ✗ ПРОФИЛЬ НЕ АКТИВИРОВАН             ${NC}"
    echo -e "${RED}╚═══════════════════════════════════════════════${NC}"
    echo ""
    echo -e "${RED}Xray не принял multi-route конфигурацию. Профиль удалён, config.json откатан.${NC}"
    if [[ "$pause_after" != "no_pause" ]]; then
      echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
      read -r _
    fi
    return 1
  fi

  echo ""
  echo -e "${GREEN}╔═══════════════════════════════════════════════${NC}"
  echo -e "${GREEN}         ✓ ПРОФИЛЬ УСПЕШНО СОЗДАН!            ${NC}"
  echo -e "${GREEN}╚═══════════════════════════════════════════════${NC}"
  echo ""
  echo -e "${BLUE}Имя профиля:${NC} ${GREEN}$name${NC}"
  echo -e "${BLUE}UUID:${NC} $uuid"
  echo -e "${BLUE}Маршрутов:${NC} $(jq 'length' <<< "$routes_json")"
  jq -r '.[] | "  - \(.label): \(.transport) :\(.port) sni=\(.sni)"' <<< "$routes_json"

  if [[ "$subscription_output" != "hide_subscription" ]]; then
    if [[ -f /usr/local/etc/xray/.subscription_installed ]]; then
      _happ_print_subscription_url_for_profile "$name"
    else
      echo ""
      echo -e "${YELLOW}ℹ HAPP-подписка ещё не установлена. Включите через 'Главное меню → Подписка HAPP'.${NC}"
    fi
  fi

  echo ""
  echo -e "${CYAN}Одна подписка этого профиля отдаёт все маршруты.${NC}"
  echo ""
  fix_xray_permissions
  if [[ "$pause_after" != "no_pause" ]]; then
    echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
    read -r _
  fi
}

# Создание профиля
create_profile() {
  local name=$1
  local transport=$2
  local port=$3
  local fingerprint=$4
  local custom_sni=$5  # Опциональный кастомный SNI
  local grpc_service_name=$6
  local xhttp_path=$7
  local uuid=$(uuidgen)

  # Phase 7 REQ-C04: sub_token (32 hex-символа) для HAPP subscription URL.
  # Один профиль = одна subscription URL; sub_token хранится в profile JSON.
  local sub_token
  sub_token=$(openssl rand -hex 16)
  if [[ ! "$sub_token" =~ ^[a-f0-9]{32}$ ]]; then
    echo -e "${RED}✗ Не удалось сгенерировать sub_token (openssl?)${NC}"
    return 1
  fi

  local default_sni=""
  local defaults=""

  if [[ -z "$port" ]]; then
    if ! defaults=$(build_transport_defaults "$transport"); then
      echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
      read
      return 1
    fi
    IFS='|' read -r port generated_grpc_service_name generated_xhttp_path <<< "$defaults"
    [[ -z "$grpc_service_name" ]] && grpc_service_name="$generated_grpc_service_name"
    [[ -z "$xhttp_path" ]] && xhttp_path="$generated_xhttp_path"
    reserve_port "$port"
  fi

  default_sni=$(_default_sni_for_transport "$transport")
  if [[ "$transport" == "grpc" ]] && [[ -z "$(_selfsteal_domain_value)" ]]; then
    echo -e "${YELLOW}⚠ gRPC: используется SNI ${CYAN}$default_sni${YELLOW} (требуется HTTP/2)${NC}"
  fi

  # Используем кастомный SNI если передан
  [[ -n "$custom_sni" ]] && default_sni="$custom_sni"

  case "$transport" in
    grpc)
      [[ -z "$grpc_service_name" ]] && grpc_service_name="grpc"
      ;;
    xhttp)
      [[ -z "$xhttp_path" ]] && xhttp_path="/xhttp"
      ;;
  esac

  if [[ "$port" == "443" ]] && [[ "$transport" == "tcp" || "$transport" == "tcp-utls" || "$transport" == "tcp-xudp" ]]; then
    if ! confirm_vision_443_risk; then
      echo -e "${CYAN}✓ Создание профиля отменено${NC}"
      sleep 1
      return 0
    fi
  fi

  local jq_args=(
    --arg name "$name"
    --arg uuid "$uuid"
    --arg transport "$transport"
    --argjson port "$port"
    --arg fingerprint "$fingerprint"
    --arg sni "$default_sni"
    --arg sub_token "$sub_token"
    --arg created "$(date +%Y-%m-%d\ %H:%M:%S)"
  )
  local jq_expr='{name: $name, uuid: $uuid, transport: $transport, port: $port, fingerprint: $fingerprint, sni: $sni'
  if [[ "$transport" == "grpc" ]]; then
    jq_args+=(--arg grpc_service_name "$grpc_service_name")
    jq_expr+=', grpc_service_name: $grpc_service_name'
  elif [[ "$transport" == "xhttp" ]]; then
    jq_args+=(--arg xhttp_path "$xhttp_path")
    jq_expr+=', xhttp_path: $xhttp_path'
    # Phase 6 REQ-A04/A05: новый XHTTP-профиль = PQ.
    # schema_version: 2 + pq_enabled: true — generate_connection и upgrade_button (Plan 6.3) различают это.
    jq_args+=(--argjson schema_v 2 --argjson pq_enabled true)
    jq_expr+=', schema_version: $schema_v, pq_enabled: $pq_enabled'
  fi
  # Phase 7 REQ-C04: sub_token присутствует во всех профилях независимо от транспорта.
  jq_expr+=', sub_token: $sub_token, created: $created}'
  if ! jq -n "${jq_args[@]}" "$jq_expr" > "$PROFILES_DIR/$name.json"; then
    rm -f "$PROFILES_DIR/$name.json"
    echo -e "${RED}✗ Не удалось создать JSON профиля${NC}"
    return 1
  fi

  local rollback_config=""
  if ! backup_config "create_profile_$name" rollback_config; then
    rm -f "$PROFILES_DIR/$name.json"
    return 1
  fi
  if ! add_inbound "$uuid" "$transport" "$port" "$default_sni" "$fingerprint" "$grpc_service_name" "$xhttp_path"; then
    rm -f "$PROFILES_DIR/$name.json"
    echo ""
    echo -e "${RED}╔═══════════════════════════════════════════════${NC}"
    echo -e "${RED}         ✗ ОШИБКА СОЗДАНИЯ ПРОФИЛЯ            ${NC}"
    echo -e "${RED}╚═══════════════════════════════════════════════${NC}"
    echo ""
    echo -e "${RED}Inbound не создан — файл профиля удалён.${NC}"
    echo -e "${YELLOW}Попробуйте другой порт или транспорт.${NC}"
    echo ""
    echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
    read
    return 1
  fi

  if ! safe_restart_xray "$rollback_config"; then
    rm -f "$PROFILES_DIR/$name.json"
    close_firewall_port "$port"
    echo ""
    echo -e "${RED}╔═══════════════════════════════════════════════${NC}"
    echo -e "${RED}         ✗ ПРОФИЛЬ НЕ АКТИВИРОВАН             ${NC}"
    echo -e "${RED}╚═══════════════════════════════════════════════${NC}"
    echo ""
    echo -e "${RED}Xray не принял новую конфигурацию. Профиль удалён, config.json откатан.${NC}"
    echo -e "${YELLOW}Проверьте последний бэкап в /usr/local/etc/xray/backups/.${NC}"
    echo ""
    echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
    read
    return 1
  fi

  # Читаем актуальный SNI из файла (мог измениться при SNI-конфликте)
  local actual_sni=$(jq -r '.sni' "$PROFILES_DIR/$name.json" 2>/dev/null)
  [[ -z "$actual_sni" ]] && actual_sni="$default_sni"

  echo ""
  echo -e "${GREEN}╔═══════════════════════════════════════════════${NC}"
  echo -e "${GREEN}         ✓ ПРОФИЛЬ УСПЕШНО СОЗДАН!            ${NC}"
  echo -e "${GREEN}╚═══════════════════════════════════════════════${NC}"
  echo ""
  echo -e "${BLUE}Имя профиля:${NC} ${GREEN}$name${NC}"
  echo -e "${BLUE}UUID:${NC} $uuid"
  echo -e "${BLUE}Транспорт:${NC} $transport"
  echo -e "${BLUE}Порт:${NC} $port"
  echo -e "${BLUE}Fingerprint:${NC} $fingerprint"
  echo -e "${BLUE}SNI:${NC} $actual_sni"

  # Phase 7: subscription URL/QR — primary output если подписка установлена.
  # B1: URL строится через _subscription_base_url (Plan 7.2 helper) — никакого инлайна!
  if [[ -f /usr/local/etc/xray/.subscription_installed ]]; then
    _happ_print_subscription_url_for_profile "$name"
  else
    echo ""
    echo -e "${YELLOW}ℹ HAPP-подписка ещё не установлена. Включите через 'Главное меню → Подписка HAPP'.${NC}"
  fi

  echo ""
  echo -e "${CYAN}Используйте меню 'Подключиться по профилю' для получения ссылки${NC}"
  echo ""
  fix_xray_permissions
  echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
  read
}

# Добавление inbound
add_inbound() {
  local uuid=$1
  local transport=$2
  local port=$3
  local sni=$4
  # $5 is the client/profile fingerprint kept for call-site compatibility.
  # REALITY inbounds do not use or constrain the client's TLS fingerprint.
  local grpc_service_name=$6
  local xhttp_path=$7
  local pq_enabled=${8:-}
  local short_id=$(openssl rand -hex 4)
  [[ -z "$pq_enabled" && "$transport" == "xhttp" ]] && pq_enabled=true

  # Phase 6 REQ-A04: для PQ XHTTP-инбаундов читаем decryption из файла.
  # HAPP fallback XHTTP использует decryption=none, иначе это не fallback.
  # Файл создан Plan 6.1 (install.sh при свежей установке ИЛИ миграция .mlkem_keys_generated).
  # Если файл отсутствует — это runtime-ошибка: миграция должна была сработать.
  local vless_decryption="none"
  if [[ "$transport" == "xhttp" && "$pq_enabled" == "true" ]]; then
    if [[ ! -f "$VLESS_DECRYPTION_FILE" ]]; then
      echo -e "${RED}✗ PQ ключи отсутствуют: $VLESS_DECRYPTION_FILE${NC}"
      echo -e "${YELLOW}  Перезапустите xrayebator — миграция .mlkem_keys_generated должна сгенерировать ключи${NC}"
      echo -e "${YELLOW}  Если миграция падает — проверьте: sudo /usr/local/bin/xray version (нужен ≥ 25.9.5)${NC}"
      return 1
    fi
    vless_decryption=$(cat "$VLESS_DECRYPTION_FILE")
    if [[ ! "$vless_decryption" =~ ^mlkem768x25519plus\. ]]; then
      echo -e "${RED}✗ $VLESS_DECRYPTION_FILE содержит невалидную PQ строку${NC}"
      echo -e "${YELLOW}  Удалите файл и перезапустите xrayebator для регенерации${NC}"
      return 1
    fi
  fi

  local existing_count
  existing_count=$(jq -r --argjson port "$port" '[.inbounds[] | select(.port == $port)] | length' "$CONFIG_FILE" 2>/dev/null)
  if [[ ! "$existing_count" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}✗ Не удалось проверить занятость порта $port${NC}"
    return 1
  fi
  if [[ "$existing_count" -gt 1 ]]; then
    echo -e "${RED}✗ В config.json найдено несколько inbound на порту $port${NC}"
    return 1
  fi
  if [[ "$existing_count" -eq 1 ]]; then
    # Check transport compatibility
    local existing_transport=$(jq -r --argjson port "$port" \
      '.inbounds[] | select(.port == $port) | .streamSettings.network' \
      "$CONFIG_FILE" 2>/dev/null)

    local expected_network="$transport"
    case "$transport" in
      tcp|tcp-utls|tcp-xudp|tcp-mux) expected_network="tcp" ;;
    esac

    if ! jq -e --argjson port "$port" '
      any(.inbounds[];
        .port == $port and
        .protocol == "vless" and
        .streamSettings.security == "reality"
      )
    ' "$CONFIG_FILE" >/dev/null 2>&1; then
      echo -e "${RED}✗ Порт $port занят не-VLESS/не-REALITY inbound${NC}"
      return 1
    fi

    if [[ -n "$existing_transport" ]] && [[ "$expected_network" != "$existing_transport" ]]; then
      echo ""
      echo -e "${RED}✗ Порт $port уже используется с транспортом '$existing_transport' (несовместимо с '$transport')${NC}"
      echo -e "${YELLOW}Используйте другой порт для транспорта '$transport'${NC}"
      return 1
    fi

    local existing_decryption
    existing_decryption=$(jq -r --argjson port "$port" \
      '.inbounds[] | select(.port == $port) | .settings.decryption // "none"' \
      "$CONFIG_FILE" 2>/dev/null)
    if [[ "$expected_network" == "xhttp" ]]; then
      local existing_pq_enabled="false"
      if [[ -n "$existing_decryption" && "$existing_decryption" != "none" ]]; then
        existing_pq_enabled="true"
      fi
      if [[ "$existing_pq_enabled" != "$pq_enabled" ]]; then
        echo -e "${RED}✗ Порт $port использует несовместимый режим XHTTP encryption/PQ${NC}"
        echo -e "${YELLOW}  Новый профиль PQ=$pq_enabled, inbound PQ=$existing_pq_enabled${NC}"
        echo -e "${CYAN}  Выберите свободный порт или XHTTP inbound с тем же режимом.${NC}"
        return 1
      fi
    elif [[ -n "$existing_decryption" && "$existing_decryption" != "none" ]]; then
      echo -e "${RED}✗ Порт $port использует VLESS encryption, которого нет в новом профиле${NC}"
      return 1
    fi

    if jq -e --argjson port "$port" --arg uuid "$uuid" '
      any(.inbounds[] | select(.port == $port) | .settings.clients[]?; .id == $uuid)
    ' "$CONFIG_FILE" >/dev/null 2>&1; then
      echo -e "${RED}✗ UUID $uuid уже существует на порту $port${NC}"
      return 1
    fi

    # Check existing inbound's SNI
    local existing_sni=$(jq -r --argjson port "$port" \
      '.inbounds[] | select(.port == $port) | .streamSettings.realitySettings.serverNames[0]' \
      "$CONFIG_FILE" 2>/dev/null)

    if [[ -n "$existing_sni" ]] && [[ "$existing_sni" != "$sni" ]]; then
      echo ""
      echo -e "${RED}╔═══════════════════════════════════════════════════════════╗${NC}"
      echo -e "${RED}║         ⚠ КОНФЛИКТ SNI НА ПОРТУ $port                    ║${NC}"
      echo -e "${RED}╚═══════════════════════════════════════════════════════════╝${NC}"
      echo ""
      echo -e "${YELLOW}Порт $port уже используется с SNI: ${MAGENTA}$existing_sni${NC}"
      echo -e "${YELLOW}Новый профиль пытается использовать SNI: ${MAGENTA}$sni${NC}"
      echo ""
      echo -e "${CYAN}Xray Reality не поддерживает разные SNI на одном порту.${NC}"
      echo -e "${CYAN}Профиль будет создан с SNI: ${YELLOW}$existing_sni${NC}"
      echo ""
      sleep 3

      # Override sni to match existing inbound
      sni="$existing_sni"

      # Обновить SNI в только что созданном файле профиля.
      # У multi-route профилей SNI живёт и в .routes[i].sni — обновляем и там,
      # иначе маршрут рассинхронизируется с inbound и выпадет из подписки.
      local pf
      for pf in "$PROFILES_DIR"/*.json; do
        [[ ! -f "$pf" ]] && continue
        local pf_uuid=$(jq -r '.uuid' "$pf" 2>/dev/null)
        if [[ "$pf_uuid" == "$uuid" ]]; then
          if ! safe_jq_write --arg sni "$existing_sni" --argjson port "$port" \
            '.sni = $sni | if ((.routes? // []) | length) > 0 then
               .routes |= map(if .port == $port then .sni = $sni else . end)
             else . end' "$pf"; then
            echo -e "${RED}  ✗ Не удалось обновить SNI в профиле $(basename "$pf")${NC}"
            return 1
          fi
          break
        fi
      done
    fi

    local profile_file=""
    profile_file=$(find_profile_file_by_uuid "$uuid")
    if [[ -n "$profile_file" ]]; then
      local inbound_metadata=""
      local inbound_grpc_service_name=""
      local inbound_xhttp_path=""
      inbound_metadata=$(read_inbound_transport_metadata "$port" "$transport")
      IFS='|' read -r inbound_grpc_service_name inbound_xhttp_path <<< "$inbound_metadata"
      if ! write_profile_transport_metadata "$profile_file" "$inbound_grpc_service_name" "$inbound_xhttp_path"; then
        echo -e "${RED}  ✗ Не удалось синхронизировать transport metadata профиля $(basename "$profile_file")${NC}"
        return 1
      fi
    fi

    echo -e "${CYAN} → Добавление клиента в существующий inbound на порту $port${NC}"
    # Определяем flow по типу транспорта нового профиля (не копируем слепо от первого клиента)
    local client_flow=""
    case "$transport" in
      tcp|tcp-utls|tcp-xudp) client_flow="xtls-rprx-vision" ;;
      tcp-mux|grpc|xhttp) client_flow="" ;;
    esac
    if ! safe_jq_write --arg uuid "$uuid" --argjson port "$port" --arg flow "$client_flow" '
      (.inbounds[] | select(.port == $port) | .settings.clients) += [{
        "id": $uuid,
        "flow": $flow
      }]
    ' "$CONFIG_FILE"; then
      echo -e "${RED}  ✗ Не удалось добавить клиента в inbound${NC}"
      return 1
    fi
    return
  fi

  echo -e "${CYAN} → Создание нового inbound на порту $port${NC}"
  local inbound=""
  local reality_dest=""
  reality_dest=$(_reality_dest_for_sni "$sni")
  case $transport in
    tcp-mux)
      inbound=$(cat << TCPMUXEOF
{
  "listen": "0.0.0.0",
  "port": $port,
  "protocol": "vless",
  "settings": {
    "clients": [{"id": "$uuid", "flow": ""}],
    "decryption": "none"
  },
  "streamSettings": {
    "network": "tcp",
    "security": "reality",
    "realitySettings": {
      "show": false,
      "dest": "$reality_dest",
      "xver": 0,
      "serverNames": ["$sni"],
      "privateKey": "$PRIVATE_KEY",
      "shortIds": ["$short_id"]
    }
  },
  "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true},
  "tag": "inbound-$port"
}
TCPMUXEOF
)
      ;;
    tcp|tcp-utls|tcp-xudp)
      inbound=$(cat << TCPEOF
{
  "listen": "0.0.0.0",
  "port": $port,
  "protocol": "vless",
  "settings": {
    "clients": [{"id": "$uuid", "flow": "xtls-rprx-vision"}],
    "decryption": "none"
  },
  "streamSettings": {
    "network": "tcp",
    "security": "reality",
    "realitySettings": {
      "show": false,
      "dest": "$reality_dest",
      "xver": 0,
      "serverNames": ["$sni"],
      "privateKey": "$PRIVATE_KEY",
      "shortIds": ["$short_id"]
    }
  },
  "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true},
  "tag": "inbound-$port"
}
TCPEOF
)
      ;;
    grpc)
      inbound=$(cat << GRPCEOF
{
  "listen": "0.0.0.0",
  "port": $port,
  "protocol": "vless",
  "settings": {
    "clients": [{"id": "$uuid", "flow": ""}],
    "decryption": "none"
  },
  "streamSettings": {
    "network": "grpc",
    "security": "reality",
    "grpcSettings": {"serviceName": "$grpc_service_name"},
    "realitySettings": {
      "show": false,
      "dest": "$reality_dest",
      "xver": 0,
      "serverNames": ["$sni"],
      "privateKey": "$PRIVATE_KEY",
      "shortIds": ["$short_id"]
    }
  },
  "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true},
  "tag": "inbound-$port"
}
GRPCEOF
)
      ;;
    xhttp)
      inbound=$(cat << XHTTPEOF
{
  "listen": "0.0.0.0",
  "port": $port,
  "protocol": "vless",
  "settings": {
    "clients": [{"id": "$uuid", "flow": ""}],
    "decryption": "$vless_decryption"
  },
  "streamSettings": {
    "network": "xhttp",
    "security": "reality",
    "xhttpSettings": {
      "mode": "auto",
      "path": "$xhttp_path",
      "host": "$sni",
      "extra": {
        "xPaddingBytes": "100-1000",
        "xmux": {
          "maxConcurrency": "16-32",
          "hMaxRequestTimes": "600-900",
          "hMaxReusableSecs": "1800-3000",
          "hKeepAlivePeriod": 0
        },
        "noSSEHeader": true,
        "scMaxEachPostBytes": "1000000-2000000",
        "scMinPostsIntervalMs": "10-50"
      }
    },
    "realitySettings": {
      "show": false,
      "dest": "$reality_dest",
      "xver": 0,
      "serverNames": ["$sni"],
      "privateKey": "$PRIVATE_KEY",
      "shortIds": ["$short_id"]
    }
  },
  "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true},
  "tag": "inbound-$port"
}
XHTTPEOF
)
      ;;
  esac

  if ! safe_jq_write ".inbounds += [$inbound]" "$CONFIG_FILE"; then
    echo -e "${RED}  ✗ Не удалось создать inbound в конфиге${NC}"
    return 1
  fi

  # Open firewall port. Не считаем неактивный UFW ошибкой создания профиля:
  # config.json уже валиден, а часть VPS управляет firewall вне ufw.
  open_firewall_port "$port" || \
    echo -e "${YELLOW}  ⚠ Порт $port не был открыт через UFW — проверьте firewall вручную${NC}"
  return 0
}

_remove_profile_uuid_from_config() {
  local uuid=$1
  local ports_json=$2

  safe_jq_write --arg uuid "$uuid" --argjson ports "$ports_json" '
    .inbounds |= map(
      .port as $inbound_port |
      if (($ports | index($inbound_port)) != null) and any(.settings.clients[]?; .id == $uuid) then
        .settings.clients = ((.settings.clients // []) | map(select(.id != $uuid))) |
        if (.settings.clients | length) == 0 then empty else . end
      else
        .
      end
    )
  ' "$CONFIG_FILE"
}

_move_profile_client_between_inbounds() {
  local uuid=$1
  local old_port=$2
  local new_port=$3
  local target_flow=$4
  local source_client

  source_client=$(jq -c --arg uuid "$uuid" --argjson port "$old_port" '
    first(.inbounds[] | select(.port == $port) | .settings.clients[]? | select(.id == $uuid)) // empty
  ' "$CONFIG_FILE" 2>/dev/null)
  [[ -n "$source_client" ]] || return 1
  source_client=$(jq -c --arg flow "$target_flow" '.flow = $flow' <<< "$source_client") || return 1

  safe_jq_write \
    --arg uuid "$uuid" \
    --argjson old_port "$old_port" \
    --argjson new_port "$new_port" \
    --argjson client "$source_client" '
      if $old_port == $new_port then
        error("source and target ports are equal")
      elif ([.inbounds[] | select(.port == $old_port)] | length) != 1 then
        error("source inbound not unique")
      elif ([.inbounds[] | select(.port == $new_port)] | length) != 1 then
        error("target inbound not unique")
      elif any(.inbounds[] | select(.port == $new_port) | .settings.clients[]?; .id == $uuid) then
        error("UUID already exists on target port")
      else
        .inbounds |= map(
          if .port == $new_port then
            .settings.clients = ((.settings.clients // []) + [$client])
          elif .port == $old_port then
            .settings.clients = ((.settings.clients // []) | map(select(.id != $uuid))) |
            if (.settings.clients | length) == 0 then empty else . end
          else
            .
          end
        )
      end
    ' "$CONFIG_FILE"
}

# Удаление профиля
delete_profile_menu() {
  show_ascii
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
  echo -e "${BLUE}             УДАЛЕНИЕ ПРОФИЛЯ                 ${NC}"
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}\n"
  local profiles=($(ls -1 "$PROFILES_DIR" 2>/dev/null | sed 's/.json//'))
  if [[ ${#profiles[@]} -eq 0 ]]; then
    echo -e "${RED}✗ Нет созданных профилей${NC}"
    echo ""
    echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
    read
    return
  fi
  echo -e "${YELLOW}Доступные профили:${NC}\n"
  local i=1
  for profile in "${profiles[@]}"; do
    local transport=$(jq -r '.transport' "$PROFILES_DIR/$profile.json" 2>/dev/null)
    local port=$(jq -r '.port' "$PROFILES_DIR/$profile.json" 2>/dev/null)
    echo -e "${CYAN} $i)${NC} $profile ${BLUE}[$transport:$port]${NC}"
    ((i++))
  done
  echo -e "${CYAN} 0)${NC} Назад в главное меню\n"
  echo -n -e "${YELLOW}Выберите профиль для удаления: ${NC}"
  read choice
  if [[ "$choice" == "0" ]]; then
    return
  fi
  if [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 ]] && [[ $choice -le ${#profiles[@]} ]]; then
    local profile_name="${profiles[$((choice-1))]}"
    echo ""
    echo -n -e "${RED}Вы уверены, что хотите удалить профиль '$profile_name'? (y/N): ${NC}"
    read confirm
    if [[ "$confirm" =~ ^[yYдД]$ ]]; then
      local profile_file="$PROFILES_DIR/$profile_name.json"
      local uuid=$(jq -r '.uuid' "$profile_file")
      local route_count
      route_count=$(_profile_route_count "$profile_file")
      local ports_json
      if [[ "$route_count" =~ ^[0-9]+$ ]] && [[ "$route_count" -gt 0 ]]; then
        ports_json=$(jq -c '[.routes[]?.port | select(type == "number")] | unique' "$profile_file" 2>/dev/null)
      else
        ports_json=$(jq -c '[.port | select(type == "number")] | unique' "$profile_file" 2>/dev/null)
      fi
      if [[ -z "$uuid" || "$uuid" == "null" ]] ||
         ! jq -e 'type == "array" and length > 0' <<< "$ports_json" >/dev/null 2>&1; then
        echo -e "${RED}✗ Профиль повреждён: нет корректных uuid/port${NC}"
        echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
        read
        return
      fi

      local rollback_config=""
      if ! backup_config "delete_profile_$profile_name" rollback_config; then
        echo -e "${RED}✗ Профиль НЕ удалён: не удалось создать бэкап config.json${NC}"
        return
      fi

      # Удаляем только совпавший UUID. Даже stale profile, указывающий на порт
      # чужого единственного клиента, не имеет права удалить весь inbound.
      if ! _remove_profile_uuid_from_config "$uuid" "$ports_json"; then
        echo -e "${RED}✗ Ошибка обновления конфига — профиль НЕ удалён${NC}"
        return
      fi

      fix_xray_permissions
      if ! safe_restart_xray "$rollback_config"; then
        echo -e "${RED}✗ Xray не принял конфиг — профиль НЕ удалён, config.json откачен${NC}"
        return
      fi

      if ! rm -f "$profile_file" || [[ -e "$profile_file" ]]; then
        echo -e "${RED}✗ Не удалось удалить profile JSON — возвращаю прежний config.json${NC}"
        if _restore_config_backup "$rollback_config"; then
          safe_restart_xray "$rollback_config" || true
        fi
        return
      fi

      local port
      while IFS= read -r port; do
        close_firewall_port "$port"
      done < <(jq -r '.[]' <<< "$ports_json")

      fix_xray_permissions
      echo ""
      if [[ "$route_count" =~ ^[0-9]+$ ]] && [[ "$route_count" -gt 0 ]]; then
        echo -e "${GREEN}✓ Multi-route профиль '$profile_name' успешно удален${NC}"
      else
        echo -e "${GREEN}✓ Профиль '$profile_name' успешно удален${NC}"
      fi
    else
      echo -e "${YELLOW}⚠ Удаление отменено${NC}"
    fi
  else
    echo -e "${RED}✗ Неверный выбор${NC}"
  fi
  echo ""
  echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
  read
}

