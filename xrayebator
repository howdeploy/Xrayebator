    echo -e "${CYAN} 0)${NC} Назад в главное меню\n"
    echo -n -e "${YELLOW}Выбор: ${NC}"
    local pchoice
    read -r pchoice

    [[ "$pchoice" == "0" ]] && return
    if [[ ! "$pchoice" =~ ^[0-9]+$ ]] || [[ $pchoice -lt 1 ]] || [[ $pchoice -gt ${#profiles[@]} ]]; then
      echo -e "${RED}Неверный выбор${NC}"
      sleep 1
