  fi
  if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ $choice -lt 1 ]] || [[ $choice -gt ${#profiles[@]} ]]; then
    echo -e "${RED}✗ Неверный выбор${NC}"
    sleep 2
    return
  fi
  local profile_name="${profiles[$((choice-1))]}"
  local profile_file="$PROFILES_DIR/$profile_name.json"
  local route_index=""
  local route_label=""
  local old_port
  local target_label="$profile_name"
  if profile_has_routes "$profile_file"; then
    select_route_for_profile "$profile_file" "смены порта" || return
    route_index="$SELECTED_ROUTE_INDEX"
    route_label=$(jq -r --argjson i "$route_index" '.routes[$i].label // .routes[$i].transport // ("route-" + ($i|tostring))' "$profile_file")
    old_port=$(jq -r --argjson i "$route_index" '.routes[$i].port // empty' "$profile_file")
    target_label="$profile_name/$route_label"
  else
    old_port=$(jq -r '.port' "$profile_file")
  fi
  if ! _profile_route_matches_live_inbound "$profile_file" "$route_index"; then
    echo -e "${RED}✗ Profile JSON не совпадает с live inbound — смена порта остановлена${NC}"
    echo -e "${YELLOW}  Сначала исправьте рассинхронизацию профиля/config.json.${NC}"
    sleep 2
    return
  fi
  echo ""
  echo -e "${CYAN}Текущий порт '${target_label}':${NC} ${GREEN}$old_port${NC}\n"
  echo -e "${YELLOW}Рекомендуемый сценарий для 2026:${NC}\n"
  echo -e "  ${GREEN}1)${NC} Случайный высокий порт 30000-60000 ${MAGENTA}- рекомендуется${NC}"
  echo -e "  ${CYAN}2)${NC} 443   ${YELLOW}- вручную / рискованно для Vision${NC}"
  echo -e "  ${CYAN}3)${NC} 8443  ${BLUE}- явный альтернативный HTTPS-порт${NC}"
  echo -e "  ${CYAN}4)${NC} 2053  ${BLUE}- ручной вариант, иногда удобен для gRPC${NC}"
  echo -e "  ${CYAN}5)${NC} 2083  ${BLUE}- Cloudflare альтернативный SSL${NC}"
  echo -e "  ${CYAN}6)${NC} 2087  ${BLUE}- Cloudflare альтернативный SSL${NC}"
  echo -e "  ${CYAN}7)${NC} 2096  ${BLUE}- Cloudflare альтернативный SSL${NC}"
  echo -e "  ${CYAN}8)${NC} 9443  ${BLUE}- ручной XHTTP-style вариант, не дефолт${NC}"
  echo -e "  ${CYAN}9)${NC} 8080  ${BLUE}- HTTP альтернативный прокси${NC}"
  echo -e "  ${CYAN}10)${NC} Свой порт (введу вручную)\n"
  echo -n -e "${YELLOW}Выберите порт: ${NC}"
  read port_choice
  local new_port=""
  case $port_choice in
    1)
      if ! new_port=$(find_available_random_port); then
        echo -n -e "${YELLOW}Нажмите Enter...${NC}"
        read
        return
      fi
      reserve_port "$new_port"
      ;;
    2) new_port="443" ;;
    3) new_port="8443" ;;
    4) new_port="2053" ;;
    5) new_port="2083" ;;
    6) new_port="2087" ;;
    7) new_port="2096" ;;
    8) new_port="9443" ;;
    9) new_port="8080" ;;
    10)
      echo -n -e "${YELLOW}Введите номер порта (1-65535): ${NC}"
      read new_port
      ;;
    0) return ;;
    *) echo -e "${RED}✗ Неверный выбор${NC}"; sleep 2; return ;;
  esac
  if [[ ! "$new_port" =~ ^[0-9]+$ ]] || [[ $new_port -lt 1 ]] || [[ $new_port -gt 65535 ]]; then
    echo -e "${RED}✗ Неверный порт. Используйте число от 1 до 65535${NC}"
    sleep 2
    return
  fi
  if [[ "$new_port" == "$old_port" ]]; then
    echo -e "${YELLOW}⚠ Профиль уже использует этот порт${NC}"
    sleep 2
    return
  fi
  if [[ -n "$route_index" ]] && jq -e --argjson i "$route_index" --argjson port "$new_port" '
    any((.routes // []) | to_entries[]; (.key != $i) and (.value.port == $port))
  ' "$profile_file" >/dev/null 2>&1; then
    echo -e "${RED}✗ Этот порт уже используется другим маршрутом этого же профиля${NC}"
    sleep 2
    return
  fi

  # Get profile transport and UUID
  local profile_transport
  local profile_uuid
  local profile_metadata=""
  local profile_grpc_service_name=""
  local profile_xhttp_path=""
  local profile_fingerprint=""
  local profile_pq_enabled="false"
  local profile_sni=""

  profile_uuid=$(jq -r '.uuid' "$profile_file")
  if [[ -n "$route_index" ]]; then
    profile_transport=$(jq -r --argjson i "$route_index" '.routes[$i].transport // empty' "$profile_file")
    profile_grpc_service_name=$(jq -r --argjson i "$route_index" '.routes[$i].grpc_service_name // ""' "$profile_file")
    profile_xhttp_path=$(jq -r --argjson i "$route_index" '.routes[$i].xhttp_path // ""' "$profile_file")
    profile_fingerprint=$(jq -r --argjson i "$route_index" '.routes[$i].fingerprint // .fingerprint // "firefox"' "$profile_file")
    profile_pq_enabled=$(jq -r --argjson i "$route_index" '.routes[$i].pq_enabled // false' "$profile_file")
    profile_sni=$(jq -r --argjson i "$route_index" '. as $root | .routes[$i].sni // $root.sni // empty' "$profile_file")
  else
    profile_transport=$(jq -r '.transport' "$profile_file")
    profile_fingerprint=$(jq -r '.fingerprint // "firefox"' "$profile_file")
    profile_pq_enabled=$(jq -r '.pq_enabled // false' "$profile_file")
    profile_sni=$(jq -r '.sni // empty' "$profile_file")
    profile_metadata=$(read_profile_transport_metadata "$profile_file")
    IFS='|' read -r profile_grpc_service_name profile_xhttp_path <<< "$profile_metadata"
  fi

  if [[ "$new_port" == "443" ]] && [[ "$profile_transport" == "tcp" || "$profile_transport" == "tcp-utls" || "$profile_transport" == "tcp-xudp" ]]; then
    if ! confirm_vision_443_risk; then
      echo -e "${CYAN}✓ Смена порта отменена${NC}"
      sleep 1
      return
    fi
  fi

  # Check if target port is already in use
  local target_inbound_tag=$(jq -r --argjson port "$new_port" '.inbounds[] | select(.port == $port) | .tag' "$CONFIG_FILE" 2>/dev/null)
  local target_inbound_transport=""
  local target_inbound_sni=""
  local target_inbound_metadata=""
  local target_inbound_grpc_service_name=""
  local target_inbound_xhttp_path=""
  local target_inbound_pq_enabled="false"
  local move_to_existing=false

  if [[ -n "$target_inbound_tag" ]]; then
    # Port is in use - check transport compatibility
    target_inbound_transport=$(jq -r --argjson port "$new_port" '.inbounds[] | select(.port == $port) | .streamSettings.network' "$CONFIG_FILE")
    target_inbound_sni=$(jq -r --argjson port "$new_port" '.inbounds[] | select(.port == $port) | .streamSettings.realitySettings.serverNames[0]' "$CONFIG_FILE")
    target_inbound_metadata=$(read_inbound_transport_metadata "$new_port" "$profile_transport")
    IFS='|' read -r target_inbound_grpc_service_name target_inbound_xhttp_path <<< "$target_inbound_metadata"
    if [[ "$target_inbound_transport" == "xhttp" ]]; then
      local target_decryption
      target_decryption=$(jq -r --argjson port "$new_port" \
        '.inbounds[] | select(.port == $port) | .settings.decryption // "none"' \
        "$CONFIG_FILE" 2>/dev/null)
      if [[ -n "$target_decryption" && "$target_decryption" != "none" ]]; then
        target_inbound_pq_enabled="true"
      fi
    fi

    # Normalize transport for comparison (tcp-utls, tcp-xudp, tcp-mux use tcp network)
    local profile_network="$profile_transport"
    case "$profile_transport" in
      tcp|tcp-utls|tcp-xudp|tcp-mux) profile_network="tcp" ;;
    esac

    if [[ "$profile_network" != "$target_inbound_transport" ]]; then
      echo -e "${RED}╔═══════════════════════════════════════════════════════════╗${NC}"
      echo -e "${RED}║            ✗ НЕСОВМЕСТИМЫЙ ТРАНСПОРТ                     ║${NC}"
      echo -e "${RED}╚═══════════════════════════════════════════════════════════╝${NC}"
      echo ""
      echo -e "${YELLOW}Порт $new_port уже занят профилем с транспортом: ${MAGENTA}$target_inbound_transport${NC}"
      echo -e "${YELLOW}Ваш профиль использует транспорт: ${MAGENTA}$profile_transport${NC}"
      echo ""
      echo -e "${CYAN}Нельзя объединить разные транспорты на одном порту.${NC}"
      echo ""
      echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
      read
      return
    fi

    if [[ "$profile_network" == "xhttp" && "$profile_pq_enabled" != "$target_inbound_pq_enabled" ]]; then
      echo -e "${RED}✗ Порт $new_port использует несовместимый режим XHTTP encryption/PQ${NC}"
      echo -e "${YELLOW}  Профиль PQ=$profile_pq_enabled, inbound PQ=$target_inbound_pq_enabled${NC}"
      echo -e "${CYAN}  Выберите свободный порт или XHTTP inbound с тем же режимом.${NC}"
      echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
      read
      return
    fi

    move_to_existing=true
    echo -e "${YELLOW}╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║           ПОРТ УЖЕ ИСПОЛЬЗУЕТСЯ                          ║${NC}"
    echo -e "${YELLOW}╚═══════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${CYAN}Порт $new_port уже занят профилем с транспортом: ${GREEN}$target_inbound_transport${NC}"
    echo -e "${CYAN}SNI на этом порту: ${GREEN}$target_inbound_sni${NC}"
    echo ""
    echo -e "${MAGENTA}Профиль '$profile_name' будет перемещен на этот порт.${NC}"
    echo -e "${MAGENTA}SNI профиля изменится на: ${YELLOW}$target_inbound_sni${NC}"
    echo ""
  fi

  echo ""
  echo -e "${RED}╔═══════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║            ⚠ КРИТИЧЕСКОЕ ПРЕДУПРЕЖДЕНИЕ ⚠               ║${NC}"
  echo -e "${RED}╚═══════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${YELLOW}Смена порта изменит настройки подключения.${NC}"
  echo ""
  echo -e "${RED}ВСЕ активные подключения '${target_label}' будут разорваны!${NC}"
  echo ""
  echo -e "${CYAN}После смены необходимо:${NC}"
  echo -e "  ${BLUE}1.${NC} Получить НОВУЮ ссылку/QR-код для этого профиля"
  echo -e "  ${BLUE}2.${NC} Обновить конфигурацию в клиентах"
  echo -e "  ${BLUE}3.${NC} Убедиться, что порт открыт в firewall"
  echo ""
  echo -e "${MAGENTA}Порт изменится: ${YELLOW}$old_port → $new_port${NC}"
  echo ""
  echo -n -e "${YELLOW}Продолжить смену порта? (y/N): ${NC}"
  read confirm
  if [[ ! "$confirm" =~ ^[yYдД]$ ]]; then
    echo -e "${CYAN}✓ Отменено${NC}"
    sleep 1
    return
  fi

  local rollback_config=""
  local profiles_snapshot=""
  if ! backup_config "change_port_${profile_name}_${old_port}_to_${new_port}" rollback_config; then
    echo -e "${RED}✗ Смена порта отменена: не удалось создать бэкап config.json${NC}"
    return
  fi
  if ! _snapshot_profiles profiles_snapshot; then
    echo -e "${RED}✗ Смена порта отменена: не удалось создать снимок profile JSON${NC}"
    return
  fi

  if [[ "$move_to_existing" == "true" ]]; then
    echo -e "${CYAN}  → Перемещение клиента на порт $new_port...${NC}"

    local target_flow=""
    case "$profile_transport" in
      tcp|tcp-utls|tcp-xudp) target_flow="xtls-rprx-vision" ;;
      tcp-mux|grpc|xhttp) target_flow="" ;;
    esac

    # Добавление на новый порт, удаление со старого и удаление опустевшего
    # inbound происходят одним jq commit — промежуточного полусостояния нет.
    if ! _move_profile_client_between_inbounds \
      "$profile_uuid" "$old_port" "$new_port" "$target_flow"; then
      _restore_config_backup "$rollback_config" || true
      _restore_profiles_snapshot "$profiles_snapshot" || true
      _discard_profiles_snapshot "$profiles_snapshot"
      echo -e "${RED}✗ Не удалось атомарно переместить UUID — операция отменена${NC}"
      return
    fi

    if [[ -n "$route_index" ]]; then
      if ! safe_jq_write \
        --argjson i "$route_index" \
        --argjson port "$new_port" \
        --arg sni "$target_inbound_sni" \
        --arg fp "$profile_fingerprint" \
        --arg grpc_service_name "$target_inbound_grpc_service_name" \
        --arg xhttp_path "$target_inbound_xhttp_path" '
          if (.routes[$i] // null) == null then error("route not found") else
            .routes[$i].port = $port |
            .routes[$i].sni = $sni |
            .routes[$i].fingerprint = $fp |
            if .routes[$i].transport == "grpc" then
              .routes[$i].grpc_service_name = $grpc_service_name
            elif .routes[$i].transport == "xhttp" then
              .routes[$i].xhttp_path = $xhttp_path
            else . end |
            if $i == 0 then
              .port = $port | .sni = $sni | .fingerprint = $fp |
              if .routes[$i].transport == "grpc" then .grpc_service_name = $grpc_service_name
              elif .routes[$i].transport == "xhttp" then .xhttp_path = $xhttp_path
              else . end
            else . end
          end
        ' "$profile_file"; then
        _restore_config_backup "$rollback_config" || true
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}✗ Profile JSON не обновлён — операция полностью откачена${NC}"
        return
      fi
    else
      if ! safe_jq_write \
        --argjson port "$new_port" \
        --arg sni "$target_inbound_sni" \
        --arg fp "$profile_fingerprint" \
        --arg grpc_service_name "$target_inbound_grpc_service_name" \
        --arg xhttp_path "$target_inbound_xhttp_path" '
          .port = $port | .sni = $sni | .fingerprint = $fp |
          if .transport == "grpc" then .grpc_service_name = $grpc_service_name
          elif .transport == "xhttp" then .xhttp_path = $xhttp_path
          else . end
        ' "$profile_file"; then
        _restore_config_backup "$rollback_config" || true
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}✗ Profile JSON не обновлён — операция полностью откачена${NC}"
        return
      fi
    fi

  else
    local source_client_count
    source_client_count=$(jq -r --argjson port "$old_port" \
      '[.inbounds[] | select(.port == $port) | .settings.clients[]?] | length' \
      "$CONFIG_FILE" 2>/dev/null)
    if [[ ! "$source_client_count" =~ ^[0-9]+$ ]] || [[ "$source_client_count" -lt 1 ]]; then
      _restore_config_backup "$rollback_config" || true
      _restore_profiles_snapshot "$profiles_snapshot" || true
      _discard_profiles_snapshot "$profiles_snapshot"
      echo -e "${RED}✗ Исходный inbound не содержит профиль — операция отменена${NC}"
      return
    fi

    if [[ "$source_client_count" -gt 1 ]]; then
      # Shared inbound: move only the selected UUID. Moving the inbound itself
      # would silently move every other profile that shares the old port.
      if ! add_inbound \
        "$profile_uuid" "$profile_transport" "$new_port" "$profile_sni" \
        "$profile_fingerprint" "$profile_grpc_service_name" "$profile_xhttp_path" \
        "$profile_pq_enabled"; then
        _restore_config_backup "$rollback_config" || true
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}✗ Не удалось создать inbound на новом порту — операция откачена${NC}"
        return
      fi
      if ! _remove_profile_uuid_from_config "$profile_uuid" "[$old_port]"; then
        _restore_config_backup "$rollback_config" || true
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}✗ Не удалось извлечь профиль из общего inbound — операция откачена${NC}"
        return
      fi

      if [[ -n "$route_index" ]]; then
        if ! safe_jq_write --argjson i "$route_index" --argjson port "$new_port" '
          .routes[$i].port = $port |
          if $i == 0 then .port = $port else . end
        ' "$profile_file"; then
          _restore_config_backup "$rollback_config" || true
          _restore_profiles_snapshot "$profiles_snapshot" || true
          _discard_profiles_snapshot "$profiles_snapshot"
          echo -e "${RED}✗ Не удалось обновить route profile JSON — операция откачена${NC}"
          return
        fi
      elif ! safe_jq_write --argjson port "$new_port" '.port = $port' "$profile_file"; then
        _restore_config_backup "$rollback_config" || true
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}✗ Не удалось обновить profile JSON — операция откачена${NC}"
        return
      fi
    else
      if ! safe_jq_write --argjson old_port "$old_port" --argjson new_port "$new_port" '
        if ([.inbounds[] | select(.port == $old_port)] | length) != 1 then
          error("source inbound not unique")
        else
          (.inbounds[] | select(.port == $old_port) | .port) = $new_port |
          (.inbounds[] | select(.port == $new_port) | .tag) = ("inbound-" + ($new_port | tostring))
        end
      ' "$CONFIG_FILE"; then
        _restore_config_backup "$rollback_config" || true
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}  ✗ Ошибка смены порта в конфиге — операция отменена${NC}"
        return
      fi

      if ! update_all_profiles_port_reference "$old_port" "$new_port"; then
        _restore_config_backup "$rollback_config" || true
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}✗ Не удалось обновить все profile JSON — операция полностью откачена${NC}"
        return
      fi
    fi
  fi

  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ Xray не принял новый порт — config и profile JSON откачены${NC}"
    return
  fi
  _discard_profiles_snapshot "$profiles_snapshot"

  open_firewall_port "$new_port" || \
    echo -e "${YELLOW}⚠ Новый порт $new_port не открыт через UFW — проверьте firewall вручную${NC}"
  close_firewall_port "$old_port"

  echo ""
  echo -e "${GREEN}✓ Порт '${target_label}' изменен: ${YELLOW}$old_port → $new_port${NC}"
  echo ""
  echo -e "${MAGENTA}╔═══════════════════════════════════════════════════════════╗${NC}"
  echo -e "${MAGENTA}║        Теперь ОБЯЗАТЕЛЬНО получите новую ссылку!        ║${NC}"
  echo -e "${MAGENTA}╚═══════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
  read
}

manage_profile_advanced_menu() {
  local profile_name="$1"
  local profile_file="$PROFILES_DIR/$profile_name.json"

  if [[ ! -f "$profile_file" ]]; then
    echo -e "${RED}Профиль не найден: $profile_name${NC}"
    sleep 2
    return
  fi

  show_ascii
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
  echo -e "${BLUE}    АДВАНС НАСТРОЙКИ ПРОФИЛЯ (EXPERIMENTAL)   ${NC}"
  echo -e "${BLUE}    Профиль: $profile_name${NC}"
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
  echo ""
  echo -e "${RED}╔═══════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  EXPERIMENTAL — VISION SEED                              ║${NC}"
  echo -e "${RED}╠═══════════════════════════════════════════════════════════╣${NC}"
  echo -e "${RED}║  Эти поля (testpre/testseed) появились в Xray-core       ║${NC}"
  echo -e "${RED}║  v1.251201.0 (декабрь 2025). Могут сломать подключения  ║${NC}"
  echo -e "${RED}║  клиентов на старых версиях Xray. Не тестировалось на   ║${NC}"
  echo -e "${RED}║  реальных конфигах.                                     ║${NC}"
  echo -e "${RED}║                                                           ║${NC}"
  echo -e "${RED}║  testpre на серверной стороне parsed-but-not-used:       ║${NC}"
  echo -e "${RED}║  pre-connect логика работает только в outbound клиента.  ║${NC}"
  echo -e "${RED}║  Чтобы testpre дал эффект, клиенту нужно установить      ║${NC}"
  echo -e "${RED}║  то же значение в своем VLESS outbound.                  ║${NC}"
  echo -e "${RED}║  testseed работает на обеих сторонах.                    ║${NC}"
  echo -e "${RED}╚═══════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -n -e "${YELLOW}Продолжить? [y/N]: ${NC}"
  local ans
  read -r ans
  [[ "$ans" =~ ^[yYдД]$ ]] || return

  local xray_ver
  xray_ver=$(xray version 2>/dev/null | head -1 | awk '{print $2}')
  if [[ -n "$xray_ver" ]]; then
    local major minor
    major=$(echo "$xray_ver" | cut -d'.' -f1)
    minor=$(echo "$xray_ver" | cut -d'.' -f2)
    if [[ "$major" == "1" && "$minor" =~ ^[0-9]+$ && "$minor" -lt 251201 ]]; then
      echo -e "${YELLOW}Xray-core версия $xray_ver — testpre/testseed появились в v1.251201.0+${NC}"
      echo -e "${YELLOW}  Поля будут добавлены в config, но эффекта не дадут. Рекомендуется sudo xrayebator update.${NC}"
      echo -n -e "${YELLOW}Продолжить все равно? [y/N]: ${NC}"
      read -r ans
      [[ "$ans" =~ ^[yYдД]$ ]] || return
    fi
  fi

  local cur_pre cur_seed
  cur_pre=$(jq -r '.testpre // "не задано"' "$profile_file" 2>/dev/null)
  cur_seed=$(jq -c '.testseed // []' "$profile_file" 2>/dev/null)
  echo -e "${CYAN}Текущие значения: testpre=${cur_pre}, testseed=${cur_seed}${NC}"
  echo ""

  echo -n -e "${YELLOW}testpre (uint32, 0=off, эффект только на клиенте) [0]: ${NC}"
  local testpre_val
  read -r testpre_val
  testpre_val=${testpre_val:-0}
  if [[ ! "$testpre_val" =~ ^[0-9]+$ ]]; then
    echo -e "${YELLOW}Некорректный testpre — будет использован 0${NC}"
    testpre_val=0
  fi

  echo -n -e "${YELLOW}testseed (uint32 через пробел, пусто=off) []: ${NC}"
  local testseed_input
  read -r testseed_input
  local -a testseed_values=()
  local seed
  for seed in $testseed_input; do
    if [[ "$seed" =~ ^[0-9]+$ ]]; then
      testseed_values+=("$seed")
    else
      echo -e "${RED}✗ Некорректный testseed элемент: $seed${NC}"
      sleep 2
      return
    fi
  done

  local testseed_json="[]"
  if [[ ${#testseed_values[@]} -gt 0 ]]; then
    testseed_json=$(printf '%s\n' "${testseed_values[@]}" | jq -R 'select(length > 0) | tonumber' | jq -s '.')
  fi

  echo ""
  echo -e "${CYAN}Будет применено:${NC}"
  echo -e "  ${YELLOW}testpre${NC} = $testpre_val"
  echo -e "  ${YELLOW}testseed${NC} = $testseed_json"
  echo -n -e "${YELLOW}Применить? [y/N]: ${NC}"
  local confirm
  read -r confirm
  [[ "$confirm" =~ ^[yYдД]$ ]] || { echo -e "${CYAN}✓ Отменено${NC}"; sleep 1; return; }

  local port uuid
  port=$(jq -r '.port' "$profile_file" 2>/dev/null)
  uuid=$(jq -r '.uuid' "$profile_file" 2>/dev/null)
  if [[ ! "$port" =~ ^[0-9]+$ ]] || [[ -z "$uuid" || "$uuid" == "null" ]]; then
    echo -e "${RED}✗ В профиле нет корректного port/uuid${NC}"
    sleep 2
    return
  fi

  local rollback_config=""
  local profiles_snapshot=""
  if ! backup_config "vision_seed" rollback_config; then
    echo -e "${RED}✗ Не удалось создать бэкап config.json${NC}"
    return
  fi
  if ! _snapshot_profiles profiles_snapshot; then
    echo -e "${RED}✗ Не удалось создать снимок profile JSON${NC}"
    return
  fi

  if ! safe_jq_write \
      --argjson testpre "$testpre_val" \
      --argjson testseed "$testseed_json" \
      '. + {testpre: $testpre, testseed: $testseed}' \
      "$profile_file"; then
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ Ошибка записи profile JSON${NC}"
    sleep 2
    return
  fi

  if ! safe_jq_write \
      --argjson port "$port" \
      --arg uuid "$uuid" \
      --argjson testpre "$testpre_val" \
      --argjson testseed "$testseed_json" \
      'if any(.inbounds[] | select(.port == $port) | .settings.clients[]?; .id == $uuid) then
         (.inbounds[] | select(.port == $port) | .settings.clients[] | select(.id == $uuid)) |=
           (. + {testpre: $testpre, testseed: $testseed})
       else
         error("profile UUID not found on inbound")
       end' \
      "$CONFIG_FILE"; then
    _restore_config_backup "$rollback_config" || true
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ Ошибка записи config.json${NC}"
    sleep 2
    return
  fi

  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ Xray не принял Vision Seed — config и profile JSON откачены${NC}"
    return
  fi
  _discard_profiles_snapshot "$profiles_snapshot"
  echo -e "${GREEN}Vision Seed применен. testpre=${testpre_val}, testseed=${testseed_json}${NC}"
  echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
  read -r _
}

# ═══════════════════════════════════════════════════════════
# POST-QUANTUM UPGRADE (REQ-A09 REVISED — IN-PLACE replace)
# ═══════════════════════════════════════════════════════════

# Меню in-place миграции legacy профиля на XHTTP+Reality+PQ.
# Сохраняет UUID и port исходного инбаунда; перезаписывает streamSettings + decryption.
# При shared inbound (>1 профиля на порту) — ВСЕ профили на этом порту переводятся.
# Внутренне разбит на 3 фазы (1a UI / 1b MUTATION / 1c POST-MUTATION) для checkpoint-recoverability.
upgrade_profile_to_pq_menu() {
  # === Phase 1a: UI / VALIDATION ===
  # Цель: собрать и провалидировать все входные данные ДО любых мутаций.
  # Если оператор прерывает (Ctrl+C / выбор 0 / "n" в подтверждении) — НИЧЕГО не изменено.
  show_ascii
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
  echo -e "${BLUE}   ОБНОВЛЕНИЕ ПРОФИЛЯ ДО POST-QUANTUM         ${NC}"
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}\n"

  # Pre-check: ключи vlessenc должны существовать (Plan 6.1 marker .mlkem_keys_generated)
  if [[ ! -f "$VLESS_DECRYPTION_FILE" ]] || [[ ! -f "$VLESS_ENCRYPTION_FILE" ]]; then
    echo -e "${RED}✗ ML-KEM ключи не найдены ($VLESS_DECRYPTION_FILE).${NC}"
    echo -e "${YELLOW}  Запустите xrayebator update — миграция .mlkem_keys_generated должна сгенерировать ключи.${NC}"
    echo -n -e "${YELLOW}Нажмите Enter для возврата...${NC}"; read
    return
  fi

  # Список ВСЕХ профилей с пометкой PQ-статуса
  local profiles=($(ls -1 "$PROFILES_DIR" 2>/dev/null | sed 's/.json//'))
  if [[ ${#profiles[@]} -eq 0 ]]; then
    echo -e "${RED}✗ Нет созданных профилей${NC}"
    echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"; read
    return
  fi

  echo -e "${YELLOW}Выберите профиль для перевода на post-quantum:${NC}\n"
  local i=1
  local upgradeable=()
  for profile in "${profiles[@]}"; do
    local pfile="$PROFILES_DIR/$profile.json"
    local transport=$(jq -r '.transport // "tcp"' "$pfile" 2>/dev/null)
    local port=$(jq -r '.port // "-"' "$pfile" 2>/dev/null)
    if profile_has_routes "$pfile"; then
      local route_count
      route_count=$(_profile_route_count "$pfile")
      if _profile_has_pq_route "$pfile"; then
        echo -e "${CYAN} —)${NC} $profile ${BLUE}[multi-route: ${route_count} routes]${NC} ${GREEN}[PQ route уже есть]${NC}"
      else
        echo -e "${CYAN} —)${NC} $profile ${BLUE}[multi-route: ${route_count} routes]${NC} ${YELLOW}[апгрейд делается по маршрутам вручную]${NC}"
      fi
      continue
    fi

    local pq=$(jq -r '.pq_enabled // false' "$pfile" 2>/dev/null)
    if [[ "$pq" == "true" ]]; then
      echo -e "${CYAN} —)${NC} $profile ${BLUE}[порт:$port,$transport]${NC} ${GREEN}[уже PQ]${NC}"
    else
      echo -e "${CYAN} $i)${NC} $profile ${BLUE}[порт:$port,$transport]${NC} ${YELLOW}[legacy]${NC}"
      upgradeable+=("$profile")
      ((i++))
    fi
  done
  echo -e "${CYAN} 0)${NC} Назад\n"

  if [[ ${#upgradeable[@]} -eq 0 ]]; then
    echo -e "${GREEN}✓ Нет single-route legacy профилей для in-place PQ upgrade.${NC}"
    echo -e "${CYAN}Multi-route профили уже содержат отдельные legacy/PQ маршруты.${NC}"
    echo -n -e "${YELLOW}Нажмите Enter для возврата...${NC}"; read
    return
  fi

  echo -n -e "${YELLOW}Выберите профиль (1-${#upgradeable[@]}, 0 — назад): ${NC}"
  read choice
  if [[ "$choice" == "0" ]]; then return; fi
  if [[ ! "$choice" =~ ^[0-9]+$ ]] || [[ $choice -lt 1 ]] || [[ $choice -gt ${#upgradeable[@]} ]]; then
    echo -e "${RED}✗ Неверный выбор${NC}"; sleep 2; return
  fi

  local selected="${upgradeable[$((choice-1))]}"
  local pfile="$PROFILES_DIR/$selected.json"
  if profile_has_routes "$pfile"; then
    echo -e "${RED}✗ Multi-route профиль не переводится целиком через это меню.${NC}"
    echo -e "${YELLOW}  В нем уже есть отдельные legacy/PQ маршруты. Используйте raw route или создайте отдельный legacy/PQ профиль.${NC}"
    sleep 3
    return
  fi
  local port=$(jq -r '.port' "$pfile")
  local uuid=$(jq -r '.uuid' "$pfile")
  local sni=$(jq -r '.sni // "www.ozon.ru"' "$pfile")
  local fingerprint=$(jq -r '.fingerprint // "firefox"' "$pfile")
  local old_transport=$(jq -r '.transport // "tcp"' "$pfile")
  local inbound_count live_sni live_clients_json live_clients_count
  inbound_count=$(jq -r --argjson p "$port" '[.inbounds[] | select(.port == $p)] | length' "$CONFIG_FILE" 2>/dev/null)
  if [[ "$inbound_count" != "1" ]]; then
    echo -e "${RED}✗ На порту $port найдено inbound: ${inbound_count:-0}; ожидался ровно один${NC}"
    sleep 2
    return
  fi
  live_sni=$(jq -r --argjson p "$port" \
    '.inbounds[] | select(.port == $p) | .streamSettings.realitySettings.serverNames[0] // empty' \
    "$CONFIG_FILE" 2>/dev/null)
  [[ -n "$live_sni" ]] && sni="$live_sni"
  live_clients_json=$(jq -c --argjson p "$port" '
    [.inbounds[] | select(.port == $p) | .settings.clients[]? | .flow = ""]
  ' "$CONFIG_FILE" 2>/dev/null)
  live_clients_count=$(jq -r 'length' <<< "$live_clients_json" 2>/dev/null)
  if [[ ! "$live_clients_count" =~ ^[0-9]+$ ]] || [[ "$live_clients_count" -lt 1 ]]; then
    echo -e "${RED}✗ Live inbound на порту $port не содержит клиентов — апгрейд прерван${NC}"
    sleep 2
    return
  fi

  # H1 fix: short_id ЧИТАЕМ ИЗ СУЩЕСТВУЮЩЕГО INBOUND (config.json), НЕ из profile JSON.
  # create_profile() в xrayebator НИКОГДА не сохраняет short_id в profile JSON.
  # Если на shared inbound сгенерировать новый short_id — Reality порвёт ВСЕ остальные клиенты на порту.
  # Зеркалим логику generate_connection() (xrayebator:2217-2220): берём первый shortIds[0] из инбаунда.
  local short_id
  short_id=$(jq -r --argjson p "$port" \
    '.inbounds[] | select(.port == $p) | .streamSettings.realitySettings.shortIds[0]' \
    "$CONFIG_FILE" 2>/dev/null)
  if [[ -z "$short_id" || "$short_id" == "null" ]]; then
    # Inbound не содержит shortIds (corrupted/legacy без Reality?) — генерируем как last resort.
    # На shared inbound этот fallback ОБЫЧНО НЕ срабатывает: install.sh всегда пишет shortIds.
    short_id=$(openssl rand -hex 8)
  fi

  # CRITICAL: проверка shared inbound — если на порту другие профили, ВСЕ они уйдут в PQ
  local profiles_on_port=($(get_profiles_on_port "$port"))
  local p
  local selected_listed=false
  for p in "${profiles_on_port[@]}"; do
    [[ "$p" == "$selected" ]] && selected_listed=true
  done
  [[ "$selected_listed" == "true" ]] || profiles_on_port+=("$selected")
  echo ""
  echo -e "${RED}╔═══════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║                  ⚠ ВНИМАНИЕ                                  ║${NC}"
  echo -e "${RED}╚═══════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${YELLOW}Профиль: ${MAGENTA}$selected${NC} ${BLUE}(порт $port, транспорт $old_transport → xhttp+pq)${NC}"
  echo ""
  echo -e "${YELLOW}После апгрейда:${NC}"
  echo -e "  ${RED}• Старая vless:// ссылка ПЕРЕСТАНЕТ РАБОТАТЬ немедленно${NC}"
  echo -e "  ${RED}• Все клиенты, подключённые к этому профилю, потеряют связь${NC}"
  echo -e "  ${RED}• Их нужно переимпортировать с новой vless:// (или создать отдельный legacy-профиль через 'Создать профиль')${NC}"
  echo -e "  ${YELLOW}• Затронутые клиенты (только эти умеют PQ): HAPP 3.3.6+, v2rayNG 1.10+, v2rayN (PR #7782), Shadowrocket${NC}"
  echo -e "  ${YELLOW}• НЕ совместимые: sing-box, mihomo, NekoBox, Hiddify — для них нужен отдельный legacy профиль${NC}"
  echo -e "  ${GREEN}• UUID сохраняется: $uuid${NC}"
  echo -e "  ${GREEN}• Порт сохраняется: $port${NC}"
  echo -e "  ${GREEN}• SNI сохраняется (читается из существующего инбаунда): $sni${NC}"
  echo ""
  if [[ "$live_clients_count" -gt 1 ]]; then
    echo -e "${RED}⚠ На порту $port размещён ОБЩИЙ inbound — операция МАССОВАЯ и НЕОБРАТИМАЯ:${NC}"
    echo -e "  ${RED}• ВСЕ перечисленные ниже профили будут переведены на XHTTP+PQ${NC}"
    echo -e "  ${RED}• TCP+Vision профили на этом порту потеряют flow=xtls-rprx-vision${NC}"
    echo -e "  ${RED}• Транспорт принудительно меняется tcp/grpc → xhttp в profile JSON${NC}"
    echo -e "  ${RED}• Каждому из этих профилей нужно переимпортировать клиента с НОВОЙ vless:// ссылкой${NC}"
    echo -e "  ${RED}• Путь обратно (XHTTP+PQ → TCP+Vision) ТОЛЬКО через ручное пересоздание профиля${NC}"
    echo ""
    echo -e "${YELLOW}Затронутые профили на порту $port:${NC}"
    for p in "${profiles_on_port[@]}"; do
      echo -e "  ${CYAN}•${NC} $p"
    done
    if [[ "$live_clients_count" -gt "${#profiles_on_port[@]}" ]]; then
      echo -e "  ${YELLOW}• unmanaged UUID без profile JSON: $((live_clients_count - ${#profiles_on_port[@]}))${NC}"
    fi
    echo ""
  fi
  echo -n -e "${YELLOW}Подтвердите апгрейд (y/N): ${NC}"
  read confirm
  if [[ ! "$confirm" =~ ^[yYдД]$ ]]; then
    echo -e "${YELLOW}Апгрейд отменён.${NC}"; sleep 2; return
  fi

  # === Phase 1b: MUTATION ===
  # Цель: атомарно заменить inbound на XHTTP+PQ + рестартнуть Xray.
  # Все мутации защищены точным backup + снимком profile JSON.
  echo -e "${CYAN}→ Phase 1b: бэкап и замена inbound в config.json${NC}"

  local rollback_config=""
  local profiles_snapshot=""
  if ! backup_config "upgrade_profile_pq_$selected" rollback_config; then
    echo -e "${RED}✗ Не удалось создать бэкап config.json${NC}"
    return
  fi
  if ! _snapshot_profiles profiles_snapshot; then
    echo -e "${RED}✗ Не удалось создать снимок profile JSON${NC}"
    return
  fi

  # Шаг B: читаем содержимое decryption ОДИН раз
  local VLESS_DECRYPTION
  VLESS_DECRYPTION=$(cat "$VLESS_DECRYPTION_FILE")
  if [[ -z "$VLESS_DECRYPTION" ]]; then
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ $VLESS_DECRYPTION_FILE пуст — апгрейд прерван${NC}"; sleep 2; return
  fi

  # Шаг C: сгенерировать XHTTP path (как делает add_inbound) — простой случайный
  local xhttp_path="/$(openssl rand -hex 8)"
  local PRIVATE_KEY=$(cat "$PRIVATE_KEY_FILE")
  if [[ -z "$PRIVATE_KEY" ]]; then
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ $PRIVATE_KEY_FILE пуст — апгрейд прерван${NC}"; sleep 2; return
  fi

  # Шаг D: REPLACE inbound с port=$port на новый XHTTP+pq shape (с СОХРАНЁННЫМ uuid)
  # Стратегия: del-by-port + append (НЕ object merge — иначе clobber freedom outbound и т.п.)
  local new_inbound reality_dest
  reality_dest=$(_reality_dest_for_sni "$sni")
  new_inbound=$(cat << UPGEOF
{
  "listen": "0.0.0.0",
  "port": $port,
  "protocol": "vless",
  "settings": {
    "clients": [{"id": "$uuid", "flow": ""}],
    "decryption": "$VLESS_DECRYPTION"
  },
  "streamSettings": {
    "network": "xhttp",
    "security": "reality",
    "xhttpSettings": {
      "mode": "auto",
      "path": "$xhttp_path",
      "host": "$sni",
      "extra": {
        "xPaddingBytes": "100-1000",
        "xmux": {
          "maxConcurrency": "16-32",
          "hMaxRequestTimes": "600-900",
          "hMaxReusableSecs": "1800-3000",
          "hKeepAlivePeriod": 0
        },
        "noSSEHeader": true,
        "scMaxEachPostBytes": "1000000-2000000",
        "scMinPostsIntervalMs": "10-50"
      }
    },
    "realitySettings": {
      "show": false,
      "dest": "$reality_dest",
      "xver": 0,
      "serverNames": ["$sni"],
      "privateKey": "$PRIVATE_KEY",
      "shortIds": ["$short_id"]
    }
  },
  "sniffing": {"enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true},
  "tag": "inbound-$port"
 }
UPGEOF
)

  # Источник истины — live inbound, а не список profile JSON. Так orphan/stale
  # клиенты не исчезают при shared-port upgrade; меняется только их flow.
  if ! new_inbound=$(jq -c --argjson clients "$live_clients_json" \
    '.settings.clients = $clients' <<< "$new_inbound"); then
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ Не удалось сохранить live clients для PQ inbound${NC}"
    return
  fi

  # Шаг E: атомарная замена — del-by-port + append
  if ! safe_jq_write --argjson port "$port" --argjson new_in "$new_inbound" \
    '(.inbounds |= map(select(.port != $port))) | .inbounds += [$new_in]' \
    "$CONFIG_FILE"; then
    _restore_config_backup "$rollback_config" || true
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ Ошибка обновления config.json${NC}"; sleep 2; return
  fi

  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ Xray не принял PQ inbound — config и profile JSON откачены${NC}"
    sleep 3
    return
  fi

  # === Phase 1c: POST-MUTATION ===
  # Только после успешного рестарта синхронизируем profile JSON.
  echo -e "${CYAN}→ Phase 1c: синхронизация profile JSON и вывод новой vless:// ссылки${NC}"

  # H1 fix: НЕ записываем short_id в profile JSON. Schema v1 не имела этого поля,
  # schema v2 НЕ должна вводить новое поле без явного решения. short_id живёт в
  # config.json:.inbounds[].streamSettings.realitySettings.shortIds[0] — один источник истины.
  local profiles_ok=true
  for p in "${profiles_on_port[@]}"; do
    if ! safe_jq_write --arg path "$xhttp_path" --argjson pnum "$port" \
      '.transport = "xhttp" | .schema_version = 2 | .pq_enabled = true | .xhttp_path = $path
       | if ((.routes? // []) | length) > 0 then
           .routes |= map(if .port == $pnum then
             .transport = "xhttp" | .pq_enabled = true | .xhttp_path = $path
           else . end)
         else . end' \
      "$PROFILES_DIR/$p.json"; then
      echo -e "${RED}  ✗ Ошибка обновления profile JSON: $p${NC}"
      profiles_ok=false
    else
      echo -e "${CYAN}  → Обновлен: ${YELLOW}$p${NC}"
    fi
  done

  if [[ "$profiles_ok" != "true" ]]; then
    _restore_profiles_snapshot "$profiles_snapshot" || true
    if _restore_config_backup "$rollback_config"; then
      safe_restart_xray "$rollback_config" || true
    fi
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}✗ Profile JSON не синхронизированы — PQ upgrade полностью откачен${NC}"
    sleep 3
    return
  fi
  _discard_profiles_snapshot "$profiles_snapshot"
  fix_xray_permissions

  echo ""
  echo -e "${GREEN}✓ Профиль '$selected' успешно переведён на XHTTP+PQ${NC}"
  echo -e "${CYAN}Новая vless:// ссылка:${NC}"
  generate_connection "$selected"
  echo ""
  echo -n -e "${YELLOW}Нажмите Enter для возврата в меню...${NC}"
  read
}

