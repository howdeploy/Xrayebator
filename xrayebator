  [[ "$confirm" =~ ^[yYдД]$ ]]
}

# Безопасная запись через jq — проверяет результат перед перезаписью
# Использование: safe_jq_write "выражение_jq" [аргументы_jq...] "$входной_файл" "$выходной_файл"
# Или для записи в тот же файл: safe_jq_write "выражение_jq" [аргументы_jq...] "$файл"
# Последний аргумент — целевой файл (куда записать), предпоследний — исходный
# Если целевой == исходный, делает mktemp+mv
safe_jq_write() {
  local args=("$@")
  local nargs=${#args[@]}

  # Минимум 2 аргумента: выражение и файл
  if [[ $nargs -lt 2 ]]; then
    echo -e "${RED}  ✗ safe_jq_write: недостаточно аргументов${NC}" >&2
    return 1
  fi

  _lock_acquire

  # Последний аргумент — исходный файл (и он же целевой при in-place)
  local src_file="${args[$((nargs-1))]}"
  local dst_file="$src_file"
  local jq_args=("${args[@]:0:$((nargs-1))}")

  # Сохраняем исходные права и владельца
  local orig_mode orig_owner
  orig_mode=$(stat -c %a "$src_file" 2>/dev/null || echo "644")
  orig_owner=$(stat -c %U:%G "$src_file" 2>/dev/null || echo "root:root")

  local tmp=$(mktemp)
  local result=1
  if jq "${jq_args[@]}" "$src_file" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
    mv "$tmp" "$dst_file"
    chmod "$orig_mode" "$dst_file" 2>/dev/null
    chown "$orig_owner" "$dst_file" 2>/dev/null
    result=0
  else
    echo -e "${RED}  ✗ Ошибка jq — файл НЕ изменён: $dst_file${NC}" >&2
    rm -f "$tmp"
  fi

  _lock_release
  return $result
}

# Создание бэкапа config.json перед мутацией.
# Args: $1=operation_name, $2=optional caller variable receiving the exact path.
backup_config() {
  local operation_name=${1:-"manual"}
  local result_var=${2:-}
  local backup_dir="$XRAY_BACKUPS_DIR"
  local safe_operation_name

  if [[ -n "$result_var" && ! "$result_var" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
    echo -e "${RED}  ✗ Некорректное имя переменной результата backup_config${NC}"
    return 1
  fi
  [[ -n "$result_var" ]] && printf -v "$result_var" '%s' ""

  safe_operation_name=$(printf '%s' "$operation_name" | tr -c 'a-zA-Z0-9_.-' '_')
  _lock_acquire
  mkdir -p "$backup_dir"
  chmod 700 "$backup_dir" 2>/dev/null
  chown root:root "$backup_dir" 2>/dev/null
  local backup_file="$backup_dir/config_$(date +%Y%m%d_%H%M%S_%N)_${safe_operation_name}.json"
  local result=1
  if ! cp "$CONFIG_FILE" "$backup_file"; then
    echo -e "${RED}  ✗ Не удалось создать бэкап config.json: $backup_file${NC}"
  else
    chmod 600 "$backup_file" 2>/dev/null
    chown root:root "$backup_file" 2>/dev/null
    [[ -n "$result_var" ]] && printf -v "$result_var" '%s' "$backup_file"
    echo -e "${CYAN}  -> Бэкап конфига: $(basename "$backup_file")${NC}"
    result=0
  fi
  _lock_release
  return $result
}

_restore_config_backup() {
  local backup_file=${1:-}

  if [[ -z "$backup_file" || ! -f "$backup_file" || ! -s "$backup_file" ]]; then
    echo -e "${RED}  ✗ Точный бэкап для отката отсутствует: ${backup_file:-не задан}${NC}"
    return 1
  fi
  if ! cp "$backup_file" "$CONFIG_FILE"; then
    echo -e "${RED}  ✗ Не удалось восстановить config.json из $(basename "$backup_file")${NC}"
    return 1
  fi
  # P2-rollback-fix: live config обязан быть читаем сервисом (User=xray). root:root 0600
  # после rollback делал конфиг недоступным — xray не стартовал. Backup остаётся 600
  # root:root (backup_config), live — root:xray 0640 (группа читает, пишет только root).
  chown root:xray "$CONFIG_FILE" 2>/dev/null || true
  chmod 640 "$CONFIG_FILE" 2>/dev/null || true
  echo -e "${GREEN}  ✓ Конфиг восстановлен из: $(basename "$backup_file")${NC}"
  return 0
}

_snapshot_profiles() {
  local result_var=${1:-}
  local snapshot_dir

  if [[ ! "$result_var" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
    echo -e "${RED}  ✗ Некорректное имя переменной результата _snapshot_profiles${NC}"
    return 1
  fi
  printf -v "$result_var" '%s' ""

  snapshot_dir=$(mktemp -d /tmp/xrayebator-profiles.XXXXXX) || return 1
  if [[ -d "$PROFILES_DIR" ]] && ! cp -a "$PROFILES_DIR/." "$snapshot_dir/"; then
    rm -rf -- "$snapshot_dir"
    echo -e "${RED}  ✗ Не удалось создать снимок profile JSON${NC}"
    return 1
  fi
  printf -v "$result_var" '%s' "$snapshot_dir"
  return 0
}

_restore_profiles_snapshot() {
  local snapshot_dir=${1:-}

  if [[ "$snapshot_dir" != /tmp/xrayebator-profiles.* || ! -d "$snapshot_dir" ]]; then
    echo -e "${RED}  ✗ Некорректный снимок profile JSON: ${snapshot_dir:-не задан}${NC}"
    return 1
  fi
  mkdir -p "$PROFILES_DIR"
  if ! cp -a "$snapshot_dir/." "$PROFILES_DIR/"; then
    echo -e "${RED}  ✗ Не удалось восстановить profile JSON${NC}"
    return 1
  fi
  echo -e "${GREEN}  ✓ Profile JSON восстановлены${NC}"
  return 0
}

_discard_profiles_snapshot() {
  local snapshot_dir=${1:-}
  if [[ "$snapshot_dir" == /tmp/xrayebator-profiles.* && -d "$snapshot_dir" ]]; then
    rm -rf -- "$snapshot_dir"
  fi
}

ensure_xray_runtime_user() {
  if getent passwd xray >/dev/null 2>&1; then
    return 0
  fi

  local nologin="/usr/sbin/nologin"
  [[ -x "$nologin" ]] || nologin="/sbin/nologin"
  [[ -x "$nologin" ]] || nologin="/bin/false"

  echo -e "${YELLOW}  ⚠ Пользователь xray отсутствует — создаю runtime user${NC}"
  if ! getent group xray >/dev/null 2>&1; then
    groupadd -r xray 2>/dev/null || true
  fi

  if getent group xray >/dev/null 2>&1; then
    useradd -r -g xray -s "$nologin" -M -d /nonexistent xray
  else
    useradd -r -s "$nologin" -M -d /nonexistent xray
  fi

  if ! getent passwd xray >/dev/null 2>&1; then
    echo -e "${RED}  ✗ Не удалось создать пользователя xray${NC}"
    return 1
  fi

  echo -e "${GREEN}  ✓ Пользователь xray создан${NC}"
  return 0
}

# Восстановление прав (privilege boundary, P0-fix).
# Конфигурационные каталоги, state markers и root-исполняемые скрипты принадлежат
# root:root. Сервис xray получает ТОЛЬКО чтение (644/755): config.json, профили,
# keys (public/encryption — нужны subhttp для генерации URL), announce/happ_defaults.
# Запись в /usr/local/etc/xray разрешена только root (управление через sudo).
# Приватные ключи (.private_key, .vless_decryption) — 600 root:root.
# НЕ выполнять chown -R xray:xray: владелец каталога может подменить root-скрипты
# (update.sh/uninstall.sh) и .install_step_* markers → privilege escalation.
fix_xray_permissions() {
  ensure_xray_runtime_user >/dev/null 2>&1 || true
  local base="/usr/local/etc/xray"
  # 1. Корень и каталоги — root:root 755 (xray читает, но не пишет).
  chown root:root "$base" 2>/dev/null || true
  chmod 755 "$base" 2>/dev/null || true
  find "$base" -maxdepth 1 -type d -exec chown root:root {} + 2>/dev/null || true
  find "$base" -maxdepth 1 -type d -exec chmod 755 {} + 2>/dev/null || true
  find "$base"/profiles "$base"/backups "$base"/data "$base"/scripts "$base"/upstreams -maxdepth 1 -type d -exec chmod 755 {} + 2>/dev/null || true
  # 2. Приватные ключи — 600 root:root.
  chown root:root "$base/.private_key" "$base/.vless_decryption" 2>/dev/null || true
  chmod 600 "$base/.private_key" "$base/.vless_decryption" 2>/dev/null || true
  # 3. Публичные ключи — 644 root:root (читаются xray/subhttp для VLESS URL).
  chown root:root "$base/.public_key" "$base/.vless_encryption" 2>/dev/null || true
  chmod 644 "$base/.public_key" "$base/.vless_encryption" 2>/dev/null || true
  # 4. Конфигурация и файлы, которые xray должен ЧИТАТЬ: 644 root:root.
  chown root:root "$base/config.json" 2>/dev/null || true
  chmod 644 "$base/config.json" 2>/dev/null || true
  chown root:root "$base"/profiles/*.json 2>/dev/null || true
  chmod 644 "$base"/profiles/*.json 2>/dev/null || true
  chown root:root "$base"/.subscription_port "$base"/.subscription_domain "$base"/.subscription_server_addr "$base"/.subscription_mode "$base"/.happ_defaults.env "$base"/.subscription_installed "$base"/.happ_routing.json "$base"/announce.txt "$base"/.current_branch "$base"/.config_optimized "$base"/.certbot_owned 2>/dev/null || true
  chmod 644 "$base"/.subscription_port "$base"/.subscription_domain "$base"/.subscription_server_addr "$base"/.subscription_mode "$base"/.happ_defaults.env "$base"/.subscription_installed "$base"/.happ_routing.json "$base"/announce.txt "$base"/.current_branch "$base"/.config_optimized "$base"/.certbot_owned 2>/dev/null || true
  # 5. Прочие state markers — root:root 644 (включая .install_step_*_ok и миграционные).
  find "$base" -maxdepth 1 -type f -name '.*' ! -name '.private_key' ! -name '.vless_decryption' ! -name '.public_key' ! -name '.vless_encryption' \
    -exec chown root:root {} + 2>/dev/null || true
  find "$base" -maxdepth 1 -type f -name '.*' ! -name '.private_key' ! -name '.vless_decryption' ! -name '.public_key' ! -name '.vless_encryption' \
    -exec chmod 644 {} + 2>/dev/null || true
  # 6. Root-исполняемые скрипты: root:root 755 (не подменяемы xray).
  chown root:root "$base"/scripts/*.sh /usr/local/bin/xrayebator /usr/local/bin/subhttp.sh /usr/local/bin/xrayebator-update /usr/local/bin/xrayebator-uninstall 2>/dev/null || true
  chmod 755 "$base"/scripts/*.sh /usr/local/bin/xrayebator /usr/local/bin/subhttp.sh /usr/local/bin/xrayebator-update /usr/local/bin/xrayebator-uninstall 2>/dev/null || true
  # 7. Лог-каталог xray — xray:xray (сервис пишет журнал туда).
  # /var/log/xray — единственное место, где xray пишет; остальное root:root (P0-fix).
  chown xray:xray /var/log/xray 2>/dev/null || true
}

ensure_xray_service_unit() {
  if ! ensure_xray_runtime_user; then
    return 1
  fi

  if systemctl cat xray.service >/dev/null 2>&1; then
    return 0
  fi

  echo -e "${YELLOW}  ⚠ systemd unit xray.service не найден — создаю базовый unit${NC}"
  cat > /etc/systemd/system/xray.service <<'SVCEOF'
[Unit]
Description=Xray Service
Documentation=https://github.com/XTLS/Xray-core
After=network.target nss-lookup.target
Wants=network-online.target

[Service]
User=xray
Group=xray
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/local/bin/xray run -config /usr/local/etc/xray/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
SVCEOF
  chmod 644 /etc/systemd/system/xray.service
  systemctl daemon-reload
  systemctl enable xray >/dev/null 2>&1 || true

  if systemctl cat xray.service >/dev/null 2>&1; then
    echo -e "${GREEN}  ✓ xray.service создан${NC}"
    return 0
  fi

  echo -e "${RED}  ✗ Не удалось создать xray.service${NC}"
  return 1
}

# Безопасный перезапуск Xray с валидацией конфига.
# Args: $1=exact backup path for this operation (required for rollback).
# Returns: 0=success, 1=failure (validation/restart failed; rollback attempted)
safe_restart_xray() {
  local rollback_backup=${1:-}

  if [[ ! -x "$XRAY_BIN" ]]; then
    echo -e "${RED}  ✗ Бинарник $XRAY_BIN не найден${NC}"
    [[ -n "$rollback_backup" ]] && _restore_config_backup "$rollback_backup"
    return 1
  fi

  if [[ ! -f "$CONFIG_FILE" || ! -s "$CONFIG_FILE" ]]; then
    echo -e "${RED}  ✗ config.json отсутствует или пустой — Xray НЕ перезапущен${NC}"
    if [[ -n "$rollback_backup" ]]; then
      echo -e "${YELLOW}  -> Восстанавливаю конфиг из бэкапа...${NC}"
      _restore_config_backup "$rollback_backup"
    fi
    return 1
  fi

  local test_output
  test_output=$("$XRAY_BIN" run -test -format json -config "$CONFIG_FILE" 2>&1)

  if ! grep -q "Configuration OK" <<< "$test_output"; then
    echo -e "${RED}  ✗ Конфиг не прошёл валидацию -- Xray НЕ перезапущен${NC}"
    echo -e "${YELLOW}  Ошибка: ${test_output}${NC}"

    if [[ -n "$rollback_backup" ]]; then
      echo -e "${YELLOW}  -> Восстанавливаю конфиг из бэкапа...${NC}"
      _restore_config_backup "$rollback_backup"
    fi
    return 1
  fi

  if ! ensure_xray_service_unit; then
    [[ -n "$rollback_backup" ]] && _restore_config_backup "$rollback_backup"
    return 1
  fi

  systemctl restart xray
  sleep 1

  if systemctl is-active --quiet xray; then
    echo -e "${GREEN}  ✓ Xray перезапущен${NC}"
    return 0
  else
    echo -e "${RED}  ✗ Xray не запустился после перезапуска${NC}"
    if [[ -n "$rollback_backup" ]]; then
      echo -e "${YELLOW}  -> Откатываю config.json и пробую вернуть старую конфигурацию...${NC}"
      if _restore_config_backup "$rollback_backup"; then
        systemctl restart xray
        sleep 1
      fi
      if systemctl is-active --quiet xray; then
        echo -e "${GREEN}  ✓ Xray восстановлен на предыдущем конфиге${NC}"
      else
        echo -e "${RED}  ✗ Откат конфига не поднял Xray — требуется ручная проверка${NC}"
      fi
    fi
    return 1
  fi
}

# Open port in UFW firewall (idempotent)
# Args: $1=port, $2=protocol (default: tcp)
# Returns: 0=success, 1=failure
open_firewall_port() {
  local port=$1
  local protocol=${2:-tcp}

  # Validate port number
  if [[ ! "$port" =~ ^[0-9]+$ ]] || [[ $port -lt 1 ]] || [[ $port -gt 65535 ]]; then
    echo -e "${RED}  ✗ Неверный порт: $port${NC}" >&2
    return 1
  fi

  # Check if UFW is installed and active
  if ! command -v ufw &>/dev/null; then
    echo -e "${YELLOW}  ⚠ UFW не установлен${NC}" >&2
    return 1
  fi

  if ! ufw status | grep -q "Status: active"; then
    echo -e "${YELLOW}  ⚠ UFW не активен — правило не применено${NC}" >&2
    return 1
  fi

  # Check if port already open (idempotent)
  if ufw status | grep -qE "^${port}/${protocol}.*ALLOW"; then
    echo -e "${CYAN}  → Порт ${port}/${protocol} уже открыт${NC}"
    return 0
  fi

  # Open port
  echo -e "${CYAN}  → Открываю порт ${port}/${protocol}...${NC}"
  if ufw allow "${port}/${protocol}" >/dev/null 2>&1; then
    echo -e "${GREEN}  ✓ Порт ${port}/${protocol} открыт${NC}"
    # P2-fix: фиксируем в root-owned манифесте, что правило открыл именно Xrayebator.
    _ufw_register_port "$port" "$protocol"
    ufw reload >/dev/null 2>&1
    return 0
  else
    echo -e "${RED}  ✗ Ошибка открытия порта${NC}" >&2
    return 1
  fi
}

# Close port in UFW if not used by other profiles
# Args: $1=port, $2=protocol (default: tcp)
close_firewall_port() {
  local port=$1
  local protocol=${2:-tcp}
  # Check if port is still used by any inbound
  local port_in_use=$(jq -r --argjson port "$port" \
    '.inbounds[] | select(.port == $port) | .tag' \
    "$CONFIG_FILE" 2>/dev/null)

  if [[ -n "$port_in_use" ]]; then
    return 0  # Still in use, don't close
  fi

  # Never close default ports
  local default_ports=(22 80 443 8443 2053 2083 2087 8080 2096 8880 9443)
  for dp in "${default_ports[@]}"; do
    [[ "$port" == "$dp" ]] && return 0
  done

  # Close port
  if ufw status | grep -qE "^${port}/${protocol}.*ALLOW"; then
    echo -e "${CYAN}  → Закрываю порт ${port}/${protocol}...${NC}"
    ufw delete allow "${port}/${protocol}" >/dev/null 2>&1
    ufw reload >/dev/null 2>&1
    echo -e "${GREEN}  ✓ Порт закрыт${NC}"
  fi

  return 0
}

# Реестр UFW-правил, добавленных Xrayebator (root-owned, /usr/local/etc/xray/.ufw_owned).
# uninstall.sh удаляет ТОЛЬКО порты из этого манифеста (плюс динамические порты из
# реального config.json) — чужие правила 443/8443/8080 и т.п. НЕ затрагиваются.
# Формат строки: "<port>/<proto>". Вызывать сразу после успешного ufw allow.
# Args: $1=port, $2=protocol (default: tcp)
_ufw_register_port() {
  local port=$1
  local protocol=${2:-tcp}
  [[ "$port" =~ ^[0-9]+$ ]] || return 0
  local manifest="${UFW_OWNED_MANIFEST:-/usr/local/etc/xray/.ufw_owned}"
  local entry="${port}/${protocol}"
  if [[ ! -f "$manifest" ]]; then
    printf '%s\n' "$entry" > "$manifest"
  else
    grep -qxF "$entry" "$manifest" 2>/dev/null || printf '%s\n' "$entry" >> "$manifest"
  fi
  chmod 644 "$manifest" 2>/dev/null || true
  chown root:root "$manifest" 2>/dev/null || true
}

# Check whether a profile has route array
profile_has_routes() {
  local profile_file=$1
  jq -e '(.routes // []) | length > 0' "$profile_file" >/dev/null 2>&1
}

# Select one route from a multi-route profile.
# Sets global SELECTED_ROUTE_INDEX on success.
select_route_for_profile() {
  local profile_file=$1
  local action_label=${2:-"изменения"}
  local route_count
  route_count=$(_profile_route_count "$profile_file")
  SELECTED_ROUTE_INDEX=""

  if [[ ! "$route_count" =~ ^[0-9]+$ ]] || [[ "$route_count" -le 0 ]]; then
    return 1
  fi

  echo ""
  echo -e "${YELLOW}Профиль содержит несколько маршрутов. Выберите маршрут для ${action_label}:${NC}\n"
  jq -r '
    to_entries[] |
    "  \(.key + 1)) \(.value.label // .value.transport): \(.value.transport) :\(.value.port) sni=\(.value.sni // "n/a") fp=\(.value.fingerprint // "firefox")"
  ' < <(jq '.routes // []' "$profile_file")
  echo -e "  ${CYAN}0)${NC} Назад"
  echo ""
  echo -n -e "${YELLOW}Маршрут: ${NC}"
  local route_choice
  read -r route_choice
  [[ "$route_choice" == "0" ]] && return 1
  if [[ ! "$route_choice" =~ ^[0-9]+$ ]] || [[ "$route_choice" -lt 1 ]] || [[ "$route_choice" -gt "$route_count" ]]; then
    echo -e "${RED}✗ Неверный выбор маршрута${NC}"
    sleep 2
    return 1
  fi

  SELECTED_ROUTE_INDEX=$((route_choice - 1))
  return 0
}

# Check if a profile references a port either as top-level profile port or route port.
profile_uses_port() {
  local profile_file=$1
  local port=$2
  jq -e --argjson port "$port" '
    (.port == $port) or any((.routes // [])[]; .port == $port)
  ' "$profile_file" >/dev/null 2>&1
}

# Get list of profile names using a specific port
# Args: $1=port
# Returns: space-separated profile names
get_profiles_on_port() {
  local port=$1
  local profiles=()

  for pf in "$PROFILES_DIR"/*.json; do
    [[ ! -f "$pf" ]] && continue
    [[ "$pf" == *"_test.json" ]] && continue

    if profile_uses_port "$pf" "$port"; then
      profiles+=("$(basename "$pf" .json)")
    fi
  done

  echo "${profiles[@]}"
}

# Update field for all profiles on a specific port
# Args: $1=port, $2=field, $3=value
update_all_profiles_on_port() {
  local port=$1
  local field=$2
  local value=$3

  local profiles=($(get_profiles_on_port "$port"))
  local ok=true

  for pname in "${profiles[@]}"; do
    local pfile="$PROFILES_DIR/$pname.json"
    if safe_jq_write --argjson port "$port" --arg f "$field" --arg v "$value" '
      if .port == $port then .[$f] = $v else . end |
      (.routes // []) |= map(if .port == $port then .[$f] = $v else . end)
    ' "$pfile"; then
      echo -e "${CYAN}  → Обновлен: ${YELLOW}$pname${NC}"
    else
      echo -e "${RED}  ✗ Ошибка обновления: ${YELLOW}$pname${NC}"
      ok=false
    fi
  done
  [[ "$ok" == "true" ]]
}

# Update the client-side Reality fingerprint for exactly one profile route.
# Fingerprint controls the client's TLS ClientHello and is not an inbound/port setting.
# For route 0, keep the legacy top-level mirror in sync for older readers.
update_profile_fingerprint() {
  local profile_file=$1
  local route_index=$2
  local fingerprint=$3

  if [[ -n "$route_index" ]]; then
    safe_jq_write --argjson i "$route_index" --arg fp "$fingerprint" '
      if (.routes[$i] // null) == null then
        error("route not found")
      else
        .routes[$i].fingerprint = $fp |
        if $i == 0 then .fingerprint = $fp else . end
      end
    ' "$profile_file"
  else
    safe_jq_write --arg fp "$fingerprint" '.fingerprint = $fp' "$profile_file"
  fi
}

# Update the stored port for every profile/route that references old_port.
update_all_profiles_port_reference() {
  local old_port=$1
  local new_port=$2

  local profiles=($(get_profiles_on_port "$old_port"))
  local ok=true
  local pname
  for pname in "${profiles[@]}"; do
    local pfile="$PROFILES_DIR/$pname.json"
    if safe_jq_write --argjson old_port "$old_port" --argjson new_port "$new_port" '
      if .port == $old_port then .port = $new_port else . end |
      (.routes // []) |= map(if .port == $old_port then .port = $new_port else . end)
    ' "$pfile"; then
      echo -e "${CYAN}  → Обновлен порт: ${YELLOW}$pname${NC}"
    else
      echo -e "${RED}  ✗ Ошибка обновления порта: ${YELLOW}$pname${NC}"
      ok=false
    fi
  done
  [[ "$ok" == "true" ]]
}

# Проверяет отдельный sysctl.d-файл по одному из двух точных шаблонов,
# которые выпускал Xrayebator. Изменённый оператором файл удалять нельзя.
_is_known_legacy_tcp_tuning_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || return 1

  local content minimal extended
  content=$(<"$path") || return 1
  minimal=$'# Xrayebator minimal TCP tuning\nnet.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr'
  extended=$'# Xrayebator extended TCP tuning\nnet.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr\nnet.ipv4.tcp_fastopen=3\nnet.ipv4.tcp_slow_start_after_idle=0\nnet.ipv4.tcp_notsent_lowat=16384\nnet.ipv4.tcp_rmem=4096 87380 16777216\nnet.ipv4.tcp_wmem=4096 65536 16777216\nnet.core.rmem_max=16777216\nnet.core.wmem_max=16777216\nnet.core.rmem_default=1048576\nnet.core.wmem_default=1048576\nnet.ipv4.ip_local_port_range=1024 65535\nnet.ipv4.tcp_max_tw_buckets=2000000\nnet.ipv4.tcp_fin_timeout=10\nnet.ipv4.tcp_keepalive_time=600\nnet.ipv4.tcp_keepalive_intvl=30\nnet.ipv4.tcp_keepalive_probes=3\nnet.ipv4.tcp_mtu_probing=1\nnet.ipv4.tcp_syncookies=1\nnet.core.netdev_max_backlog=16384\nnet.ipv4.tcp_max_syn_backlog=8192'

  [[ "$content" == "$minimal" || "$content" == "$extended" ]]
}

# Удаляет только исторический блок, который старые версии добавляли в
# /etc/sysctl.conf после собственного marker-комментария.
# Returns: 0=block removed, 1=no block, 2=unexpected/unsafe block.
_strip_legacy_tcp_tuning_block() {
  local source_file="$1"
  local target_file="$2"

  awk '
    function is_known_key(line) {
      return line ~ /^net\.(core\.(default_qdisc|rmem_max|wmem_max|rmem_default|wmem_default|netdev_max_backlog)|ipv4\.(tcp_congestion_control|tcp_fastopen|tcp_slow_start_after_idle|tcp_notsent_lowat|tcp_rmem|tcp_wmem|ip_local_port_range|tcp_max_tw_buckets|tcp_fin_timeout|tcp_keepalive_time|tcp_keepalive_intvl|tcp_keepalive_probes|tcp_mtu_probing|tcp_syncookies|tcp_max_syn_backlog))=/
    }
    $0 == "# BBR TCP Congestion Control Optimization" {
      if (inside || found) {
        bad = 1
      }
      inside = 1
      found = 1
      next
    }
    inside && is_known_key($0) { next }
    inside && $0 ~ /^[[:space:]]*$/ {
      inside = 0
      next
    }
    inside {
      bad = 1
      inside = 0
    }
    { print }
    END {
      if (bad) {
        exit 2
      }
      if (!found) {
        exit 1
      }
    }
  ' "$source_file" > "$target_file"
}

_find_persistent_bbr_sources() {
  local scan_paths="${1:-$SYSCTL_SCAN_PATHS}"
  local -a paths
  local path candidate
  IFS=':' read -r -a paths <<< "$scan_paths"

  for path in "${paths[@]}"; do
    if [[ -f "$path" && ! -L "$path" ]]; then
      if grep -Eq '^[[:space:]]*net\.ipv4\.tcp_congestion_control[[:space:]]*=[[:space:]]*bbr([[:space:]]*(#.*)?)?$' "$path"; then
        printf '%s\n' "$path"
      fi
      continue
    fi
    [[ -d "$path" && ! -L "$path" ]] || continue
    for candidate in "$path"/*.conf; do
      [[ -f "$candidate" && ! -L "$candidate" ]] || continue
      if grep -Eq '^[[:space:]]*net\.ipv4\.tcp_congestion_control[[:space:]]*=[[:space:]]*bbr([[:space:]]*(#.*)?)?$' "$candidate"; then
        printf '%s\n' "$candidate"
      fi
    done
  done
}

# Одноразовая host-state migration для v3.0.
# Удаляет только точные файлы/блоки, созданные старыми версиями Xrayebator,
# немедленно уводит активный congestion control с BBR и не трогает чужие
# sysctl-конфиги. При чужом persistent BBR marker не ставится: миграция
# предупредит оператора и повторит проверку при следующем запуске.
migrate_remove_legacy_tcp_tuning_v3() {
  local marker="${1:-$HOST_TUNING_MIGRATION_MARKER}"
  local legacy_file="${2:-$LEGACY_TCP_TUNING_FILE}"
  local sysctl_conf="${3:-$SYSTEM_SYSCTL_CONF}"
  local active_file="${4:-$TCP_CC_ACTIVE_FILE}"
  local available_file="${5:-$TCP_CC_AVAILABLE_FILE}"
  local scan_paths="${6:-$SYSCTL_SCAN_PATHS}"
  local expected_uid="${7:-0}"

  if [[ -L "$marker" ]]; then
    echo -e "${RED}  ✗ Migration marker не должен быть symlink: $marker${NC}"
    return 1
  fi
  [[ -f "$marker" ]] && return 0
  if [[ -e "$marker" ]]; then
    echo -e "${RED}  ✗ Migration marker имеет неожиданный тип: $marker${NC}"
    return 1
  fi

  echo -e "${MAGENTA}[migration] Удаление legacy BBR/TCP tuning${NC}"

  local backup_dir=""
  local candidate=""
  local current_cc=""
  local available_cc=""
  local target_cc=""
  local remaining_sources=""
  local strip_rc=0
  local unsafe_config=0

  if [[ -e "$legacy_file" || -L "$legacy_file" ]]; then
    if [[ -L "$legacy_file" || ! -f "$legacy_file" ]] \
       || [[ "$(stat -c %u "$legacy_file" 2>/dev/null)" != "$expected_uid" ]] \
       || ! _is_known_legacy_tcp_tuning_file "$legacy_file"; then
      echo -e "${RED}  ✗ Неизвестный или изменённый файл оставлен без изменений: $legacy_file${NC}"
      unsafe_config=1
    else
      mkdir -p "$XRAY_BACKUPS_DIR" || return 1
      backup_dir=$(mktemp -d "$XRAY_BACKUPS_DIR/host-tuning-v3.XXXXXX") || return 1
      chmod 0700 "$backup_dir"
      cp -a -- "$legacy_file" "$backup_dir/99-xrayebator-tcp.conf" || return 1
      rm -f -- "$legacy_file" || return 1
      echo -e "${GREEN}  ✓ Удалён legacy sysctl.d-файл Xrayebator${NC}"
    fi
  fi

  if [[ -e "$sysctl_conf" || -L "$sysctl_conf" ]]; then
    if [[ -L "$sysctl_conf" || ! -f "$sysctl_conf" ]] \
       || [[ "$(stat -c %u "$sysctl_conf" 2>/dev/null)" != "$expected_uid" ]]; then
      echo -e "${RED}  ✗ Небезопасный системный конфиг оставлен без изменений: $sysctl_conf${NC}"
      unsafe_config=1
    else
      candidate=$(mktemp "$(dirname "$sysctl_conf")/.xrayebator-sysctl.XXXXXX") || return 1
      _strip_legacy_tcp_tuning_block "$sysctl_conf" "$candidate" || strip_rc=$?
      if [[ "$strip_rc" -eq 0 ]]; then
        if [[ -z "$backup_dir" ]]; then
          mkdir -p "$XRAY_BACKUPS_DIR" || { rm -f -- "$candidate"; return 1; }
          backup_dir=$(mktemp -d "$XRAY_BACKUPS_DIR/host-tuning-v3.XXXXXX") || {
            rm -f -- "$candidate"
            return 1
          }
          chmod 0700 "$backup_dir"
        fi
        cp -a -- "$sysctl_conf" "$backup_dir/sysctl.conf" || {
          rm -f -- "$candidate"
          return 1
        }
        chmod --reference="$sysctl_conf" "$candidate" \
          && chown --reference="$sysctl_conf" "$candidate" \
          && mv -fT -- "$candidate" "$sysctl_conf" || {
            rm -f -- "$candidate"
            return 1
          }
        echo -e "${GREEN}  ✓ Удалён legacy-блок Xrayebator из sysctl.conf${NC}"
      elif [[ "$strip_rc" -eq 1 ]]; then
        rm -f -- "$candidate"
      else
        rm -f -- "$candidate"
        unsafe_config=1
        echo -e "${RED}  ✗ Legacy sysctl-блок изменён вручную; файл оставлен без изменений${NC}"
      fi
    fi
  fi

  if [[ ! -r "$active_file" || ! -r "$available_file" ]]; then
    echo -e "${RED}  ✗ Ядро не предоставляет congestion-control state${NC}"
    return 1
  fi
  current_cc=$(<"$active_file")
  available_cc=$(<"$available_file")

  if [[ "$current_cc" == "bbr" ]]; then
    if [[ " $available_cc " == *" cubic "* ]]; then
      target_cc="cubic"
    elif [[ " $available_cc " == *" reno "* ]]; then
      target_cc="reno"
    else
      echo -e "${RED}  ✗ Не найден безопасный congestion-control fallback (cubic/reno)${NC}"
      return 1
    fi

    if ! sysctl -q -w "net.ipv4.tcp_congestion_control=$target_cc"; then
      echo -e "${RED}  ✗ Не удалось переключить congestion control на $target_cc${NC}"
      [[ -n "$backup_dir" ]] \
        && echo -e "${YELLOW}    Persistent-настройки удалены; backup: $backup_dir${NC}"
      return 1
    fi
    current_cc=$(<"$active_file")
    if [[ "$current_cc" == "bbr" ]]; then
      echo -e "${RED}  ✗ Congestion control остался BBR после переключения${NC}"
      return 1
    fi
    echo -e "${GREEN}  ✓ Активный congestion control: $current_cc${NC}"
  fi

  remaining_sources=$(_find_persistent_bbr_sources "$scan_paths")
  if [[ -n "$remaining_sources" ]]; then
    echo -e "${RED}  ✗ BBR задан сторонним sysctl-конфигом; файл не изменён:${NC}"
    printf '%s\n' "$remaining_sources" | sed 's/^/    /'
    echo -e "${YELLOW}    Удалите настройку вручную; migration повторится при следующем запуске.${NC}"
    return 1
  fi

  if [[ "$unsafe_config" -ne 0 ]]; then
    echo -e "${YELLOW}  ⚠ Часть persistent-конфигов требует ручной проверки; marker не установлен.${NC}"
    return 1
  fi

  mkdir -p "$(dirname "$marker")" || return 1
  if ! touch "$marker"; then
    echo -e "${RED}  ✗ Не удалось записать migration marker: $marker${NC}"
    return 1
  fi
  chown root:root "$marker" 2>/dev/null || true
  chmod 0640 "$marker" 2>/dev/null || true
  echo -e "${GREEN}  ✓ Legacy BBR/TCP tuning полностью отключён${NC}"
  return 0
}

# run_migration <marker_basename> <description> <fn_name>
# Centralized migration runner: backup → run fn → safe_restart → touch marker.
# Marker is created ONLY if all phases succeed (idempotency guarantee).
#
# Three-valued return contract for migration fns:
#   fn returns 0 = config changed → safe_restart_xray + touch marker
#   fn returns 1 = no-op (nothing to migrate) → touch marker WITHOUT restart
#   fn returns ≥2 = FAILED → do NOT touch marker (миграция повторится)
#
# Why three-valued: 5 of 6 existing fns return `return 1` для no-op case (нечего
# мигрировать на актуальной установке). Binary contract (0=ok, ≥1=fail) приводил
# бы к 5 RED false-positive ошибкам на каждом launch'е и маркеры никогда
# не выставлялись бы — миграции бесконечно перепроверялись.
#
# Args:
#   marker_basename — file inside /usr/local/etc/xray/, WITHOUT leading dot
#                     (e.g. "xhttp_migrated" → marker /usr/local/etc/xray/.xhttp_migrated)
#   description     — human-readable for logging (Russian, для пользователя)
#   fn_name         — bash function to call. Function MUST:
#                       - return 0 если config changed (рестарт нужен)
#                       - return 1 если no-op (нечего мигрировать, рестарт не нужен)
#                       - return ≥2 если миграция ФАЛЛЕНУЛА (НЕ touch marker)
#                     Function MUST NOT call backup_config or safe_restart_xray itself
#                     (helper делает это централизованно).
#
# Returns: 0=ok (marker set), 1=fn failed (≥2), 2=restart failed
run_migration() {
  local marker_basename="$1"
  local description="$2"
  local fn_name="$3"
  local rollback_config=""
  local profiles_snapshot=""

  local marker="/usr/local/etc/xray/.${marker_basename}"

  # Skip if already done (idempotent)
  if [[ -f "$marker" ]]; then
    return 0
  fi

  echo -e "${MAGENTA}[migration] ${description}${NC}"

  # Step 1: backup BEFORE any mutation (centralized per REQ-D07).
  if ! backup_config "$marker_basename" rollback_config; then
    echo -e "${RED}  ✗ Migration aborted: не удалось создать бэкап${NC}"
    return 1
  fi
  if ! _snapshot_profiles profiles_snapshot; then
    echo -e "${RED}  ✗ Migration aborted: не удалось создать снимок profile JSON${NC}"
    return 1
  fi

  # Step 2: run user-supplied migration fn
  "$fn_name"
  local fn_rc=$?

  case $fn_rc in
    0)
      # Changed config — needs restart
      if safe_restart_xray "$rollback_config"; then
        if ! touch "$marker"; then
          _discard_profiles_snapshot "$profiles_snapshot"
          echo -e "${RED}  ✗ Migration applied, но marker не записан: $marker${NC}"
          return 1
        fi
        chown root:root "$marker" 2>/dev/null || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${GREEN}  ✓ Migration applied: ${marker_basename}${NC}"
        return 0
      else
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}  ✗ safe_restart_xray failed для ${description}${NC}"
        echo -e "${YELLOW}    Маркер НЕ выставлен — config откачен (auto-rollback), миграция повторится${NC}"
        return 2
      fi
      ;;
    1)
      # No change — skip restart, but still mark as done (idempotent no-op for next runs).
      # Без этого touch'а fn re-проверял бы (зря) каждый launch.
      if ! touch "$marker"; then
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}  ✗ Не удалось записать migration marker: $marker${NC}"
        return 1
      fi
      chown root:root "$marker" 2>/dev/null || true
      _discard_profiles_snapshot "$profiles_snapshot"
      echo -e "${CYAN}  ✓ Nothing to migrate: ${marker_basename}${NC}"
      return 0
      ;;
    *)
      # fn вернула ≥2 — реальная ошибка (НЕ no-op).
      _restore_config_backup "$rollback_config" || true
      _restore_profiles_snapshot "$profiles_snapshot" || true
      _discard_profiles_snapshot "$profiles_snapshot"
      echo -e "${RED}  ✗ Migration fn '$fn_name' returned $fn_rc${NC}"
      echo -e "${YELLOW}    Config/profile JSON откачены; миграция повторится при следующем запуске${NC}"
      return 1
      ;;
  esac
}

# Remove the legacy server-side fingerprint field. Xray ignores this field for
# REALITY inbounds: the effective fingerprint lives only in profile/client URLs.
# Returns: 0=changed, 1=no-op, 2=write failure.
_remove_ignored_reality_server_fingerprints() {
  local config_file="${1:-$CONFIG_FILE}"
  [[ -f "$config_file" ]] || return 1

  if ! jq -e '
    any(.inbounds[]?; ((.streamSettings.realitySettings? // {}) | has("fingerprint")))
  ' "$config_file" >/dev/null 2>&1; then
    return 1
  fi

  if ! safe_jq_write '
    (.inbounds[]?
      | select((.streamSettings.realitySettings? // {}) | has("fingerprint"))
      | .streamSettings.realitySettings) |= del(.fingerprint)
  ' "$config_file"; then
    return 2
  fi

  return 0
}

# Upgrade old/default Chrome profile values to the current Firefox default.
# Explicit non-Chrome choices (Safari, Edge, random, etc.) are preserved.
# Returns: 0=changed, 1=no-op, 2=write failure.
_migrate_profile_fingerprints_to_firefox() {
  local changed=0
  local profile_file

  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ -f "$profile_file" ]] || continue
    if ! jq -e '
      ((.fingerprint // "chrome") == "chrome") or
      any((.routes // [])[]; ((.fingerprint // "chrome") == "chrome"))
    ' "$profile_file" >/dev/null 2>&1; then
      continue
    fi

    if ! safe_jq_write '
      if ((.routes // []) | length) > 0 then
        .routes |= map(
          if ((.fingerprint // "chrome") == "chrome")
          then .fingerprint = "firefox"
          else .
          end
        ) |
        .fingerprint = (.routes[0].fingerprint // "firefox")
      else
        if ((.fingerprint // "chrome") == "chrome")
        then .fingerprint = "firefox"
        else .
        end
      end
    ' "$profile_file"; then
      return 2
    fi
    changed=1
  done

  [[ "$changed" -eq 1 ]] && return 0
  return 1
}

# State-only migration: cleaning an ignored server field does not require an
# Xray restart and therefore must not use run_migration().
migrate_client_fingerprint_state_2026() {
  local marker="${1:-/usr/local/etc/xray/.client_fingerprint_state_2026}"
  [[ -f "$marker" ]] && return 0
  local changed=0
  local rollback_config=""
  local profiles_snapshot=""

  backup_config "client_fingerprint_state_2026" rollback_config || return 1
  _snapshot_profiles profiles_snapshot || return 1

  if jq -e '
    any(.inbounds[]?; ((.streamSettings.realitySettings? // {}) | has("fingerprint")))
  ' "$CONFIG_FILE" >/dev/null 2>&1; then
    if ! _remove_ignored_reality_server_fingerprints "$CONFIG_FILE"; then
      _restore_config_backup "$rollback_config" || true
      _restore_profiles_snapshot "$profiles_snapshot" || true
      _discard_profiles_snapshot "$profiles_snapshot"
      echo -e "${RED}  ✗ Не удалось удалить устаревший server-side fingerprint${NC}"
      return 1
    fi
    changed=1
  fi

  local profiles_rc=0
  _migrate_profile_fingerprints_to_firefox || profiles_rc=$?
  if [[ "$profiles_rc" -eq 0 ]]; then
    changed=1
  elif [[ "$profiles_rc" -ge 2 ]]; then
    _restore_config_backup "$rollback_config" || true
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}  ✗ Не удалось обновить profile fingerprints до Firefox${NC}"
    return 1
  fi

  if [[ "$changed" -eq 1 ]]; then
    echo -e "${GREEN}  ✓ Fingerprint переведён в client-only режим с default Firefox${NC}"
  fi

  if ! touch "$marker"; then
    _restore_config_backup "$rollback_config" || true
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}  ✗ Не удалось записать migration marker: $marker${NC}"
    return 1
  fi
  chown root:root "$marker" 2>/dev/null || true
  _discard_profiles_snapshot "$profiles_snapshot"
  return 0
}

migrate_transport_profile_metadata() {
  local migrated=0
  local profile_file

  echo -e "${CYAN}Проверка transport metadata профилей...${NC}"
  # backup_config удалён: централизован в run_migration (Phase 4 refactor, REQ-D07)

  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ ! -f "$profile_file" ]] && continue

    local transport
    transport=$(jq -r '.transport // ""' "$profile_file" 2>/dev/null)

    case "$transport" in
      grpc)
        if [[ "$(jq -r 'has("grpc_service_name")' "$profile_file" 2>/dev/null)" != "true" ]]; then
          echo -e "${YELLOW}  → Backfill grpc_service_name: $(basename "$profile_file" .json)${NC}"
          if safe_jq_write '.grpc_service_name = "grpc"' "$profile_file"; then
            ((migrated++))
          fi
        fi
        ;;
      xhttp)
        if [[ "$(jq -r 'has("xhttp_path")' "$profile_file" 2>/dev/null)" != "true" ]]; then
          echo -e "${YELLOW}  → Backfill xhttp_path: $(basename "$profile_file" .json)${NC}"
          if safe_jq_write '.xhttp_path = "/xhttp"' "$profile_file"; then
            ((migrated++))
          fi
        fi
        ;;
    esac
  done

  fix_xray_permissions

  # EXPLICIT return: 0=changed (restart нужен), 1=no-op (нечего мигрировать)
  # Раньше всегда return 0 — принудительный restart даже когда migrated==0
  if [[ $migrated -gt 0 ]]; then
    echo -e "${GREEN}✓ Transport metadata backfill: $migrated профилей${NC}"
    return 0
  else
    echo -e "${GREEN}✓ Transport metadata backfill не требуется${NC}"
    return 1
  fi
}

_migrate_xhttp_route_path_repair_2026() {
  local profile_files=("$PROFILES_DIR"/*.json)
  [[ -f "${profile_files[0]}" ]] || return 1

  local repairs
  if ! repairs=$(jq -s '
    [
      .[] as $profile |
      if (($profile.routes // []) | length) > 0 then
        $profile.routes[] |
        select(
          .transport == "xhttp" and
          (.port | type == "number") and
          ((.xhttp_path // "") | startswith("/"))
        ) |
        {port: .port, path: .xhttp_path, uuid: $profile.uuid}
      else
        $profile |
        select(
          .transport == "xhttp" and
          (.port | type == "number") and
          ((.xhttp_path // "") | startswith("/"))
        ) |
        {port: .port, path: .xhttp_path, uuid: .uuid}
      end
    ] |
    sort_by(.port) |
    group_by(.port) |
    map(
      select((map(.path) | unique | length) == 1) |
      {
        port: .[0].port,
        path: .[0].path,
        uuids: (map(.uuid) | map(select(type == "string" and length > 0)) | unique)
      }
    )
  ' "${profile_files[@]}" 2>/dev/null); then
    echo -e "${RED}  ✗ Не удалось собрать XHTTP path из profile JSON${NC}"
    return 2
  fi

  local repair_count
  if ! repair_count=$(jq -r --argjson repairs "$repairs" '
    [
      $repairs[] as $repair |
      .inbounds[]? |
      select(
        .port == $repair.port and
        .protocol == "vless" and
        .streamSettings.network == "xhttp" and
        ((.streamSettings.xhttpSettings.path // "") == "") and
        any(
          .settings.clients[]?;
          .id as $client_id |
          ($repair.uuids | index($client_id)) != null
        )
      )
    ] |
    length
  ' "$CONFIG_FILE" 2>/dev/null); then
    echo -e "${RED}  ✗ Не удалось проверить XHTTP inbound metadata${NC}"
    return 2
  fi

  if [[ "$repair_count" -eq 0 ]]; then
    return 1
  fi

  if ! safe_jq_write --argjson repairs "$repairs" '
    reduce $repairs[] as $repair (.;
      (
        .inbounds[] |
        select(
          .port == $repair.port and
          .protocol == "vless" and
