# P2-fix: пути nginx-сайтов переопределяемы для тестов реальной последовательности
# (quickstart rollback). В проде — системные каталоги; в функциональном тесте —
# временная ФС. Совпадает с существующим паттерном CONFIG_FILE/PROFILES_DIR override.
NGINX_SITES_AVAILABLE="${NGINX_SITES_AVAILABLE:-/etc/nginx/sites-available}"
NGINX_SITES_ENABLED="${NGINX_SITES_ENABLED:-/etc/nginx/sites-enabled}"
# P2-fix: транзакция quickstart-nginx вынесена на уровень файла (не local внутри
# quickstart_command), чтобы её можно было реально исполнить в функциональном тесте и
# она была единым источником истины для rollback. Состояние не персистентно — только
# для текущего процесса quickstart.
QS_NGINX_MODIFIED=0
QS_VHOST_BACKUP="$NGINX_SITES_AVAILABLE/xrayebator-sub.xrayebator.bak"
# Восстанавливает исходное состояние nginx после ANY мутации quickstart: прежний vhost
# xrayebator-sub (если был), default-сайт (если удаляли), убирает наш vhost и перегружает
# nginx. Обёрнуто в backreference: работает и при отсутствии default-сайта.
_qs_nginx_rollback() {
  if [[ "$QS_NGINX_MODIFIED" != "true" ]]; then
    return 0
  fi
  rm -f "$NGINX_SITES_ENABLED/xrayebator-sub" "$NGINX_SITES_AVAILABLE/xrayebator-sub"
  if [[ -e "$QS_VHOST_BACKUP" ]]; then
    cp -a "$QS_VHOST_BACKUP" "$NGINX_SITES_AVAILABLE/xrayebator-sub"
    ln -sf "$NGINX_SITES_AVAILABLE/xrayebator-sub" "$NGINX_SITES_ENABLED/xrayebator-sub"
    rm -f "$QS_VHOST_BACKUP"
  fi
  if [[ -e "$NGINX_SITES_ENABLED/default.xrayebator.bak" && ! -e "$NGINX_SITES_ENABLED/default" ]]; then
    cp -a "$NGINX_SITES_ENABLED/default.xrayebator.bak" "$NGINX_SITES_ENABLED/default"
  fi
  rm -f "$NGINX_SITES_ENABLED/default.xrayebator.bak"
  if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
    systemctl reload nginx >/dev/null 2>&1 || true
  fi
  return 0
}
# A11-fix: порты, выбранные в рамках одного процесса (например, 7 маршрутов
