        fi
        sleep 2
        ;;
      0) return ;;
      *) echo -e "${RED}Неверный выбор${NC}"; sleep 1 ;;
    esac
  done
}

# Миграция subhttp_hysteria2_2026 (мультибэкенд, срез 3): hysteria2-ссылка
# в обоих телах подписки. Регенерирует handler существующим repair-путём.
# На серверах без подписки — no-op: handler сгенерируется с hysteria2-кодом
# при будущей установке подписки (код уже в install_subscription_server).
_migrate_subhttp_hysteria2_2026() {
  [[ -f /usr/local/etc/xray/.subhttp_hysteria2_2026 ]] && return 1
  if [[ -f /usr/local/etc/xray/.subscription_installed ]]; then
    if ! _subscription_repair_handler; then
      echo -e "${RED}✗ Не удалось регенерировать subhttp.sh (hysteria2)${NC}"
      return 2
    fi
  fi
  return 0
}

