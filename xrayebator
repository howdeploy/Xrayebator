# Безопасная запись через jq — проверяет результат перед перезаписью
# Использование: safe_jq_write "выражение_jq" [аргументы_jq...] "$входной_файл" "$выходной_файл"
# Или для записи в тот же файл: safe_jq_write "выражение_jq" [аргументы_jq...] "$файл"
# Последний аргумент — целевой файл (куда записать), предпоследний — исходный
# Если целевой == исходный, делает mktemp+mv
safe_jq_write() {
  local args=("$@")
  local nargs=${#args[@]}

  # Минимум 2 аргумента: выражение и файл
  if [[ $nargs -lt 2 ]]; then
    echo -e "${RED}  ✗ safe_jq_write: недостаточно аргументов${NC}" >&2
    return 1
  fi

  _lock_acquire

  # Последний аргумент — исходный файл (и он же целевой при in-place)
  local src_file="${args[$((nargs-1))]}"
  local dst_file="$src_file"
  local jq_args=("${args[@]:0:$((nargs-1))}")

  # Сохраняем исходные права и владельца
  local orig_mode orig_owner
  orig_mode=$(stat -c %a "$src_file" 2>/dev/null || echo "644")
  orig_owner=$(stat -c %U:%G "$src_file" 2>/dev/null || echo "root:root")

  local tmp=$(mktemp)
  local result=1
  if jq "${jq_args[@]}" "$src_file" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
    mv "$tmp" "$dst_file"
    chmod "$orig_mode" "$dst_file" 2>/dev/null
    chown "$orig_owner" "$dst_file" 2>/dev/null
    result=0
  else
    echo -e "${RED}  ✗ Ошибка jq — файл НЕ изменён: $dst_file${NC}" >&2
    rm -f "$tmp"
  fi

  _lock_release
  return $result
}

# Создание бэкапа config.json перед мутацией.
# Args: $1=operation_name, $2=optional caller variable receiving the exact path.
backup_config() {
  local operation_name=${1:-"manual"}
  local result_var=${2:-}
  local backup_dir="$XRAY_BACKUPS_DIR"
  local safe_operation_name

  if [[ -n "$result_var" && ! "$result_var" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
    echo -e "${RED}  ✗ Некорректное имя переменной результата backup_config${NC}"
    return 1
  fi
  [[ -n "$result_var" ]] && printf -v "$result_var" '%s' ""

  safe_operation_name=$(printf '%s' "$operation_name" | tr -c 'a-zA-Z0-9_.-' '_')
  _lock_acquire
  mkdir -p "$backup_dir"
  chmod 700 "$backup_dir" 2>/dev/null
  chown root:root "$backup_dir" 2>/dev/null
  local backup_file="$backup_dir/config_$(date +%Y%m%d_%H%M%S_%N)_${safe_operation_name}.json"
  local result=1
  if ! cp "$CONFIG_FILE" "$backup_file"; then
    echo -e "${RED}  ✗ Не удалось создать бэкап config.json: $backup_file${NC}"
  else
    chmod 600 "$backup_file" 2>/dev/null
    chown root:root "$backup_file" 2>/dev/null
    [[ -n "$result_var" ]] && printf -v "$result_var" '%s' "$backup_file"
    echo -e "${CYAN}  -> Бэкап конфига: $(basename "$backup_file")${NC}"
    result=0
  fi
  _lock_release
  return $result
}

_restore_config_backup() {
  local backup_file=${1:-}

  if [[ -z "$backup_file" || ! -f "$backup_file" || ! -s "$backup_file" ]]; then
    echo -e "${RED}  ✗ Точный бэкап для отката отсутствует: ${backup_file:-не задан}${NC}"
    return 1
  fi
  if ! cp "$backup_file" "$CONFIG_FILE"; then
    echo -e "${RED}  ✗ Не удалось восстановить config.json из $(basename "$backup_file")${NC}"
    return 1
  fi
  # P2-rollback-fix: live config обязан быть читаем сервисом (User=xray). root:root 0600
  # после rollback делал конфиг недоступным — xray не стартовал. Backup остаётся 600
  # root:root (backup_config), live — root:xray 0640 (группа читает, пишет только root).
  chown root:xray "$CONFIG_FILE" 2>/dev/null || true
  chmod 640 "$CONFIG_FILE" 2>/dev/null || true
  echo -e "${GREEN}  ✓ Конфиг восстановлен из: $(basename "$backup_file")${NC}"
  return 0
}

_snapshot_profiles() {
  local result_var=${1:-}
  local snapshot_dir

  if [[ ! "$result_var" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
    echo -e "${RED}  ✗ Некорректное имя переменной результата _snapshot_profiles${NC}"
    return 1
  fi
  printf -v "$result_var" '%s' ""

  snapshot_dir=$(mktemp -d /tmp/xrayebator-profiles.XXXXXX) || return 1
  if [[ -d "$PROFILES_DIR" ]] && ! cp -a "$PROFILES_DIR/." "$snapshot_dir/"; then
    rm -rf -- "$snapshot_dir"
    echo -e "${RED}  ✗ Не удалось создать снимок profile JSON${NC}"
    return 1
  fi
  printf -v "$result_var" '%s' "$snapshot_dir"
  return 0
}

_restore_profiles_snapshot() {
  local snapshot_dir=${1:-}

  if [[ "$snapshot_dir" != /tmp/xrayebator-profiles.* || ! -d "$snapshot_dir" ]]; then
    echo -e "${RED}  ✗ Некорректный снимок profile JSON: ${snapshot_dir:-не задан}${NC}"
    return 1
  fi
  mkdir -p "$PROFILES_DIR"
  if ! cp -a "$snapshot_dir/." "$PROFILES_DIR/"; then
    echo -e "${RED}  ✗ Не удалось восстановить profile JSON${NC}"
    return 1
  fi
  echo -e "${GREEN}  ✓ Profile JSON восстановлены${NC}"
  return 0
}

_discard_profiles_snapshot() {
  local snapshot_dir=${1:-}
  if [[ "$snapshot_dir" == /tmp/xrayebator-profiles.* && -d "$snapshot_dir" ]]; then
    rm -rf -- "$snapshot_dir"
  fi
}

ensure_xray_runtime_user() {
  if getent passwd xray >/dev/null 2>&1; then
    return 0
  fi

  local nologin="/usr/sbin/nologin"
  [[ -x "$nologin" ]] || nologin="/sbin/nologin"
  [[ -x "$nologin" ]] || nologin="/bin/false"

  echo -e "${YELLOW}  ⚠ Пользователь xray отсутствует — создаю runtime user${NC}"
  if ! getent group xray >/dev/null 2>&1; then
    groupadd -r xray 2>/dev/null || true
  fi

  if getent group xray >/dev/null 2>&1; then
    useradd -r -g xray -s "$nologin" -M -d /nonexistent xray
  else
    useradd -r -s "$nologin" -M -d /nonexistent xray
  fi

  if ! getent passwd xray >/dev/null 2>&1; then
    echo -e "${RED}  ✗ Не удалось создать пользователя xray${NC}"
    return 1
  fi

  echo -e "${GREEN}  ✓ Пользователь xray создан${NC}"
  return 0
}

# Восстановление прав (privilege boundary, P0-fix).
# Конфигурационные каталоги, state markers и root-исполняемые скрипты принадлежат
# root:root. Сервис xray получает ТОЛЬКО чтение (644/755): config.json, профили,
# keys (public/encryption — нужны subhttp для генерации URL), announce/happ_defaults.
# Запись в /usr/local/etc/xray разрешена только root (управление через sudo).
# Приватные ключи (.private_key, .vless_decryption) — 600 root:root.
# НЕ выполнять chown -R xray:xray: владелец каталога может подменить root-скрипты
# (update.sh/uninstall.sh) и .install_step_* markers → privilege escalation.
fix_xray_permissions() {
  ensure_xray_runtime_user >/dev/null 2>&1 || true
  local base="/usr/local/etc/xray"
  # 1. Корень и каталоги — root:root 755 (xray читает, но не пишет).
  chown root:root "$base" 2>/dev/null || true
  chmod 755 "$base" 2>/dev/null || true
  find "$base" -maxdepth 1 -type d -exec chown root:root {} + 2>/dev/null || true
  find "$base" -maxdepth 1 -type d -exec chmod 755 {} + 2>/dev/null || true
  find "$base"/profiles "$base"/backups "$base"/data "$base"/scripts "$base"/upstreams -maxdepth 1 -type d -exec chmod 755 {} + 2>/dev/null || true
  # 2. Приватные ключи — 600 root:root.
  chown root:root "$base/.private_key" "$base/.vless_decryption" 2>/dev/null || true
  chmod 600 "$base/.private_key" "$base/.vless_decryption" 2>/dev/null || true
  # 3. Публичные ключи — 644 root:root (читаются xray/subhttp для VLESS URL).
  chown root:root "$base/.public_key" "$base/.vless_encryption" 2>/dev/null || true
  chmod 644 "$base/.public_key" "$base/.vless_encryption" 2>/dev/null || true
  # 4. Конфигурация и файлы, которые xray должен ЧИТАТЬ: 644 root:root.
  chown root:root "$base/config.json" 2>/dev/null || true
  chmod 644 "$base/config.json" 2>/dev/null || true
  chown root:root "$base"/profiles/*.json 2>/dev/null || true
  chmod 644 "$base"/profiles/*.json 2>/dev/null || true
  chown root:root "$base"/.subscription_port "$base"/.subscription_domain "$base"/.subscription_server_addr "$base"/.subscription_mode "$base"/.happ_defaults.env "$base"/.subscription_installed "$base"/.happ_routing.json "$base"/announce.txt "$base"/.current_branch "$base"/.config_optimized "$base"/.certbot_owned 2>/dev/null || true
  chmod 644 "$base"/.subscription_port "$base"/.subscription_domain "$base"/.subscription_server_addr "$base"/.subscription_mode "$base"/.happ_defaults.env "$base"/.subscription_installed "$base"/.happ_routing.json "$base"/announce.txt "$base"/.current_branch "$base"/.config_optimized "$base"/.certbot_owned 2>/dev/null || true
  # 5. Прочие state markers — root:root 644 (включая .install_step_*_ok и миграционные).
  find "$base" -maxdepth 1 -type f -name '.*' ! -name '.private_key' ! -name '.vless_decryption' ! -name '.public_key' ! -name '.vless_encryption' \
    -exec chown root:root {} + 2>/dev/null || true
  find "$base" -maxdepth 1 -type f -name '.*' ! -name '.private_key' ! -name '.vless_decryption' ! -name '.public_key' ! -name '.vless_encryption' \
    -exec chmod 644 {} + 2>/dev/null || true
  # 6. Root-исполняемые скрипты: root:root 755 (не подменяемы xray).
  chown root:root "$base"/scripts/*.sh /usr/local/bin/xrayebator /usr/local/bin/subhttp.sh /usr/local/bin/xrayebator-update /usr/local/bin/xrayebator-uninstall 2>/dev/null || true
  chmod 755 "$base"/scripts/*.sh /usr/local/bin/xrayebator /usr/local/bin/subhttp.sh /usr/local/bin/xrayebator-update /usr/local/bin/xrayebator-uninstall 2>/dev/null || true
  # 7. Лог-каталог xray — xray:xray (сервис пишет журнал туда).
  # /var/log/xray — единственное место, где xray пишет; остальное root:root (P0-fix).
  chown xray:xray /var/log/xray 2>/dev/null || true
}

ensure_xray_service_unit() {
  if ! ensure_xray_runtime_user; then
    return 1
  fi

  if systemctl cat xray.service >/dev/null 2>&1; then
    return 0
  fi

  echo -e "${YELLOW}  ⚠ systemd unit xray.service не найден — создаю базовый unit${NC}"
  cat > /etc/systemd/system/xray.service <<'SVCEOF'
[Unit]
Description=Xray Service
Documentation=https://github.com/XTLS/Xray-core
After=network.target nss-lookup.target
Wants=network-online.target

[Service]
User=xray
Group=xray
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/local/bin/xray run -config /usr/local/etc/xray/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
SVCEOF
  chmod 644 /etc/systemd/system/xray.service
  systemctl daemon-reload
  systemctl enable xray >/dev/null 2>&1 || true

  if systemctl cat xray.service >/dev/null 2>&1; then
    echo -e "${GREEN}  ✓ xray.service создан${NC}"
    return 0
  fi

  echo -e "${RED}  ✗ Не удалось создать xray.service${NC}"
  return 1
}

# Безопасный перезапуск Xray с валидацией конфига.
# Args: $1=exact backup path for this operation (required for rollback).
# Returns: 0=success, 1=failure (validation/restart failed; rollback attempted)
safe_restart_xray() {
  local rollback_backup=${1:-}

  if [[ ! -x "$XRAY_BIN" ]]; then
    echo -e "${RED}  ✗ Бинарник $XRAY_BIN не найден${NC}"
    [[ -n "$rollback_backup" ]] && _restore_config_backup "$rollback_backup"
    return 1
  fi

  if [[ ! -f "$CONFIG_FILE" || ! -s "$CONFIG_FILE" ]]; then
    echo -e "${RED}  ✗ config.json отсутствует или пустой — Xray НЕ перезапущен${NC}"
    if [[ -n "$rollback_backup" ]]; then
      echo -e "${YELLOW}  -> Восстанавливаю конфиг из бэкапа...${NC}"
      _restore_config_backup "$rollback_backup"
    fi
    return 1
  fi

  local test_output
  test_output=$("$XRAY_BIN" run -test -format json -config "$CONFIG_FILE" 2>&1)

  if ! grep -q "Configuration OK" <<< "$test_output"; then
    echo -e "${RED}  ✗ Конфиг не прошёл валидацию -- Xray НЕ перезапущен${NC}"
    echo -e "${YELLOW}  Ошибка: ${test_output}${NC}"

    if [[ -n "$rollback_backup" ]]; then
      echo -e "${YELLOW}  -> Восстанавливаю конфиг из бэкапа...${NC}"
      _restore_config_backup "$rollback_backup"
    fi
    return 1
  fi

  if ! ensure_xray_service_unit; then
    [[ -n "$rollback_backup" ]] && _restore_config_backup "$rollback_backup"
    return 1
  fi

  systemctl restart xray
  sleep 1

  if systemctl is-active --quiet xray; then
    echo -e "${GREEN}  ✓ Xray перезапущен${NC}"
    return 0
  else
    echo -e "${RED}  ✗ Xray не запустился после перезапуска${NC}"
    if [[ -n "$rollback_backup" ]]; then
      echo -e "${YELLOW}  -> Откатываю config.json и пробую вернуть старую конфигурацию...${NC}"
      if _restore_config_backup "$rollback_backup"; then
        systemctl restart xray
        sleep 1
      fi
      if systemctl is-active --quiet xray; then
        echo -e "${GREEN}  ✓ Xray восстановлен на предыдущем конфиге${NC}"
      else
        echo -e "${RED}  ✗ Откат конфига не поднял Xray — требуется ручная проверка${NC}"
      fi
    fi
    return 1
  fi
}

_ufw_rule_exists() {
  local port="$1" protocol="${2:-tcp}"
  ufw status 2>/dev/null |
    awk -v rule="${port}/${protocol}" '$1 == rule && ($2 == "ALLOW" || $2 == "LIMIT") { found=1 } END { exit !found }' &&
    return 0
  ufw show added 2>/dev/null |
    grep -qE "^ufw (allow|limit) ${port}/${protocol}([[:space:]]|$)"
}

# Реестр UFW-правил, созданных Xrayebator. Формат новых записей:
# port/proto/action; старый port/proto читается как allow.
_ufw_register_port() {
  local port="$1" protocol="${2:-tcp}" action="${3:-allow}"
  [[ "$port" =~ ^[0-9]{1,5}$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) || return 1
  [[ "$protocol" == "tcp" || "$protocol" == "udp" ]] || return 1
  [[ "$action" == "allow" || "$action" == "limit" ]] || return 1
  local manifest="${UFW_OWNED_MANIFEST:-/usr/local/etc/xray/.ufw_owned}"
  local entry="${port}/${protocol}/${action}"
  mkdir -p "$(dirname "$manifest")" 2>/dev/null || return 1
  if [[ ! -f "$manifest" ]]; then
    printf '%s\n' "$entry" > "$manifest" || return 1
  else
    grep -qxF "$entry" "$manifest" 2>/dev/null ||
      printf '%s\n' "$entry" >> "$manifest" || return 1
  fi
  chmod 644 "$manifest" 2>/dev/null || return 1
  if [[ $EUID -eq 0 ]]; then
    chown root:root "$manifest" 2>/dev/null || return 1
  fi
}

_ufw_manifest_has_port() {
  local port="$1" protocol="${2:-tcp}"
  local manifest="${UFW_OWNED_MANIFEST:-/usr/local/etc/xray/.ufw_owned}"
  [[ -f "$manifest" ]] || return 1
  awk -F/ -v port="$port" -v protocol="$protocol" '
    $1 == port && $2 == protocol && (NF == 2 || (NF == 3 && ($3 == "allow" || $3 == "limit"))) { found=1 }
    END { exit !found }
  ' "$manifest"
}

_ufw_remove_owned_port() {
  local port="$1" protocol="${2:-tcp}" action extra entry_port entry_protocol
  local manifest="${UFW_OWNED_MANIFEST:-/usr/local/etc/xray/.ufw_owned}"
  _ufw_manifest_has_port "$port" "$protocol" || return 0
  command -v ufw >/dev/null 2>&1 || return 1

  while IFS=/ read -r entry_port entry_protocol action extra; do
    [[ -z "$extra" && "$entry_port" == "$port" && "$entry_protocol" == "$protocol" ]] || continue
    action="${action:-allow}"
    [[ "$action" == "allow" || "$action" == "limit" ]] || return 1
    ufw delete "$action" "${port}/${protocol}" >/dev/null 2>&1 || return 1
  done < "$manifest"

  local manifest_tmp
  manifest_tmp=$(mktemp "${manifest}.tmp.XXXXXX") || return 1
  if ! awk -F/ -v port="$port" -v protocol="$protocol" \
      '!($1 == port && $2 == protocol)' "$manifest" > "$manifest_tmp" ||
     ! chmod 644 "$manifest_tmp"; then
    rm -f -- "$manifest_tmp"
    return 1
  fi
  if [[ $EUID -eq 0 ]] && ! chown root:root "$manifest_tmp"; then
    rm -f -- "$manifest_tmp"
    return 1
  fi
  if ! mv -f -- "$manifest_tmp" "$manifest"; then
    rm -f -- "$manifest_tmp"
    return 1
  fi
  # Без ufw reload: `ufw allow` уже применил правило к живому iptables.
  # reload стоит ~2.3с и на время пересборки цепочек дёргает соединения.
}

_add_owned_firewall_rule() {
  local port="$1" protocol="${2:-tcp}" action="${3:-allow}"
  [[ "$port" =~ ^[0-9]{1,5}$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) || return 1
  [[ "$protocol" == "tcp" || "$protocol" == "udp" ]] || return 1
  [[ "$action" == "allow" || "$action" == "limit" ]] || return 1
  command -v ufw >/dev/null 2>&1 || return 1
  ufw status 2>/dev/null | grep -q "Status: active" || return 1

  # Существующее правило принадлежит другому владельцу: считаем порт доступным,
  # но никогда не записываем его в наш manifest.
  _ufw_rule_exists "$port" "$protocol" && return 0
  if ! ufw "$action" "${port}/${protocol}" >/dev/null 2>&1; then
    return 1
  fi
  if ! _ufw_register_port "$port" "$protocol" "$action"; then
    ufw delete "$action" "${port}/${protocol}" >/dev/null 2>&1 || true
    return 1
  fi
  # Без ufw reload — см. комментарий в _apply_ufw_manifest: allow/delete
  # применяется к живому iptables сразу, reload только тормозит и рвёт сессии.
}

# Open port in UFW firewall (idempotent and ownership-safe).
open_firewall_port() {
  local port="$1" protocol="${2:-tcp}"
  if _ufw_rule_exists "$port" "$protocol" 2>/dev/null; then
    echo -e "${CYAN}  → Порт ${port}/${protocol} уже открыт; ownership не присваивается${NC}"
    return 0
  fi
  echo -e "${CYAN}  → Открываю порт ${port}/${protocol}...${NC}"
  if _add_owned_firewall_rule "$port" "$protocol" allow; then
    echo -e "${GREEN}  ✓ Порт ${port}/${protocol} открыт${NC}"
    return 0
  fi
  echo -e "${RED}  ✗ Ошибка открытия порта ${port}/${protocol}${NC}" >&2
  return 1
}

limit_firewall_port() {
  _add_owned_firewall_rule "$1" "${2:-tcp}" limit
}

# Close port in UFW if not used by other profiles
# Args: $1=port, $2=protocol (default: tcp)
close_firewall_port() {
  local port=$1
  local protocol=${2:-tcp}

  # Check if port is still used by any inbound. On a jq/config error, keep the
  # firewall rule: accidentally leaving a port open is safer than cutting off a
  # live inbound because a damaged config looked empty.
  local port_in_use
  if ! port_in_use=$(jq -r --argjson port "$port" \
    '.inbounds[] | select(.port == $port) | .tag' \
    "$CONFIG_FILE" 2>/dev/null); then
    return 0
  fi

  if [[ -n "$port_in_use" ]]; then
    return 0  # Still in use, don't close
  fi

  # Never close default ports
  local default_ports=(22 80 443 8443 2053 2083 2087 8080 2096 8880 9443)
  for dp in "${default_ports[@]}"; do
    [[ "$port" == "$dp" ]] && return 0
  done

  # Закрываем только exact rule из ownership manifest. Pre-existing rule на том
  # же порту не трогаем даже после удаления последнего Xray inbound.
  if _ufw_manifest_has_port "$port" "$protocol"; then
    echo -e "${CYAN}  → Закрываю порт ${port}/${protocol}...${NC}"
    if _ufw_remove_owned_port "$port" "$protocol"; then
      echo -e "${GREEN}  ✓ Порт закрыт${NC}"
    else
      echo -e "${YELLOW}  ⚠ Не удалось закрыть owned rule ${port}/${protocol}${NC}" >&2
      return 1
    fi
  fi

  return 0
}

# ═══════════════════════════════════════════════════════════
# MULTI-PROTOCOL BACKEND REGISTRY (этап 1)
# ═══════════════════════════════════════════════════════════
# Нейтральный слой для не-Xray бэкендов (Hysteria 2, AmneziaWG 2.0).
# Дизайн: .superpowers/sdd/2026-10-04-multi-protocol-backends-design.md
# Клиентские креденшелы бэкендов живут в профилях (.backends) — профиль
# единственный источник правды; серверные конфиги бэкендов регенерируются
# из профилей. Реестр — плоский JSON: {"<type>": {"installed": bool, ...}}.
# Права: корень 755, реестр 644 root — БЕЗ секретов, его читает subhttp
# (пользователь xray); секреты живут глубже, в 750-каталогах бэкендов.

# Готовит корень/каталог бэкендов и пустой реестр. Идемпотентен.
_backend_ensure_registry() {
  if [[ ! -d "$BACKENDS_ROOT" ]]; then
    mkdir -p "$BACKENDS_ROOT" || return 1
    chmod 755 "$BACKENDS_ROOT" 2>/dev/null
  fi
  if [[ ! -d "$BACKENDS_DIR" ]]; then
    mkdir -p "$BACKENDS_DIR" || return 1
    chmod 755 "$BACKENDS_DIR" 2>/dev/null
  fi
  if [[ ! -s "$BACKENDS_REGISTRY_FILE" ]]; then
    if ! jq -n '{}' > "${BACKENDS_REGISTRY_FILE}.tmp.$$" 2>/dev/null; then
      rm -f "${BACKENDS_REGISTRY_FILE}.tmp.$$"
      return 1
    fi
    if [[ ! -s "${BACKENDS_REGISTRY_FILE}.tmp.$$" ]]; then
      rm -f "${BACKENDS_REGISTRY_FILE}.tmp.$$"
      return 1
    fi
    mv "${BACKENDS_REGISTRY_FILE}.tmp.$$" "$BACKENDS_REGISTRY_FILE" || return 1
    chmod 644 "$BACKENDS_REGISTRY_FILE" 2>/dev/null
  fi
  return 0
}

# Установлен ли бэкенд (по реестру). Аргументы: $1 = тип бэкенда.
_backend_installed() {
  local type=$1
  [[ -s "$BACKENDS_REGISTRY_FILE" ]] || return 1
  jq -e --arg t "$type" '.[$t].installed == true' "$BACKENDS_REGISTRY_FILE" >/dev/null 2>&1
}

# Значение поля реестра бэкенда (пусто, если поля/бэкенда нет).
# ВАЖНО: не jq `// empty` — он проглатывает легитимный boolean false
# (three_enabled/disable_cookies/sub_body), что ломает чтение флагов.
_backend_field() {
  local type=$1 field=$2
  [[ -s "$BACKENDS_REGISTRY_FILE" ]] || { echo ""; return 0; }
  jq -r --arg t "$type" --arg f "$field" \
    '(.[$t][$f]) | if . == null then "" else tostring end' \
    "$BACKENDS_REGISTRY_FILE" 2>/dev/null
}

# Мутация реестра через safe_jq_write (валидация + tmp+mv, in-place).
# Usage: _backend_set hysteria2 '(.hysteria2.port) = $port' --argjson port 443
# Контракт safe_jq_write: jq-опции ДО фильтра, файл — последний аргумент.
_backend_set() {
  local type=$1 expr=$2
  shift 2
  _backend_ensure_registry || return 1
  # Гарантируем существование объекта бэкенда (if-форма: совместимость со старым jq).
  safe_jq_write --arg t "$type" \
    'if .[$t] == null then .[$t] = {} else . end' \
    "$BACKENDS_REGISTRY_FILE" || return 1
  if [[ $# -gt 0 ]]; then
    safe_jq_write "$@" "$expr" "$BACKENDS_REGISTRY_FILE"
  else
    safe_jq_write "$expr" "$BACKENDS_REGISTRY_FILE"
  fi
}

# Занят ли UDP-порт системными слушателями. Порты других бэкендов НЕ
# вычитаются здесь — их вызывающий сверяет по реестру.
_backend_port_busy_udp() {
  local port=$1
  ss -uln 2>/dev/null | grep -qE "[:.]${port}[[:space:]]"
}

# active|inactive для systemd-юнита бэкенда; unknown — если юнит не задан.
_backend_unit_state() {
  local unit=$1
  [[ -n "$unit" ]] || { echo "unknown"; return 0; }
  if systemctl is-active --quiet "$unit" 2>/dev/null; then
    echo "active"
  else
    echo "inactive"
  fi
}

# Машиночитаемый статус реестра бэкендов. ТОЛЬКО JSON на stdout
# (JSON-гигиена CLI как у profile-*).
_backend_status_json() {
  if ! _backend_ensure_registry; then
    echo '{"ok":false,"error":"registry_init_failed","backends":{}}'
    return 1
  fi
  local out="{}"
  local prev="$out"
  local type installed unit state entry
  for type in hysteria2 awg; do
    prev="$out"
    if _backend_installed "$type"; then installed="true"; else installed="false"; fi
    unit=$(_backend_field "$type" "unit")
    state=$(_backend_unit_state "$unit")
    # Прокидываем ВСЮ запись реестра (version/tls_mode/...) — статус не должен
    # терять поля, добавленные будущими срезами; state ставится живой проверкой.
    entry=$(jq -c --arg t "$type" '.[$t] // {}' "$BACKENDS_REGISTRY_FILE" 2>/dev/null)
    [[ -n "$entry" ]] || entry="{}"
    out=$(jq -n \
      --argjson base "$prev" \
      --arg t "$type" \
      --argjson entry "$entry" \
      --argjson installed "$installed" \
      --arg state "$state" \
      '$base + {($t): ($entry + {installed: $installed, state: $state})}' 2>/dev/null)
    [[ -n "$out" ]] || out="$prev"
  done
  echo "{\"ok\":true,\"backends\":$out}"
}

# Единая точка жизненного цикла профиля для всех бэкендов.
# Вызывается ПОСЛЕ успешной Xray-части операции (create/delete/revoke/expire).
# Идемпотентна; для неустановленных бэкендов — no-op. События:
#   created | deleted | revoked | expired | restored
# Обработчики добавляются срезами бэкендов: _hysteria2_on_profile_event и т.п.
_backend_apply_profile_lifecycle() {
  local name=$1 event=$2
  local type handler
  for type in hysteria2 awg; do
    _backend_installed "$type" || continue
    handler="_${type}_on_profile_event"
    declare -F "$handler" >/dev/null 2>&1 || continue
    "$handler" "$name" "$event" || \
      echo -e "${YELLOW}  ⚠ backend ${type}: событие ${event} для профиля ${name} обработано с ошибкой${NC}" >&2
  done
  return 0
}
# ═══════════════════════════════════════════════════════════
# END MULTI-PROTOCOL BACKEND REGISTRY
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# BACKEND: HYSTERIA 2 (быстрый UDP) — срез 2
# ═══════════════════════════════════════════════════════════
# Поставка: GitHub releases HyNetworks/hysteria (тег вида app/v2.12.3),
# sha256 из поля digest API-ответа (плюс asset hashes.txt).
# Юнит свой (не get.hy2.sh): пользователь hysteria + CAP_NET_BIND_SERVICE,
# зеркально модели xray.service. TLS адаптивный: LE-серт подписки (копия
# + certbot deploy-hook) или self-signed. masquerade 404 — до живой
# проверки proxy-маскарада в срезе 3. Гранты per-profile — срез 3.

HYSTERIA2_BIN="/usr/local/bin/hysteria"
HYSTERIA2_DIR="$BACKENDS_DIR/hysteria"
HYSTERIA2_UNIT="hysteria-server.service"
HYSTERIA2_UNIT_FILE="/etc/systemd/system/hysteria-server.service"
HYSTERIA2_USER="hysteria"
HYSTERIA2_SYSCTL_FILE="/etc/sysctl.d/99-xrayebator-hysteria.conf"
HYSTERIA2_CERTBOT_HOOK="/etc/letsencrypt/renewal-hooks/deploy/xrayebator-hysteria.sh"
HYSTERIA2_REPO="HyNetworks/hysteria"

# Актив Hysteria для архитектуры текущего ядра.
_hysteria2_asset_arch() {
  case "$(uname -m)" in
    x86_64|amd64)   echo "amd64" ;;
    aarch64|arm64)  echo "arm64" ;;
    armv7l|armv6l)  echo "arm" ;;
    i686|i386)      echo "386" ;;
    *) return 1 ;;
  esac
}

# Последний стабильный релиз. stdout: "<tag> <sha256-digest|''>".
# Паттерн _fetch_latest_tag (Xray): GitHub API → fallback 302 redirect.
_hysteria2_fetch_release_info() {
  local arch=${1:-amd64}
  local api_json tag digest
  api_json=$(curl -fsSL --connect-timeout 10 --max-time 20 \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/repos/${HYSTERIA2_REPO}/releases/latest" 2>/dev/null)
  tag=$(echo "$api_json" | jq -r '.tag_name // ""' 2>/dev/null)
  if [[ "$tag" =~ ^app/v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    digest=$(echo "$api_json" | jq -r --arg n "hysteria-linux-${arch}" \
      '.assets[]? | select(.name == $n) | .digest // ""' 2>/dev/null)
    echo "${tag} ${digest#sha256:}"
    return 0
  fi

  local redirect_url
  redirect_url=$(curl -fso /dev/null -w '%{url_effective}' \
    --connect-timeout 10 --max-time 15 -L --max-redirs 1 \
    "https://github.com/${HYSTERIA2_REPO}/releases/latest" 2>/dev/null)
  tag="${redirect_url##*/}"
  if [[ "$tag" =~ ^app/v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "${tag} "
    return 0
  fi
  return 1
}

# Рендер серверного конфига (чистая функция — тестируется в CI).
# $5 = users-карта компактным JSON ({"user":"pass"}), по умолчанию пустая.
_hysteria2_render_server_yaml() {
  local out_file=$1 port=$2 cert=$3 key=$4 users=${5:-'{}'}
  cat > "$out_file" <<EOF
# Generated by xrayebator — регенерируется при изменениях, руками не править.
listen: :${port}

tls:
  cert: ${cert}
  key: ${key}

# Per-profile гранты: карта собрана из .backends.hysteria2 живых профилей.
# ВАЖНО: поле называется userpass (не users!) — с "users" hysteria падает
# с "empty auth userpass" (живой тест 2.26.125.147).
auth:
  type: userpass
  userpass: ${users}

masquerade:
  type: 404
EOF
}

# Рендер systemd-юнита (чистая функция — тестируется в CI).
_hysteria2_render_unit() {
  local out_file=$1
  cat > "$out_file" <<'EOF'
[Unit]
Description=Hysteria 2 server (managed by xrayebator)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hysteria
ExecStart=/usr/local/bin/hysteria server -c /usr/local/etc/xrayebator/backends/hysteria/server.yaml
WorkingDirectory=/usr/local/etc/xrayebator/backends/hysteria
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF
}

# TLS-режим: "le <domain>" при живом LE-серте подписки, иначе "selfsigned".
_hysteria2_tls_mode_detect() {
  local domain=""
  [[ -f /usr/local/etc/xray/.subscription_domain ]] && \
    domain=$(tr -d '\r\n' < /usr/local/etc/xray/.subscription_domain 2>/dev/null)
  if [[ -n "$domain" && -d "/etc/letsencrypt/live/$domain" ]]; then
    echo "le ${domain}"
  else
    echo "selfsigned"
  fi
}

# Системный пользователь сервиса (зеркало ensure_xray_runtime_user).
_hysteria2_ensure_user() {
  id -u "$HYSTERIA2_USER" >/dev/null 2>&1 && return 0
  local nologin
  nologin=$(command -v nologin 2>/dev/null || echo "/bin/false")
  useradd -r -s "$nologin" -M -d /nonexistent "$HYSTERIA2_USER" 2>/dev/null
}

# UDP-буферы для QUIC (рекомендация Hysteria; TCP-тюнинг Xrayebator не трогаем).
_hysteria2_apply_sysctl() {
  cat > "$HYSTERIA2_SYSCTL_FILE" <<'EOF'
# Managed by xrayebator (Hysteria 2 QUIC buffers)
net.core.rmem_max=16777216
net.core.wmem_max=16777216
EOF
  chmod 644 "$HYSTERIA2_SYSCTL_FILE"
  sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1 || true
  sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1 || true
}

# ── Срез 3: гранты per-profile, события жизненного цикла, ссылки ──

# Счётчик профилей с грантом hysteria2.
_hysteria2_grants_count() {
  local n
  n=$(jq -s '[.[] | select(.backends.hysteria2.password != null)] | length' \
    "$PROFILES_DIR"/*.json 2>/dev/null)
  [[ "$n" =~ ^[0-9]+$ ]] || n=0
  echo "$n"
}

# Placeholder-пользователь: Hysteria отвергает ПУСТУЮ userpass-карту
# ("empty auth userpass", живой тест 2.26.125.147). Пока нет грантов —
# в карте висит _xrayebator_placeholder со случайным паролем (0600 root).
_hysteria2_ensure_placeholder() {
  local pfile="$HYSTERIA2_DIR/.placeholder_pass"
  if [[ -s "$pfile" ]]; then
    tr -d '\r\n' < "$pfile"
    return 0
  fi
  openssl rand -hex 16 > "$pfile" 2>/dev/null || return 1
  chmod 600 "$pfile" 2>/dev/null
  tr -d '\r\n' < "$pfile"
}

# Применение нового server.yaml с откатом при неудачном рестарте.
# $1 = путь к готовому yaml; при неудаче на месте остаётся прежний.
_hysteria2_apply_config() {
  local new_file=$1
  _backend_installed hysteria2 || return 1
  [[ -s "$new_file" ]] || return 1
  local had_old=false
  [[ -f "$HYSTERIA2_DIR/server.yaml" ]] && had_old=true
  local backup="$HYSTERIA2_DIR/server.yaml.bak.apply"
  if [[ "$had_old" == true ]]; then
    cp -f "$HYSTERIA2_DIR/server.yaml" "$backup" || return 1
  fi
  cp -f "$new_file" "$HYSTERIA2_DIR/server.yaml" || return 1
  chown root:"$HYSTERIA2_USER" "$HYSTERIA2_DIR/server.yaml" 2>/dev/null
  chmod 640 "$HYSTERIA2_DIR/server.yaml" 2>/dev/null
  systemctl restart "$HYSTERIA2_UNIT" 2>/dev/null
  sleep 1
  if systemctl is-active --quiet "$HYSTERIA2_UNIT" 2>/dev/null; then
    rm -f "$backup"
    return 0
  fi
  echo -e "${YELLOW}  ⚠ Hysteria не поднялась с новым конфигом — откатываю...${NC}" >&2
  if [[ "$had_old" == true ]]; then
    cp -f "$backup" "$HYSTERIA2_DIR/server.yaml"
    chown root:"$HYSTERIA2_USER" "$HYSTERIA2_DIR/server.yaml" 2>/dev/null
    chmod 640 "$HYSTERIA2_DIR/server.yaml" 2>/dev/null
    systemctl restart "$HYSTERIA2_UNIT" 2>/dev/null
    sleep 1
  fi
  rm -f "$backup"
  return 1
}

# Регенерация users-карты из профилей + безопасный рестарт.
# Фильтр expire_disabled: истёкший/отключённый профиль не попадает в auth —
# restored после продления вернёт его автоматически (ключи живут в профиле).
_hysteria2_regen_config() {
  _backend_installed hysteria2 || return 0
  local port
  port=$(_backend_field hysteria2 port)
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  local users
  users=$(jq -sc '
    map(select(.backends.hysteria2.password != null and (.expire_disabled // false) == false)) |
    map({key: .backends.hysteria2.username, value: .backends.hysteria2.password}) |
    from_entries
  ' "$PROFILES_DIR"/*.json 2>/dev/null) || users="{}"
  [[ -n "$users" ]] || users="{}"
  if [[ "$users" == "{}" ]]; then
    # Пустая userpass-карта невалидна для Hysteria — placeholder-пользователь.
    local placeholder_pass
    placeholder_pass=$(_hysteria2_ensure_placeholder) || return 1
    users=$(jq -cn --arg p "$placeholder_pass" '{_xrayebator_placeholder: $p}')
  fi
  local tmp="$HYSTERIA2_DIR/.server.yaml.new"
  _hysteria2_render_server_yaml "$tmp" "$port" \
    "$HYSTERIA2_DIR/cert.pem" "$HYSTERIA2_DIR/key.pem" "$users" || return 1
  _hysteria2_apply_config "$tmp"
  local rc=$?
  rm -f "$tmp"
  return $rc
}

# Грант hysteria2 профилю: пароль в .backends.hysteria2 профиля.
# $2 = "no_regen" — не рестартовать (массовая выдача регенит один раз).
_hysteria2_grant_profile() {
  local name=$1
  local profile_file="$PROFILES_DIR/$name.json"
  _backend_installed hysteria2 || return 0
  [[ -f "$profile_file" ]] || return 1
  local existing
  existing=$(jq -r '.backends.hysteria2.password // empty' "$profile_file" 2>/dev/null)
  [[ -n "$existing" ]] && return 0
  local password
  password=$(openssl rand -hex 16) || return 1
  safe_jq_write --arg u "$name" --arg p "$password" \
    --arg c "$(date +%Y-%m-%d\ %H:%M:%S)" \
    '.backends = ((.backends // {}) + {hysteria2: {username: $u, password: $p, created: $c}})' \
    "$profile_file" || return 1
  [[ "${2:-}" == "no_regen" ]] && return 0
  _hysteria2_regen_config
}

# Массовая выдача: пишем все профили, реген — один.
_hysteria2_grant_all_profiles() {
  _backend_installed hysteria2 || return 0
  local pf name granted=0 failed=0
  for pf in "$PROFILES_DIR"/*.json; do
    [[ -f "$pf" ]] || continue
    name=$(jq -r '.name // empty' "$pf" 2>/dev/null)
    [[ -n "$name" ]] || continue
    if _hysteria2_grant_profile "$name" no_regen; then
      granted=$((granted+1))
    else
      failed=$((failed+1))
    fi
  done
  _hysteria2_regen_config || return 1
  echo -e "${GREEN}  ✓ Гранты Hysteria 2: выдано ${granted}, ошибок ${failed}${NC}" >&2
  return 0
}

# Обработчик событий жизненного цикла (вызывается из
# _backend_apply_profile_lifecycle). Все события сводятся к регену users-карты:
# created — грант+реген; revoked — ротация пароля+реген;
# deleted/expired/restored — реген (фильтр expire_disabled + отсутствие файла).
_hysteria2_on_profile_event() {
  local name=$1 event=$2
  _backend_installed hysteria2 || return 0
  local profile_file="$PROFILES_DIR/$name.json"
  case "$event" in
    created)
      # Авто-выдача при создании отключена (см. _awg_on_profile_event):
      # протокол ключа выбирает оператор, иначе новый профиль получал
      # ключи всех установленных бэкендов сразу.
      return 0
      ;;
    revoked)
      [[ -f "$profile_file" ]] || return 0
      jq -e '.backends.hysteria2.password' "$profile_file" >/dev/null 2>&1 || return 0
      local password
      password=$(openssl rand -hex 16) || return 1
      safe_jq_write --arg p "$password" \
        '.backends.hysteria2.password = $p' "$profile_file" || return 1
      _hysteria2_regen_config || return 1
      ;;
    deleted)
      # Аналогично AWG: файл профиля удалён вызывающим ДО lifecycle —
      # реген users-карты обязан пройти без удалённого гранта, иначе
      # осиротевший пароль остаётся в server.yaml и удалённый
      # пользователь сохраняет доступ.
      _hysteria2_regen_config || return 1
      ;;
    expired|restored)
      [[ -f "$profile_file" ]] || return 0
      _hysteria2_regen_config || return 1
      ;;
    *)
      return 0
      ;;
  esac
  return 0
}

# Pure-построение hysteria2:// URI (без TUI/stdin/записей) — для подписки.
# Вызывается subhttp.sh от пользователя xray: реестр 644, профиль читаем.
_hysteria2_profile_link_pure() {
  local profile_file=$1
  [[ -f "$profile_file" ]] || return 1
  _backend_installed hysteria2 || return 1
  local user pass port tls_mode sni host insecure name
  user=$(jq -r '.backends.hysteria2.username // empty' "$profile_file" 2>/dev/null)
  pass=$(jq -r '.backends.hysteria2.password // empty' "$profile_file" 2>/dev/null)
  [[ -n "$user" && -n "$pass" ]] || return 1
  port=$(_backend_field hysteria2 port)
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  tls_mode=$(_backend_field hysteria2 tls_mode)
  sni=$(_backend_field hysteria2 sni)
  host=$(_connection_server_address 2>/dev/null) || return 1
  [[ -n "$host" ]] || return 1
  case "$tls_mode" in
    le*) insecure=0 ;;
    *)   insecure=1 ;;
  esac
  local uri="hysteria2://${user}:${pass}@${host}:${port}/?insecure=${insecure}"
  [[ -n "$sni" ]] && uri="hysteria2://${user}:${pass}@${host}:${port}/?sni=${sni}&insecure=${insecure}"
  name=$(jq -r '.name // empty' "$profile_file" 2>/dev/null)
  if [[ -n "$name" ]]; then
    # Флаг страны — как у VLESS-маршрутов: в HAPP ключи должны выглядеть
    # единообразно (круглый флаг в начале имени). Нет geo-маркера — голое имя.
    local geo_country geo_flag
    geo_country=$(_geo_country_name)
    geo_flag=$(_geo_flag_emoji "$(_geo_country_code)")
    if [[ -n "$geo_country" ]]; then
      if [[ -n "$geo_flag" ]]; then
        name="${geo_flag} ${geo_country} · ${name}"
      else
        name="${geo_country} · ${name}"
      fi
    fi
    # Фрагмент обязан быть URL-encoded (юникод флага/пробелы) — как в vless://.
    name=$(jq -nr --arg n "$name" '$n|@uri')
    uri="${uri}#${name}"
  fi
  echo "$uri"
}

# CLI: hysteria2-grant --name N. Только JSON на stdout.
hysteria2_grant_command() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$name" ]] || { echo '{"ok":false,"error":"--name required"}'; return 1; }
  local rc=0
  exec 3>&1; exec 1>&2
  _hysteria2_grant_profile "$name" || rc=$?
  exec 1>&3
  if [[ $rc == 0 ]]; then
    jq -n --arg n "$name" '{ok: true, name: $n}'
  else
    jq -n --argjson code "$rc" '{ok: false, code: $code}'
    rc=1
  fi
  return "$rc"
}

# Меню: ссылка hysteria2 для профиля с грантом (+QR при наличии qrencode).
hysteria2_link_menu() {
  local -a names=()
  local pf name
  for pf in "$PROFILES_DIR"/*.json; do
    [[ -f "$pf" ]] || continue
    name=$(jq -r '.backends.hysteria2.username // empty' "$pf" 2>/dev/null)
    [[ -n "$name" ]] && names+=("$name")
  done
  if [[ ${#names[@]} == 0 ]]; then
    echo -e "${YELLOW}Нет профилей с грантом Hysteria 2.${NC}"
    return 0
  fi
  echo ""
  echo -e "${CYAN}Профили с грантом:${NC}"
  local i=1
  for name in "${names[@]}"; do
    echo -e " ${CYAN}${i})${NC} $name"
    ((i++))
  done
  echo -n -e "${YELLOW}Номер профиля [1-${#names[@]}]: ${NC}"
  local choice
  read -r choice || return 0
  [[ "$choice" =~ ^[0-9]+$ ]] || return 0
  (( choice >= 1 && choice <= ${#names[@]} )) || return 0
  local selected="${names[$((choice-1))]}"
  local link
  link=$(_hysteria2_profile_link_pure "$PROFILES_DIR/$selected.json" 2>/dev/null) || {
    echo -e "${RED}✗ Не удалось построить ссылку hysteria2${NC}"
    return 1
  }
  echo ""
  echo -e "${GREEN}${link}${NC}"
  echo ""
  command -v qrencode >/dev/null 2>&1 && qrencode -t ANSIUTF8 "$link" 2>/dev/null
  return 0
}

# Безопасный рестарт Hysteria: бэкап server.yaml → restart → при неудаче откат.
_hysteria2_safe_restart() {
  [[ -f "$HYSTERIA2_DIR/server.yaml" ]] || return 1
  local backup="$HYSTERIA2_DIR/server.yaml.bak.$$"
  cp -f "$HYSTERIA2_DIR/server.yaml" "$backup" || return 1
  systemctl restart "$HYSTERIA2_UNIT" 2>/dev/null
  sleep 1
  if systemctl is-active --quiet "$HYSTERIA2_UNIT" 2>/dev/null; then
    rm -f "$backup"
    return 0
  fi
  echo -e "${YELLOW}  ⚠ Hysteria не поднялась — откатываю server.yaml...${NC}"
  cp -f "$backup" "$HYSTERIA2_DIR/server.yaml"
  chown root:"$HYSTERIA2_USER" "$HYSTERIA2_DIR/server.yaml" 2>/dev/null
  chmod 640 "$HYSTERIA2_DIR/server.yaml" 2>/dev/null
  systemctl restart "$HYSTERIA2_UNIT" 2>/dev/null
  sleep 1
  rm -f "$backup"
  systemctl is-active --quiet "$HYSTERIA2_UNIT" 2>/dev/null && \
    echo -e "${GREEN}  ✓ Hysteria восстановлена на прежнем конфиге${NC}"
  return 1
}

# Установка Hysteria 2. Аргумент: $1 = UDP-порт (по умолчанию 443).
# Человеческий вывод; для CLI JSON — hysteria2_install_command.
# Возвращает: 0=ok, 1=ошибка, 2=уже установлена.
_hysteria2_install() {
  local port=${1:-443}
  [[ "$port" =~ ^[0-9]+$ ]] && [[ $port -ge 1 ]] && [[ $port -le 65535 ]] || {
    echo -e "${RED}✗ Некорректный порт: ${port}${NC}"
    return 1
  }
  if _backend_installed hysteria2; then
    echo -e "${YELLOW}ℹ Hysteria 2 уже установлена (версия $(_backend_field hysteria2 version)).${NC}"
    echo -e "${YELLOW}  Для переустановки: сначала 'hysteria2-uninstall'.${NC}"
    return 2
  fi
  if _backend_port_busy_udp "$port"; then
    echo -e "${RED}✗ UDP-порт ${port} уже занят другим слушателем.${NC}"
    echo -e "${YELLOW}  Выберите другой порт.${NC}"
    return 1
  fi

  local arch
  arch=$(_hysteria2_asset_arch) || {
    echo -e "${RED}✗ Архитектура $(uname -m) не поддерживается Hysteria${NC}"
    return 1
  }

  echo -e "${CYAN}  → Запрашиваю последний релиз Hysteria...${NC}"
  local rel_info tag expect_sha
  rel_info=$(_hysteria2_fetch_release_info "$arch") || {
    echo -e "${RED}✗ Не удалось определить последний релиз Hysteria (GitHub недоступен?)${NC}"
    return 1
  }
  tag=${rel_info%% *}
  expect_sha=${rel_info#* }
  local version=${tag#app/}
  echo -e "${CYAN}  → Релиз: ${version} (hysteria-linux-${arch})${NC}"

  # Скачивание во временный файл + sha256 из API digest.
  local url tmp
  url="https://github.com/${HYSTERIA2_REPO}/releases/download/${tag}/hysteria-linux-${arch}"
  tmp=$(mktemp) || return 1
  echo -e "${CYAN}  → Скачиваю бинарник...${NC}"
  if ! curl -fL --retry 5 --retry-delay 2 --retry-all-errors \
      --connect-timeout 30 --max-time 600 --http1.1 -o "$tmp" "$url" 2>/dev/null; then
    echo -e "${RED}✗ Не удалось скачать ${url}${NC}"
    rm -f "$tmp"
    return 1
  fi
  if [[ -n "$expect_sha" ]]; then
    local got_sha
    got_sha=$(sha256sum "$tmp" 2>/dev/null | awk '{print $1}')
    if [[ "$got_sha" != "$expect_sha" ]]; then
      echo -e "${RED}✗ sha256 не совпал (ожидалось ${expect_sha}, получено ${got_sha})${NC}"
      rm -f "$tmp"
      return 1
    fi
    echo -e "${CYAN}  ✓ sha256 сверён${NC}"
  else
    echo -e "${YELLOW}  ⚠ sha256 недоступен из API — пропускаю проверку${NC}"
  fi
  chmod 755 "$tmp"
  if ! "$tmp" version >/dev/null 2>&1; then
    echo -e "${RED}✗ Бинарник не прошёл self-test (hysteria version)${NC}"
    rm -f "$tmp"
    return 1
  fi

  echo -e "${CYAN}  → Создаю пользователя/каталоги/серт...${NC}"
  _hysteria2_ensure_user || {
    echo -e "${RED}✗ Не удалось создать системного пользователя ${HYSTERIA2_USER}${NC}"
    rm -f "$tmp"
    return 1
  }
  mkdir -p "$HYSTERIA2_DIR"

  local tls_mode sni domain=""
  tls_mode=$(_hysteria2_tls_mode_detect)
  [[ "$tls_mode" == le\ * ]] && domain=${tls_mode#le }
  if [[ "$tls_mode" == "le "* ]]; then
    cp -f "/etc/letsencrypt/live/${domain}/fullchain.pem" "$HYSTERIA2_DIR/cert.pem" &&
      cp -f "/etc/letsencrypt/live/${domain}/privkey.pem" "$HYSTERIA2_DIR/key.pem" || {
      echo -e "${RED}✗ Не удалось скопировать LE-серт из /etc/letsencrypt/live/${domain}${NC}"
      rm -f "$tmp"
      return 1
    }
    sni="$domain"
    mkdir -p "$(dirname "$HYSTERIA2_CERTBOT_HOOK")"
    cat > "$HYSTERIA2_CERTBOT_HOOK" <<'EOF'
#!/usr/bin/env bash
# Managed by xrayebator: обновление Hysteria 2 после продления certbot.
set -u
domain="${RENEWED_DOMAINS%% *}"
[[ -n "$domain" ]] || exit 0
dir="/usr/local/etc/xrayebator/backends/hysteria"
live="/etc/letsencrypt/live/$domain"
[[ -d "$dir" && -d "$live" ]] || exit 0
cp -f "$live/fullchain.pem" "$dir/cert.pem" && cp -f "$live/privkey.pem" "$dir/key.pem" || exit 0
chown root:hysteria "$dir/cert.pem" "$dir/key.pem" 2>/dev/null
chmod 640 "$dir/cert.pem" "$dir/key.pem" 2>/dev/null
systemctl restart hysteria-server
EOF
    chmod 755 "$HYSTERIA2_CERTBOT_HOOK"
    echo -e "${CYAN}  ✓ TLS: LE-серт подписки (${domain}) + deploy-hook на продление${NC}"
  else
    openssl ecparam -genkey -name prime256v1 -out "$HYSTERIA2_DIR/key.pem" 2>/dev/null &&
      openssl req -new -x509 -days 3650 -key "$HYSTERIA2_DIR/key.pem" \
        -out "$HYSTERIA2_DIR/cert.pem" -subj "/CN=hysteria" 2>/dev/null || {
      echo -e "${RED}✗ Не удалось сгенерировать self-signed сертификат (openssl?)${NC}"
      rm -f "$tmp"
      return 1
    }
    sni=""
    echo -e "${CYAN}  ✓ TLS: self-signed (клиенты с insecure=1)${NC}"
  fi

  # Стартовый конфиг: Hysteria не принимает пустую userpass-карту —
  # рендерим с placeholder-пользователем; реген при грантах его заменит.
  local placeholder_pass
  placeholder_pass=$(_hysteria2_ensure_placeholder) || {
    echo -e "${RED}✗ Не удалось создать placeholder-пароль${NC}"
    rm -f "$tmp"
    return 1
  }
  _hysteria2_render_server_yaml "$HYSTERIA2_DIR/server.yaml" "$port" \
    "$HYSTERIA2_DIR/cert.pem" "$HYSTERIA2_DIR/key.pem" \
    "$(jq -cn --arg p "$placeholder_pass" '{_xrayebator_placeholder: $p}')"
  _hysteria2_apply_sysctl

  echo -e "${CYAN}  → Устанавливаю бинарник и юнит...${NC}"
  [[ -f "$HYSTERIA2_BIN" ]] && cp -f "$HYSTERIA2_BIN" "${HYSTERIA2_BIN}.bak.$(date +%s)"
  install -m 755 "$tmp" "$HYSTERIA2_BIN" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"

  _hysteria2_render_unit "$HYSTERIA2_UNIT_FILE"
  chown root:"$HYSTERIA2_USER" "$HYSTERIA2_DIR/server.yaml" "$HYSTERIA2_DIR/cert.pem" "$HYSTERIA2_DIR/key.pem" 2>/dev/null
  chmod 750 "$HYSTERIA2_DIR"
  # Каталог должен быть читаем сервисом: без chown он остаётся root:root
  # и CHDIR юнита падает с Permission denied (живой тест 2.26.125.147).
  chown root:"$HYSTERIA2_USER" "$HYSTERIA2_DIR" 2>/dev/null
  chmod 640 "$HYSTERIA2_DIR/server.yaml" "$HYSTERIA2_DIR/cert.pem" "$HYSTERIA2_DIR/key.pem" 2>/dev/null

  systemctl daemon-reload
  if ! systemctl enable --now "$HYSTERIA2_UNIT" 2>/dev/null; then
    echo -e "${RED}✗ systemctl enable --now ${HYSTERIA2_UNIT} не удался${NC}"
    _hysteria2_install_rollback
    return 1
  fi
  sleep 1
  if ! systemctl is-active --quiet "$HYSTERIA2_UNIT" 2>/dev/null; then
    echo -e "${RED}✗ Hysteria не запустилась — journalctl -u ${HYSTERIA2_UNIT}${NC}"
    _hysteria2_install_rollback
    return 1
  fi

  open_firewall_port "$port" udp

  # Реестр — последним шагом: записи появляются только у живого бэкенда.
  _backend_set hysteria2 '(.hysteria2.installed) = true' &&
    _backend_set hysteria2 '(.hysteria2.version) = $v' --arg v "$version" &&
    _backend_set hysteria2 '(.hysteria2.port) = $port' --argjson port "$port" &&
    _backend_set hysteria2 '(.hysteria2.unit) = $u' --arg u "$HYSTERIA2_UNIT" &&
    _backend_set hysteria2 '(.hysteria2.tls_mode) = $m' --arg m "$tls_mode" &&
    _backend_set hysteria2 '(.hysteria2.sni) = $s' --arg s "$sni" &&
    _backend_set hysteria2 '(.hysteria2.masquerade) = "404"' &&
    _backend_set hysteria2 '(.hysteria2.obfs) = false' &&
    _backend_set hysteria2 '(.hysteria2.sub_body) = true' || {
    echo -e "${RED}✗ Не удалось записать реестр бэкендов${NC}"
    _hysteria2_install_rollback
    return 1
  }

  # Гранты существующим профилям (срез 3). Режимы $2: prompt (интерактив),
  # grant_all (CLI --grant-all), no_prompt (CLI по умолчанию).
  local grant_mode=${2:-prompt}
  if [[ "$grant_mode" == "grant_all" ]]; then
    _hysteria2_grant_all_profiles
  elif [[ "$grant_mode" != "no_prompt" ]]; then
    echo ""
    echo -n -e "${YELLOW}Выдать доступ Hysteria 2 всем существующим профилям? [y/N]: ${NC}"
    local grant_ans
    read -r grant_ans || grant_ans=N
    [[ "$grant_ans" =~ ^[yYдД]$ ]] && _hysteria2_grant_all_profiles
  fi

  echo ""
  echo -e "${GREEN}╔═══════════════════════════════════════════════╗${NC}"
  echo -e "${GREEN}║      ✓ HYSTERIA 2 УСТАНОВЛЕНА                 ║${NC}"
  echo -e "${GREEN}╚═══════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${BLUE}Версия:${NC} $version"
  echo -e "${BLUE}Порт:${NC} UDP $port"
  echo -e "${BLUE}TLS:${NC} $tls_mode"
  echo -e "${BLUE}Грантов выдано:${NC} $(_hysteria2_grants_count)"
  return 0
}

# Откат артефактов установки при неудаче (registry-записи ещё не писались).
_hysteria2_install_rollback() {
  systemctl disable --now "$HYSTERIA2_UNIT" 2>/dev/null
  rm -f "$HYSTERIA2_UNIT_FILE"
  systemctl daemon-reload 2>/dev/null
  rm -rf "$HYSTERIA2_DIR"
  rm -f "$HYSTERIA2_SYSCTL_FILE" "$HYSTERIA2_CERTBOT_HOOK"
}

# Удаление Hysteria 2. Возвращает: 0=ok, 2=не установлена.
_hysteria2_uninstall() {
  if ! _backend_installed hysteria2 && [[ ! -f "$HYSTERIA2_UNIT_FILE" ]]; then
    echo -e "${YELLOW}ℹ Hysteria 2 не установлена.${NC}"
    return 2
  fi
  local port
  port=$(_backend_field hysteria2 port)

  echo -e "${CYAN}  → Останавливаю и удаляю сервис...${NC}"
  systemctl disable --now "$HYSTERIA2_UNIT" 2>/dev/null
  rm -f "$HYSTERIA2_UNIT_FILE"
  systemctl daemon-reload 2>/dev/null

  rm -f "$HYSTERIA2_SYSCTL_FILE" "$HYSTERIA2_CERTBOT_HOOK"
  rm -rf "$HYSTERIA2_DIR"
  rm -f "$HYSTERIA2_BIN" "$HYSTERIA2_BIN".bak.* 2>/dev/null

  if [[ "$port" =~ ^[0-9]+$ ]]; then
    close_firewall_port "$port" udp
  fi

  safe_jq_write --arg t hysteria2 'del(.[$t])' "$BACKENDS_REGISTRY_FILE" 2>/dev/null

  echo -e "${GREEN}  ✓ Hysteria 2 удалена${NC}"
  echo -e "${YELLOW}ℹ Гранты в профилях (.backends.hysteria2) чистятся срезом 3 lifecycle-хуком.${NC}"
  return 0
}

# CLI: hysteria2-install [--port P]. Только JSON на stdout.
hysteria2_install_command() {
  local port=443 grant_mode="no_prompt"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)
        [[ $# -ge 2 ]] || { echo '{"ok":false,"error":"--port requires value"}' >&2; return 1; }
        port=$2; shift 2 ;;
      --grant-all)
        grant_mode="grant_all"; shift ;;
      *)
        echo "{\"ok\":false,\"error\":\"unknown argument: $1\"}" >&2
        return 1 ;;
    esac
  done
  local rc=0
  exec 3>&1; exec 1>&2
  _hysteria2_install "$port" "$grant_mode" || rc=$?
  exec 1>&3
  if [[ $rc == 0 ]]; then
    jq -n '{ok: true}'
  elif [[ $rc == 2 ]]; then
    jq -n '{ok: true, already: true}'
    rc=0
  else
    jq -n --argjson code "$rc" '{ok: false, code: $code}'
  fi
  return "$rc"
}

# CLI: hysteria2-uninstall. Только JSON на stdout.
hysteria2_uninstall_command() {
  local rc=0
  exec 3>&1; exec 1>&2
  _hysteria2_uninstall || rc=$?
  exec 1>&3
  if [[ $rc == 0 ]]; then
    jq -n '{ok: true}'
  elif [[ $rc == 2 ]]; then
    jq -n '{ok: true, already: true}'
    rc=0
  else
    jq -n --argjson code "$rc" '{ok: false, code: $code}'
  fi
  return "$rc"
}

# CLI: hysteria2-status. Только JSON на stdout.
hysteria2_status_command() {
  local full
  full=$(_backend_status_json) || { echo '{"ok":false,"error":"registry"}'; return 1; }
  local bin_state="absent"
  [[ -x "$HYSTERIA2_BIN" ]] && bin_state="present"
  echo "$full" | jq --arg bin "$bin_state" '{ok: .ok, binary: $bin, backend: .backends.hysteria2}'
}

# CLI: hysteria2-subbody --on|--off. Kill-switch строк hysteria2:// в телах
# подписки (handler перечитывает реестр на каждый запрос — без рестартов).
# Только JSON на stdout.
hysteria2_subbody_command() {
  local mode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --on) mode="on"; shift ;;
      --off) mode="off"; shift ;;
      *) shift ;;
    esac
  done
  [[ -n "$mode" ]] || { echo '{"ok":false,"error":"--on/--off required"}'; return 1; }
  if ! _backend_installed hysteria2; then
    echo '{"ok":false,"error":"Hysteria 2 не установлена"}'
    return 1
  fi
  local v=true
  [[ "$mode" == "off" ]] && v=false
  _backend_set hysteria2 '(.hysteria2.sub_body) = $v' --argjson v "$v" || {
    echo '{"ok":false,"error":"registry write failed"}'
    return 1
  }
  jq -n --argjson v "$v" '{ok: true, sub_body: $v}'
}

# CLI: hysteria2-link --name N. Ссылка hysteria2:// для профиля с грантом
# (именование с флагом страны — как у VLESS-маршрутов). Только JSON.
hysteria2_link_command() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$name" ]] || { echo '{"ok":false,"error":"--name required"}'; return 1; }
  local pf="$PROFILES_DIR/$name.json"
  [[ -f "$pf" ]] || { echo '{"ok":false,"error":"Профиль не найден"}'; return 1; }
  local link
  link=$(_hysteria2_profile_link_pure "$pf" 2>/dev/null) || {
    echo '{"ok":false,"error":"Нет гранта Hysteria 2 или бэкенд не установлен"}'
    return 1
  }
  jq -n --arg n "$name" --arg l "$link" '{ok: true, name: $n, link: $l}'
}

