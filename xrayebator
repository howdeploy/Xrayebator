NGINX_SITES_AVAILABLE="${NGINX_SITES_AVAILABLE:-/etc/nginx/sites-available}"
NGINX_SITES_ENABLED="${NGINX_SITES_ENABLED:-/etc/nginx/sites-enabled}"
# P2-fix: транзакция quickstart-nginx вынесена на уровень файла (не local внутри
# quickstart_command), чтобы её можно было реально исполнить в функциональном тесте и
# она была единым источником истины для rollback. Состояние не персистентно — только
# для текущего процесса quickstart.
QS_NGINX_MODIFIED=0
QS_VHOST_BACKUP="$NGINX_SITES_AVAILABLE/xrayebator-sub.xrayebator.bak"
QS_DEFAULT_REMOVED=false
QS_DEFAULT_BACKUP_CREATED=false

_qs_backup_path() {
  local source_path="$1" backup_path="$2"
  [[ -e "$source_path" || -L "$source_path" ]] || return 1
  [[ ! -e "$backup_path" && ! -L "$backup_path" ]] || return 1
  if ! cp -a -- "$source_path" "$backup_path" 2>/dev/null; then
    rm -f -- "$backup_path"
    return 1
  fi
  if [[ -L "$source_path" ]]; then
    [[ -L "$backup_path" && "$(readlink -- "$source_path")" == "$(readlink -- "$backup_path")" ]] || {
      rm -f -- "$backup_path"
      return 1
    }
  elif [[ ! -f "$backup_path" ]] || ! cmp -s -- "$source_path" "$backup_path"; then
    rm -f -- "$backup_path"
    return 1
  fi
}

# Восстанавливает исходное состояние nginx после ANY мутации quickstart: прежний vhost
# xrayebator-sub (если был), default-сайт (если удаляли), убирает наш vhost и перегружает
# nginx. Обёрнуто в backreference: работает и при отсутствии default-сайта.
_qs_nginx_rollback() {
  local rollback_failed=0
  if [[ "$QS_NGINX_MODIFIED" != "true" ]]; then
    return 0
  fi
  rm -f -- "$NGINX_SITES_ENABLED/xrayebator-sub" "$NGINX_SITES_AVAILABLE/xrayebator-sub" ||
    rollback_failed=1
  if [[ -n "$QS_VHOST_BACKUP" && ( -e "$QS_VHOST_BACKUP" || -L "$QS_VHOST_BACKUP" ) ]]; then
    if _qs_backup_path "$QS_VHOST_BACKUP" "$NGINX_SITES_AVAILABLE/xrayebator-sub" &&
       ln -sf "$NGINX_SITES_AVAILABLE/xrayebator-sub" "$NGINX_SITES_ENABLED/xrayebator-sub"; then
      rm -f -- "$QS_VHOST_BACKUP"
    else
      rollback_failed=1
    fi
  fi
  if [[ "$QS_DEFAULT_REMOVED" == "true" ]]; then
    if [[ -e "$NGINX_SITES_ENABLED/default.xrayebator.bak" || -L "$NGINX_SITES_ENABLED/default.xrayebator.bak" ]]; then
      if _qs_backup_path "$NGINX_SITES_ENABLED/default.xrayebator.bak" "$NGINX_SITES_ENABLED/default"; then
        rm -f -- "$NGINX_SITES_ENABLED/default.xrayebator.bak"
      else
        rollback_failed=1
      fi
    else
      rollback_failed=1
    fi
  elif [[ "$QS_DEFAULT_BACKUP_CREATED" == "true" ]]; then
    rm -f -- "$NGINX_SITES_ENABLED/default.xrayebator.bak" || rollback_failed=1
  fi
  if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
    systemctl reload nginx >/dev/null 2>&1 || true
  fi
  if [[ "$rollback_failed" -eq 0 ]]; then
    QS_NGINX_MODIFIED=false
    QS_DEFAULT_REMOVED=false
    QS_DEFAULT_BACKUP_CREATED=false
    QS_VHOST_BACKUP=""
  fi
  return "$rollback_failed"
}
