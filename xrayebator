# Удаление AdGuard Home
uninstall_adguard_home() {
  show_ascii
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
  echo -e "${BLUE}        УДАЛЕНИЕ ADGUARD HOME                 ${NC}"
  echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
  echo ""

  # Шаг 1: Проверка — установлен?
  if [[ ! -f /opt/AdGuardHome/AdGuardHome ]]; then
    echo -e "${YELLOW}⚠ AdGuard Home не установлен${NC}"
    echo ""
    echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
    read
    return
  fi

  # Шаг 2: Подтверждение
  echo -e "${RED}╔═══════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║            ⚠ УДАЛЕНИЕ ADGUARD HOME ⚠                   ║${NC}"
  echo -e "${RED}╚═══════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${YELLOW}Будут удалены:${NC}"
  echo -e "  ${CYAN}•${NC} AdGuard Home и все его настройки"
  echo -e "  ${CYAN}•${NC} Фильтры и статистика"
  echo -e "  ${CYAN}•${NC} Интеграция с Xray DNS"
  echo ""
  echo -e "${CYAN}Xray DNS будет восстановлен на DoH Local (1.1.1.1).${NC}"
  echo ""
  echo -n -e "${RED}Вы уверены? (y/N): ${NC}"
  read confirm
  if [[ ! "$confirm" =~ ^[yYдД]$ ]]; then
    echo -e "${CYAN}✓ Отменено${NC}"
    sleep 1
    return
  fi

  echo ""

  # Сначала переключаем Xray с AdGuard DNS, пока сам AdGuard ещё доступен.
  # При ошибке валидации точный backup возвращает полностью рабочее состояние.
  echo -e "${CYAN}Шаг 1/5: Переключение Xray DNS на DoH Local...${NC}"
  local rollback_config=""
  local query_strategy
  query_strategy=$(_ipv6_query_strategy)
  # P1-ipv6-fix: единый family-aware DoH. Раньше жёстко 1.1.1.1 — на IPv6-only
  # хосте AdGuard rollback оставлял Xray без DNS.
  local dns_doh_server
  if _detect_ipv6_only; then
    dns_doh_server="https+local://dns.google/dns-query"
  else
    dns_doh_server="https+local://1.1.1.1/dns-query"
  fi
  if [[ ! -f "$CONFIG_FILE" ]] ||
     ! backup_config "adguard_dns_restore" rollback_config ||
     ! safe_jq_write --arg qs "$query_strategy" --arg doh "$dns_doh_server" '.dns = {
       "servers": [
         $doh,
         "localhost"
       ],
       "queryStrategy": $qs,
       "disableCache": false
     }' "$CONFIG_FILE"; then
    [[ -n "$rollback_config" ]] && _restore_config_backup "$rollback_config" || true
    echo -e "${RED}✗ Xray DNS не подготовлен — AdGuard НЕ удалён${NC}"
    return
  fi
  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    echo -e "${RED}✗ Xray не принял DoH-конфиг — AdGuard НЕ удалён${NC}"
    return
  fi
  echo -e "${GREEN}  ✓ Xray DNS → DoH Local${NC}"

  echo -e "${CYAN}Шаг 2/5: Остановка AdGuard Home...${NC}"
  systemctl stop AdGuardHome 2>/dev/null || true
  systemctl disable AdGuardHome 2>/dev/null || true
  echo -e "${GREEN}  ✓ Служба остановлена${NC}"

  echo -e "${CYAN}Шаг 3/5: Удаление файлов...${NC}"
  /opt/AdGuardHome/AdGuardHome -s uninstall 2>/dev/null || true
  rm -rf /opt/AdGuardHome/
  if [[ -e /opt/AdGuardHome ]]; then
    echo -e "${RED}✗ Каталог /opt/AdGuardHome не удалён; Xray уже безопасно переключён на DoH${NC}"
    return
  fi
  echo -e "${GREEN}  ✓ AdGuard Home удалён${NC}"

  echo -e "${CYAN}Шаг 4/5: Восстановление systemd-resolved...${NC}"
  if [[ -f /etc/systemd/resolved.conf.d/adguardhome.conf ]]; then
    rm -f /etc/systemd/resolved.conf.d/adguardhome.conf
    # Восстанавливаем resolv.conf на стандартный stub
    if [[ -L /etc/resolv.conf ]] || [[ -f /etc/resolv.conf ]]; then
      ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null || true
    fi
    systemctl restart systemd-resolved 2>/dev/null || true
    echo -e "${GREEN}  ✓ systemd-resolved восстановлен${NC}"
  else
    echo -e "${GREEN}  ✓ systemd-resolved не был изменён${NC}"
  fi

  # Закрытие портов
  echo -e "${CYAN}Шаг 5/5: Закрытие портов...${NC}"
  _ufw_remove_owned_port 53 tcp || true
  _ufw_remove_owned_port 53 udp || true
  _ufw_remove_owned_port 3000 tcp || true
  echo -e "${GREEN}  ✓ Порты проверены${NC}"

  echo ""
  echo -e "${GREEN}╔═══════════════════════════════════════════════════════════╗${NC}"
  echo -e "${GREEN}║         ✓ ADGUARD HOME УСПЕШНО УДАЛЁН                   ║${NC}"
  echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${CYAN}Xray DNS восстановлен на DoH Local (1.1.1.1).${NC}"
  echo ""
  echo -n -e "${YELLOW}Нажмите Enter для продолжения...${NC}"
  read
}

# CLI dispatch (Phase 5, REQ-B02). Subcommand-style.

# xrayebator inspect --json — read-only диагностика установки для GUI-импорта.
# Никаких изменений состояния: только чтение маркеров, профилей и статуса сервисов.
inspect_command() {
  export TERM=dumb
  export XRAYEBATOR_NONINTERACTIVE=1

  local state_dir="/usr/local/etc/xray"
  local manager_binary="/usr/local/bin/xrayebator"

  if [[ ! -d "$state_dir" ]]; then
    jq -n --arg error "Установка Xrayebator не распознана: каталог состояния отсутствует" \
      '{ok:false, recognized:false, error:$error}'
    return 1
  fi

  local manager="missing"
  [[ -x "$manager_binary" ]] && manager="detected"

  local os=""
  os=$(awk -F'"' '/^PRETTY_NAME=/{print $2; exit}' /etc/os-release 2>/dev/null)

  local xray="missing"
  if command -v /usr/local/bin/xray &>/dev/null || command -v xray &>/dev/null; then
    if systemctl is-active --quiet xray.service 2>/dev/null; then
      xray="running"
    else
      xray="stopped"
    fi
  fi

  local profile_count=0 route_count=0 rc
  local profile_file
  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ -f "$profile_file" ]] || continue
    profile_count=$((profile_count + 1))
    rc=$(jq -r '((.routes // []) | length)' "$profile_file" 2>/dev/null || echo 0)
    [[ "$rc" =~ ^[0-9]+$ ]] || rc=0
    route_count=$((route_count + rc))
  done

  local profiles="missing"
  if [[ -d "$PROFILES_DIR" ]]; then
    if [[ "$profile_count" -gt 0 ]]; then profiles="available"; else profiles="empty"; fi
  fi

  local sub_installed=false
  [[ -f "$state_dir/.subscription_installed" ]] && sub_installed=true
  local sub_mode="" sub_domain="" sub_port=""
  [[ -f "$state_dir/.subscription_mode" ]] && sub_mode=$(tr -d '\r\n' < "$state_dir/.subscription_mode" 2>/dev/null)
  [[ -f "$state_dir/.subscription_domain" ]] && sub_domain=$(tr -d '\r\n' < "$state_dir/.subscription_domain" 2>/dev/null)
  [[ -f "$state_dir/.subscription_port" ]] && sub_port=$(tr -d '\r\n' < "$state_dir/.subscription_port" 2>/dev/null)

  local sub_service="stopped"
  systemctl is-active --quiet xrayebator-sub.service 2>/dev/null && sub_service="running"

  local sub_token="" t
  if [[ "$sub_installed" == true ]]; then
    for profile_file in "$PROFILES_DIR"/*.json; do
      [[ -f "$profile_file" ]] || continue
      t=$(jq -r '.sub_token // empty' "$profile_file" 2>/dev/null)
      if [[ "$t" =~ ^[a-f0-9]{32}$ ]]; then sub_token="$t"; break; fi
    done
  fi
  local sub_url=""
  [[ -n "$sub_token" ]] && sub_url=$(_profile_cli_subscription_url "$sub_token" 2>/dev/null || true)

  local sub_port_json="null"
  [[ "$sub_port" =~ ^[0-9]+$ ]] && sub_port_json="$sub_port"

  local geo_country="" geo_city="" flag=""
  if [[ -f "$SERVER_COUNTRY_FILE" ]]; then
    geo_country=$(_geo_country_name)
    geo_city=$(_geo_city)
    flag=$(_geo_flag_emoji "$(_geo_country_code)")
  fi

  # Мультибэкенд: сводка реестра. STRICT read-only: inspect ничего не создаёт —
  # при отсутствии файла реестра просто пустой объект; секреты не включаем.
  local backends_json="{}"
  if [[ -s "$BACKENDS_REGISTRY_FILE" ]]; then
    backends_json=$(jq -c \
      'with_entries(.value |= {installed: (.value.installed // false),
        version: (.value.version // null), port: (.value.port // null)})' \
      "$BACKENDS_REGISTRY_FILE" 2>/dev/null) || backends_json="{}"
    [[ -n "$backends_json" ]] || backends_json="{}"
  fi

  jq -n \
    --argjson ok true --argjson recognized true \
    --arg os "$os" --arg manager "$manager" --arg xray "$xray" \
    --arg profiles "$profiles" \
    --argjson profile_count "$profile_count" --argjson route_count "$route_count" \
    --argjson subscription_installed "$sub_installed" \
    --arg subscription_mode "${sub_mode:-unknown}" \
    --arg subscription_domain "$sub_domain" \
    --argjson subscription_port "$sub_port_json" \
    --arg subscription_service "$sub_service" \
    --arg subscription_url "$sub_url" \
    --arg country "$geo_country" --arg city "$geo_city" --arg flag "$flag" \
    --argjson backends "$backends_json" \
    '{ok:$ok, recognized:$recognized, os:$os, manager:$manager, xray:$xray,
      profiles:$profiles, profile_count:$profile_count, route_count:$route_count,
      subscription_installed:$subscription_installed, subscription_mode:$subscription_mode,
      subscription_domain:$subscription_domain, subscription_port:$subscription_port,
      subscription_service:$subscription_service, subscription_url:$subscription_url,
      country:$country, city:$city, flag:$flag, backends:$backends}'
  return 0
}

quickstart_command() {
  local email="" email_mode="provided"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --email) email="$2"; email_mode="provided"; shift 2 ;;
      --without-email) email=""; email_mode="without"; shift ;;
      *) shift ;;
    esac
  done

  # email нужен только Certbot (ACME-контакт для уведомлений/восстановления).
  # В режиме without передаём --register-unsafely-without-email вместо
  # подстановки фиктивного адреса.
  if [[ "$email_mode" == "provided" ]] && { [[ -z "$email" ]] || ! [[ "$email" =~ ^[^@]+@[^@]+\.[^@]+$ ]]; }; then
    echo '{"ok":false,"error":"Некорректный email (нужен для Let'\''s Encrypt)"}'
    return 1
  fi

  export TERM=dumb
  export DEBIAN_FRONTEND=noninteractive
  export XRAYEBATOR_NONINTERACTIVE=1

  # 1. Миграции (без интерактивных промптов).
  # Список может быть подмножеством main_menu, но КРИТИЧЕСКИЕ для quickstart
  # миграции обязаны быть здесь — иначе на существующих VPS quickstart ломается
  # (например, без mlkem_keys_generated не создастся PQ-маршрут).
  # Синхронизация проверяется validation/test-quickstart-migration-parity.sh.
  echo "=== Миграции ===" >&2
  migrate_remove_legacy_tcp_tuning_v3 >/dev/null 2>&1 || true
  migrate_client_fingerprint_state_2026 >/dev/null 2>&1 || true
  run_migration "xhttp_migrated" "XHTTP host/SNI sync" migrate_xhttp_profiles >/dev/null 2>&1 || true
  run_migration "routing_v132_migrated" "Routing default direct rule" migrate_routing_config >/dev/null 2>&1 || true
  run_migration "legacy_udp443_block_removed_v3" "Remove legacy UDP/443 block" migrate_legacy_managed_udp443_block_v3 >/dev/null 2>&1 || true
  run_migration "xhttp_mode_migrated" "XHTTP mode stream auto" migrate_xhttp_mode >/dev/null 2>&1 || true
  run_migration "xhttp_extra_restored" "XHTTP extra anti-DPI restore" migrate_xhttp_extra_restore >/dev/null 2>&1 || true
  run_migration "transport_profile_metadata_migrated" "Transport profile metadata" migrate_transport_profile_metadata >/dev/null 2>&1 || true
  run_migration "config_optimized" "Config optimization (DNS/log)" migrate_config_optimization >/dev/null 2>&1 || true
  run_migration "xmux_explicit_2026" "Explicit xmux block" migrate_xmux_explicit_2026 >/dev/null 2>&1 || true
  run_migration "mlkem_keys_generated" "PQ ключи VLESS Encryption" _migrate_mlkem_keys >/dev/null 2>&1 || true
  run_migration "xhttp_default_2026" "XHTTP+PQ как дефолтный пресет" _migrate_xhttp_default_2026 >/dev/null 2>&1 || true
  run_migration "subscription_tokens_2026" "Subscription tokens" _migrate_subscription_tokens_2026 >/dev/null 2>&1 || true
  run_migration "happ_legacy_xhttp_route_2026" "HAPP legacy xhttp route" _migrate_happ_legacy_xhttp_route_2026 >/dev/null 2>&1 || true
  run_migration "xhttp_route_path_repair_2026" "XHTTP path repair" _migrate_xhttp_route_path_repair_2026 >/dev/null 2>&1 || true
  run_migration "dead_stealth_routes_pruned_2026" "Prune dead stealth routes" _migrate_dead_stealth_routes_2026 >/dev/null 2>&1 || true
  run_migration "sni_list_2026" "SNI list 2026" _migrate_sni_list_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_multiroute_2026" "Subhttp multiroute handler" _migrate_subhttp_multiroute_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_client_compat_2026" "Subhttp client compat" _migrate_subhttp_client_compat_2026 >/dev/null 2>&1 || true
  run_migration "expire_timer_2026" "Expire enforcement timer" _migrate_expire_timer_2026 >/dev/null 2>&1 || true
  run_migration "bypass_routing_2026" "Bypass routing first-run" _migrate_bypass_routing_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_expired_410_2026" "Subhttp expired 410" _migrate_subhttp_expired_410_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_happ_legacy_xhttp_2026" "Subhttp HAPP legacy XHTTP route" _migrate_subhttp_happ_legacy_xhttp_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_hysteria2_2026" "Subhttp hysteria2 links" _migrate_subhttp_hysteria2_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_happ_xhttp_compat_2026" "Subhttp HAPP XHTTP compat" _migrate_subhttp_happ_xhttp_compat_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_no_default_happ_routing_2026" "Subhttp no default HAPP routing profile" _migrate_subhttp_no_default_happ_routing_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_stale_profiles_410_2026" "Subhttp stale profile 410 handler" _migrate_subhttp_stale_profiles_410_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_managed_happ_routing_2026" "HAPP subscription: managed routing and geo delivery" _migrate_subhttp_managed_happ_routing_2026 >/dev/null 2>&1 || true
  run_migration "xhttp_xmux_throughput_2026" "XHTTP xmux throughput profile" _migrate_xhttp_xmux_throughput_2026 >/dev/null 2>&1 || true
  run_migration "xmux_explicit_2026" "Explicit xmux block" migrate_xmux_explicit_2026 >/dev/null 2>&1 || true
  fix_xray_permissions >/dev/null 2>&1 || true

  # 2. Subscription server (HAPP)
  echo "=== Subscription server ===" >&2
  local sub_rc sub_log
  sub_log=$(install_subscription_server 2>&1 >/dev/null)
  sub_rc=$?
  if [[ "$sub_rc" -ne 0 ]]; then
    local sub_reason
    sub_reason=$(printf '%s' "$sub_log" | grep -E '✗|ошиб|Ошибка|error|failed|Error' | tail -3 | tr '\n' ' ')
    if [[ -z "$sub_reason" ]]; then
      sub_reason=$(printf '%s' "$sub_log" | tail -3 | tr '\n' ' ')
    fi
    echo "{\"ok\":false,\"error\":\"Не удалось установить subscription server: ${sub_reason}\"}"
    return 1
  fi
  printf '%s\n' "$sub_log" >&2
  echo "  Subscription server установлен" >&2

  # 3. nginx + TLS
  echo "=== nginx + TLS ===" >&2

  local server_ip
  server_ip=$(get_server_ip)
  # Accept either IPv4 (dotted-quad) or IPv6 (hex groups, possibly with ::compression).
  # Regex distinguishes at least the most common forms:
  #   IPv4:  1.2.3.4
  #   IPv6:  2001:db8::1, ::1, fe80::a, etc.
  local ipv4_re='^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
  local ipv6_re='^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$'
  if [[ -z "$server_ip" ]] || ! [[ "$server_ip" =~ $ipv4_re || "$server_ip" =~ $ipv6_re ]]; then
    echo '{"ok":false,"error":"Не удалось определить публичный IP VPS (ни IPv4, ни IPv6)"}'
    return 1
  fi

  # A5-fix: IP-режим TLS (certbot --ip-address + shortlived) работает ТОЛЬКО для IPv4.
  # Let's Encrypt не выдаёт IP-сертификаты для IPv6-адресов. На IPv6-only VPS даём
  # понятную ошибку сразу, а не обрываемся на certbot с «проверьте порт 80».
  if [[ "$server_ip" =~ $ipv6_re ]]; then
    echo '{"ok":false,"error":"IP-режим подписки поддерживает только IPv4. Для IPv6-only VPS используйте домен (domain_tls) или HAPP-интерфейс"}'
    return 1
  fi
  local server_ip_bracketed
  server_ip_bracketed=$(_ip_bracket "$server_ip")

  # «Сторона» сервера (страна/город) для GUI и подписи маршрутов в HAPP.
  _geo_detect_country "$server_ip" >/dev/null 2>&1 || true

  # Установить nginx если нет
  if ! command -v nginx &>/dev/null; then
    echo "  -> Установка nginx..." >&2
    # FIX (11.08): фоновые apt-daily/unattended-upgrades держат lock на свежих
    # Ubuntu — без ожидания apt-get висит и quickstart падает с кодом 1 (GUI).
    # FIX (23.09): прогон unattended-upgrades на свежеподнятом VPS занимает
    # ~10 минут (замер: 21:10:39→21:20:23, ~90 пакетов); flock между пакетами
    # свободен секунды и проскакивает гонку, поэтому бюджет ожидания — 12 минут
    # и учёт самого процесса-воркера внутри _apt_wait_lock.
    if ! _apt_wait_lock 720; then
      echo '{"ok":false,"error":"apt занят обновлениями дольше 12 минут (unattended-upgrades). Повторите quickstart чуть позже"}'
      return 1
    fi
    # ВНИМАНИЕ: timeout обязан превышать DPkg::Lock::Timeout=180 внутри apt,
    # иначе внешний kill обрывает ожидание lock раньше времени и воспроизводит
    # исходный баг.
    if ! timeout 300 apt-get "${APT_LOCK_OPTS[@]}" install -y nginx >/dev/null 2>&1; then
      # При пропущенном install.sh (повторный деплой) apt-индексы могут быть
      # устаревшими — обновляем и пробуем ещё раз, прежде чем сдаться.
      echo "  -> apt-get install nginx не удался, обновляю индексы и повторяю..." >&2
      _apt_wait_lock 720 || true
      timeout 180 apt-get update >/dev/null 2>&1 || true
      if ! timeout 300 apt-get "${APT_LOCK_OPTS[@]}" install -y nginx >/dev/null 2>&1; then
        echo '{"ok":false,"error":"apt-get install nginx failed"}'
        return 1
      fi
    fi
  fi

  # Certbot: сначала snap (поддерживает --ip-address + --preferred-profile)
  local certbot_bin=""
  if command -v /snap/bin/certbot &>/dev/null && _certbot_supports_ip_address /snap/bin/certbot; then
    certbot_bin="/snap/bin/certbot"
  elif command -v certbot &>/dev/null && _certbot_supports_ip_address "$(command -v certbot)"; then
    certbot_bin="$(command -v certbot)"
  fi
  if [[ -z "$certbot_bin" ]]; then
    echo "  -> Установка certbot через snap..." >&2
    _apt_wait_lock 300 || true
    timeout 240 apt-get "${APT_LOCK_OPTS[@]}" install -y snapd >/dev/null 2>&1 || true
    systemctl enable --now snapd.socket >/dev/null 2>&1 || true
    export PATH="/snap/bin:$PATH"
    if command -v snap &>/dev/null; then
      timeout 300 snap install core 2>/dev/null || true
      timeout 300 snap install --classic certbot 2>/dev/null || true
      if command -v /snap/bin/certbot &>/dev/null && _certbot_supports_ip_address /snap/bin/certbot; then
        certbot_bin="/snap/bin/certbot"
      fi
    fi
  fi
  if [[ -z "$certbot_bin" ]]; then
    echo '{"ok":false,"error":"Certbot с --ip-address и --preferred-profile не найден"}'
    return 1
  fi
  echo "  Certbot: $certbot_bin" >&2

  # Webroot для ACME
  local webroot="/var/www/xrayebator-ip-acme"
  mkdir -p "$webroot/.well-known/acme-challenge"
  chmod -R 755 "$webroot"

  # P1-nginx-fix: транзакция quickstart-nginx. На любом failure path (nginx -t, certbot,
  # занятый 8443, reload) исходный default-сайт и ранее существовавший vhost
  # xrayebator-sub восстанавливаются из бэкапов, наши изменения убираются, nginx
  # перезагружается. P2-fix: транзакция помечается изменённой СРАЗУ после любой
  # мутации nginx (запись vhost, symlink, удаление default) — независимо от наличия
  # default-сайта; до фикса при отсутствии default-сайта rollback не срабатывал и
  # мёртвый vhost оставался на VPS. Реализация на уровне файла (_qs_nginx_rollback)
  # — ею пользуется и функциональный тест.
  QS_NGINX_MODIFIED=false
  QS_DEFAULT_REMOVED=false
  QS_DEFAULT_BACKUP_CREATED=false
  QS_VHOST_BACKUP="$NGINX_SITES_AVAILABLE/xrayebator-sub.xrayebator.bak.${BASHPID:-$$}"

  # Все обязательные backup создаются и сверяются ДО первой мутации nginx.
  # Ошибка cp/cmp завершает quickstart, не меняя live vhost/default.
  if [[ -e "$NGINX_SITES_AVAILABLE/xrayebator-sub" || -L "$NGINX_SITES_AVAILABLE/xrayebator-sub" ]]; then
    if ! _qs_backup_path "$NGINX_SITES_AVAILABLE/xrayebator-sub" "$QS_VHOST_BACKUP"; then
      echo '{"ok":false,"error":"Не удалось создать проверенный backup nginx vhost; конфигурация не изменена"}'
      return 1
    fi
  fi
  local default_site="$NGINX_SITES_ENABLED/default"
  local default_backup="$NGINX_SITES_ENABLED/default.xrayebator.bak"
  if [[ -e "$default_site" || -L "$default_site" ]]; then
    if [[ -e "$default_backup" || -L "$default_backup" ]] ||
       ! _qs_backup_path "$default_site" "$default_backup"; then
      rm -f -- "$QS_VHOST_BACKUP"
      QS_VHOST_BACKUP=""
      echo '{"ok":false,"error":"Не удалось создать проверенный backup nginx default; конфигурация не изменена"}'
      return 1
    fi
    QS_DEFAULT_BACKUP_CREATED=true
  fi

  # С этого места rollback обязателен даже при ошибке первой записи.
  QS_NGINX_MODIFIED=true
  # Nginx HTTP config для certbot
  if ! cat > "$NGINX_SITES_AVAILABLE/xrayebator-sub" << NGINXHTTP
server {
    listen 80;
    listen [::]:80;
    server_name ${server_ip};
    location ^~ /.well-known/acme-challenge/ {
        root ${webroot};
        default_type text/plain;
    }
    location / {
        return 404;
    }
}
NGINXHTTP
  then
    echo '{"ok":false,"error":"Не удалось записать nginx HTTP config"}'
    _qs_nginx_rollback
    return 1
  fi
  if ! ln -sf "$NGINX_SITES_AVAILABLE/xrayebator-sub" "$NGINX_SITES_ENABLED/xrayebator-sub"; then
    echo '{"ok":false,"error":"Не удалось включить nginx vhost"}'
    _qs_nginx_rollback
    return 1
  fi
  if [[ -e "$default_site" || -L "$default_site" ]]; then
    if ! rm -f -- "$default_site"; then
      rm -f -- "$default_backup"
      QS_DEFAULT_BACKUP_CREATED=false
      echo '{"ok":false,"error":"Не удалось отключить nginx default site"}'
      _qs_nginx_rollback
      return 1
    fi
    QS_DEFAULT_REMOVED=true
  fi
  nginx -t >/dev/null 2>&1 || { echo '{"ok":false,"error":"nginx -t failed"}'; _qs_nginx_rollback; return 1; }
  systemctl enable --now nginx >/dev/null 2>&1 || true
  systemctl reload nginx >/dev/null 2>&1 || true

  # Открыть порты
  if command -v ufw &>/dev/null && ufw status | grep -q "Status: active"; then
    local firewall_port
    for firewall_port in 80 443 8443; do
      if ! open_firewall_port "$firewall_port" tcp; then
        echo '{"ok":false,"error":"Не удалось безопасно открыть UFW rule для quickstart"}'
        _qs_nginx_rollback
        return 1
      fi
    done
  fi

  # A8-fix: переиспользуем существующий действующий сертификат вместо повторного
  # certonly — иначе повторный quickstart упирается в Let's Encrypt rate-limit.
  # IP-серты shortlived (~6 дн.); renew-таймер продлевает их в фоне.
  # SUB_TLS_MODE: ip_tls (LE-серт, HTTPS :8443) | http_tls (degraded fallback —
  # HTTP :8080 наружу). Оба проксируют один и тот же локальный handler.
  local SUB_TLS_MODE="ip_tls"
  local cert_dir="/etc/letsencrypt/live/$server_ip"
  local cert_expiry_ok=0
  local cert_end="" cert_now="" cert_epoch=""
  if [[ -f "$cert_dir/fullchain.pem" && -f "$cert_dir/privkey.pem" ]]; then
    if command -v openssl >/dev/null 2>&1; then
      # Сертификат должен быть выпущен именно для этого IP (проверка SAN).
      # Иначе переиспользуем чужой/старый серт от другого адреса — подписка
      # умрёт на первом же клиенте, а renew-таймер не сможет её оживить.
      local cert_san
      cert_san=$(openssl x509 -in "$cert_dir/fullchain.pem" -noout -ext subjectAltName 2>/dev/null)
      if echo "$cert_san" | grep -qE "IP( Address)?:${server_ip}(,|$)"; then
        cert_end=$(openssl x509 -enddate -noout -in "$cert_dir/fullchain.pem" 2>/dev/null | sed 's/notAfter=//')
        cert_now=$(date -u +%s)
        cert_epoch=$(date -u -d "$cert_end" +%s 2>/dev/null || echo 0)
        # Запас >= 6 часов: renew-таймер (цикл 12ч) успеет обновить серт раньше.
        if [[ -n "$cert_epoch" && "$cert_epoch" -gt $((cert_now + 21600)) ]]; then
          cert_expiry_ok=1
          echo "  -> Сертификат для $server_ip уже действует (до ${cert_end}) — переиспользую, без нового certonly" >&2
        fi
      fi
    else
      cert_expiry_ok=1
    fi
  fi

  if [[ "$cert_expiry_ok" -eq 0 ]]; then
    # Получить TLS сертификат
    echo "  -> Получение TLS сертификата..." >&2
    # ACME-контакт: с email — -m, без — явный unsafely-without-email (без фиктивного адреса).
    local certbot_email_args=()
    if [[ "$email_mode" == "provided" ]]; then
      certbot_email_args=(-m "$email")
    else
      certbot_email_args=(--register-unsafely-without-email)
      echo "  -> Email не указан: регистрация ACME без контактного адреса (уведомлений не будет)" >&2
    fi
    if ! "$certbot_bin" certonly \
        --cert-name "$server_ip" \
        --preferred-profile shortlived \
        --webroot --webroot-path "$webroot" \
        --ip-address "$server_ip" \
        --non-interactive --agree-tos \
        "${certbot_email_args[@]}" \
        --deploy-hook "systemctl reload nginx" \
        >/tmp/certbot-ip.log 2>&1; then
      local certbot_reason
      certbot_reason=$(_certbot_failure_reason /tmp/certbot-ip.log)
      # Fallback 1: certonly упёрся в rate limit (или временную сетевую ошибку), но
      # старый серт всё ещё числится действительным — переиспользуем его, чтобы
      # quickstart не падал, а renew-таймер продолжит попытки продления в фоне.
      if [[ -f "$cert_dir/fullchain.pem" && -f "$cert_dir/privkey.pem" ]] && \
         [[ -n "$cert_epoch" && "$cert_epoch" -gt "$cert_now" ]]; then
        echo "  -> certbot не смог выпустить новый серт, но действующий есть — переиспользую его (${cert_end})" >&2
      else
        # Fallback 2 (http_tls): hoster-уровневая блокировка http-01 (LE validation
        # получает "Connection reset by peer" — порт 80 фильтруется upstream до нашего
        # стека; подтверждено tcpdump + check-host на VPS 150.241.65.101, 2026-10-08).
        # Вместо dead-end: поднимаем подписку по HTTP (handler на 8080 открыт наружу,
        # 404 без токена, токен — bearer) с self-signed сертом для Hysteria и честным
        # маркером degraded в JSON. Повторный quickstart ПОСЛЕ разблокировки :80 у
        # хостера выдаст LE-серт и вернёт ip_tls (идемпотентен).
        SUB_TLS_MODE="http_tls"
        mkdir -p "/etc/letsencrypt/selfsigned/${server_ip}"
        if ! openssl ecparam -genkey -name prime256v1 \
              -out "/etc/letsencrypt/selfsigned/${server_ip}/privkey.pem" 2>/dev/null || \
           ! openssl req -new -x509 -days 3650 \
              -key "/etc/letsencrypt/selfsigned/${server_ip}/privkey.pem" \
              -out "/etc/letsencrypt/selfsigned/${server_ip}/fullchain.pem" \
              -subj "/CN=${server_ip}" 2>/dev/null; then
          echo '{"ok":false,"error":"certbot failed и self-signed fallback не создался. Log: /tmp/certbot-ip.log"}'
          _qs_nginx_rollback
          return 1
        fi
        chmod 600 "/etc/letsencrypt/selfsigned/${server_ip}/privkey.pem" 2>/dev/null || true
        if [[ -n "$certbot_reason" ]]; then
          echo "  -> certbot: ${certbot_reason}" >&2
        fi
        echo "  ⚠ LE не смог проверить http-01 (порт 80 заблокирован upstream хостера)." >&2
        echo "  ⚠ Подписка разворачивается по HTTP (fallback): http://${server_ip}:8080/sub/<token>" >&2
        echo "    Токен URL остаётся bearer-credential; повторите quickstart после разблокировки :80 —" >&2
        echo "    тогда будет выпущен LE-серт и подписка вернётся на HTTPS." >&2
      fi
    else
      SUB_TLS_MODE="ip_tls"
      echo "  TLS сертификат получен" >&2
      # P0-certbot-fix: регистрируем cert в root-owned манифесте (uninstall удалит только его).
      _certbot_register "$server_ip"
    fi
  fi

  # A3-fix: идемпотентность. Проверяем, что порт 8443 не занят ЧУЖИМ процессом.
  # Если на нём слушает nginx и у нас уже создан xrayebator-sub vhost — это наш же
  # повторный запуск (или уже настроенная подписка): переиспользуем, не блокируем.
  local port_8443_owner
  port_8443_owner=$(ss -ltnp 'sport = :8443' 2>/dev/null | grep -oP 'users:\(\("([^"]+)"' | head -1 | sed 's/users:(("//')
  if ss -ltnp 'sport = :8443' 2>/dev/null | grep -q LISTEN; then
    if [[ -n "$port_8443_owner" && "$port_8443_owner" == "nginx" ]] && \
       grep -q "listen 8443" "$NGINX_SITES_AVAILABLE/xrayebator-sub" 2>/dev/null; then
      echo "  -> Порт 8443 уже обслуживается нашим nginx (xrayebator-sub) — переиспользуем" >&2
    else
      echo '{"ok":false,"error":"Порт 8443 уже занят сторонним процессом — subscription URL будет мёртвым"}'
      _qs_nginx_rollback
      return 1
    fi
  fi

  # Nginx config: https (ip_tls: LE-серт, прокси на 8080) или http (http_tls
  # fallback: 8080 открыт напрямую, ACME-challenge на :80 остаётся для
  # будущего апгрейда до LE-серта повторным quickstart).
  if [[ "$SUB_TLS_MODE" == "http_tls" ]]; then
  cat > "$NGINX_SITES_AVAILABLE/xrayebator-sub" << NGINXHTTPSUB
server {
    listen 80;
    listen [::]:80;
    server_name ${server_ip_bracketed};
    # MUST serve ACME http-01 challenge: повторный quickstart после разблокировки
    # :80 выпустит LE-серт и переведёт подписку обратно на HTTPS (ip_tls).
    location ^~ /.well-known/acme-challenge/ {
        root ${webroot};
        default_type text/plain;
    }
    location / {
        return 404;
    }
}
NGINXHTTPSUB
  else
  cat > "$NGINX_SITES_AVAILABLE/xrayebator-sub" << NGINXHTTPS
limit_req_zone \$binary_remote_addr zone=xrayebator_sub:10m rate=30r/m;

server {
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;
    server_name ${server_ip_bracketed};
    ssl_certificate /etc/letsencrypt/live/${server_ip}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${server_ip}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    location / {
        limit_req zone=xrayebator_sub burst=5 nodelay;
        # HAPP routing-профиль легко перерастает дефолтные 4k заголовка:
        # без буферов nginx отвечает 502 "upstream sent too big header".
        # (Идея из PR #23, tony-adamson; латынь та же, что в доменном TLS-шаблоне.)
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    location ^~ /.well-known/acme-challenge/ {
        root ${webroot};
        default_type text/plain;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${server_ip_bracketed};
    # MUST serve ACME http-01 challenge на 80, чтобы renew shortlived IP-сертификата
    # (webroot) продолжал работать, а не уходил в редирект на https.
    location ^~ /.well-known/acme-challenge/ {
        root ${webroot};
        default_type text/plain;
    }
    location / {
        return 301 https://\$host\$request_uri;
    }
}
NGINXHTTPS
  fi
  nginx -t >/dev/null 2>&1 || { echo '{"ok":false,"error":"nginx config failed"}'; _qs_nginx_rollback; return 1; }
  if ! systemctl reload nginx >/dev/null 2>&1; then
    echo '{"ok":false,"error":"nginx не перечитал config — подписка недоступна"}'
    _qs_nginx_rollback
    return 1
  fi

  # Пишем маркеры подписки: ip_tls (LE-серт на :8443) или http_tls (fallback —
  # handler 8080 напрямую). Иначе _subscription_base_url вернёт локальный
  # http://127.0.0.1:8080 и GUI/happ-setup покажут неверный URL и mode "unknown".
  _subscription_write_markers "8443" "$server_ip" "$server_ip" "$SUB_TLS_MODE"

  # Автопродление shortlived IP-сертификатов (~6 дней) — только в ip_tls:
  # в http_tls серта нет, и таймер certbot renew каждый раз падал бы по тому же
  # upstream-фильтру, который и вызвал fallback.
  if [[ "$SUB_TLS_MODE" == "ip_tls" ]]; then
    _install_ip_cert_renew_timer "$certbot_bin" "$server_ip" "$webroot"
  fi

  # 4. Создание профиля
  echo "=== Профиль ===" >&2

  # Определяем порт для Xray (Xray на 443, nginx на 8443)
  # HAPP требует multi-route профиль (schema_version 3, routes[] с 7 маршрутами,
  # включая xhttp-legacy). _happ_ensure_default_multiroute_profile — единый источник
  # истины: создаёт профиль при отсутствии или возвращает существующий.
  # Создание одиночного профиля здесь ломало HAPP ("route not shown / country n/a").
  echo "  Обеспечиваю multi-route HAPP профиль..." >&2
  if ! _happ_ensure_default_multiroute_profile >/dev/null 2>&1; then
    echo '{"ok":false,"error":"Не удалось создать HAPP multi-route профиль"}'
    _qs_nginx_rollback
    return 1
  fi
  local profile_file="$PROFILES_DIR/${HAPP_DEFAULT_PROFILE}.json"

  # Перезапустить Xray (подхватить новые инбаунды маршрутов).
  # Без || true: если конфиг не загрузился, отдаём ok:false, а не ложный успех с мёртвым URL.
  if ! safe_restart_xray >/dev/null 2>&1; then
    echo '{"ok":false,"error":"Не удалось перезапустить Xray — конфиг не принят (xray run -test failed)"}'
    _qs_nginx_rollback
    return 1
  fi

  # Убедиться что subscription handler отвечает.
  if ! _subscription_ensure_handler_running >/dev/null 2>&1; then
    echo '{"ok":false,"error":"Subscription handler не отвечает на 127.0.0.1:8080"}'
    _qs_nginx_rollback
    return 1
  fi

  # 5. Результат
  local result_uuid result_sub_token route_count
  result_uuid=$(jq -r '.uuid' "$profile_file")
  result_sub_token=$(jq -r '.sub_token' "$profile_file")
  route_count=$(jq -r '(.routes // []) | length' "$profile_file" 2>/dev/null || echo 0)

  # URL строим через canonical helper — без хардкода порта.
  # Если ранее был ip_tls на :443 или домен на :443, URL корректно опустит порт.
  local base subscription_url
  base=$(_subscription_base_url)
  # Если .subscription_* markers не созданы (возможно при раннем вызове),
  # fallback на текущий server_ip + 8443 для обратной совместимости.
  if [[ -z "$base" ]] || [[ "$base" == *"127.0.0.1:8080"* && ! -f "/usr/local/etc/xray/.subscription_domain" && ! -f "/usr/local/etc/xray/.subscription_port" ]]; then
    base="https://${server_ip_bracketed}:8443"
  fi
  subscription_url="${base}/sub/${result_sub_token}"

  # «Сторона» сервера для GUI (country/city/flag) + ОС (PRETTY_NAME) — полезно "Мои серверы".
  local result_country result_city result_flag result_os
  result_country=$(_geo_country_name)
  result_city=$(_geo_city)
  result_flag=$(_geo_flag_emoji "$(_geo_country_code)")
  result_os=$(awk -F'"' '/^PRETTY_NAME=/{print $2; exit}' /etc/os-release 2>/dev/null)

  # Транзакция завершена: per-run vhost backup больше не нужен. Backup default
  # остаётся до uninstall, чтобы вернуть исходный сайт.
  rm -f -- "$QS_VHOST_BACKUP" 2>/dev/null || true
  QS_VHOST_BACKUP=""
  QS_NGINX_MODIFIED=false
  QS_DEFAULT_REMOVED=false
  QS_DEFAULT_BACKUP_CREATED=false

  # degraded=true только в http_tls-fallback: сервер работает, но подписка по HTTP
  # (LE не смог проверить http-01 — обычно порт 80 фильтруется хостером). GUI
  # сохраняет сервер с setupStatus=partial и показывает понятную причину.
  if [[ "$SUB_TLS_MODE" == "http_tls" ]]; then
    jq -n \
      --arg url "$subscription_url" --arg base "$base" \
      --arg profile "$HAPP_DEFAULT_PROFILE" --argjson routes "$route_count" \
      --arg country "$result_country" --arg city "$result_city" \
      --arg flag "$result_flag" --arg os "$result_os" \
      --arg cert_reason "${certbot_reason:-}" \
      '{ok:true, degraded:true, tls_mode:"http_tls", certbot_reason:$cert_reason,
        subscription_url:$url, base_url:$base, profile:$profile, routes:$routes,
        country:$country, city:$city, flag:$flag, os:$os}'
    return 0
  fi
  echo "{\"ok\":true,\"subscription_url\":\"${subscription_url}\",\"base_url\":\"${base}\",\"profile\":\"${HAPP_DEFAULT_PROFILE}\",\"routes\":${route_count},\"country\":\"${result_country}\",\"city\":\"${result_city}\",\"flag\":\"${result_flag}\",\"os\":\"${result_os}\"}"
  return 0
}

happ_setup_command() {
  export TERM=dumb
  export DEBIAN_FRONTEND=noninteractive
  export XRAYEBATOR_NONINTERACTIVE=1

  # A6-fix: критически важные миграции, без которых happ-setup падает на чистом VPS.
  # Без _migrate_mlkem_keys xhttp-маршруты идут с pq_enabled=true, а add_inbound
  # отклоняет «PQ ключи отсутствуют». Без subscription_tokens_2026 профиль может не
  # иметь sub_token (для URL подписки). Синхронизировано с quickstart_command.
  echo '=== Миграции ===' >&2
  run_migration "mlkem_keys_generated" "PQ ключи VLESS Encryption" _migrate_mlkem_keys >/dev/null 2>&1 || true
  run_migration "xhttp_default_2026" "XHTTP+PQ как дефолтный пресет" _migrate_xhttp_default_2026 >/dev/null 2>&1 || true
  run_migration "subscription_tokens_2026" "Subscription tokens" _migrate_subscription_tokens_2026 >/dev/null 2>&1 || true
  run_migration "happ_legacy_xhttp_route_2026" "HAPP legacy xhttp route" _migrate_happ_legacy_xhttp_route_2026 >/dev/null 2>&1 || true
  run_migration "subhttp_multiroute_2026" "Subhttp multiroute handler" _migrate_subhttp_multiroute_2026 >/dev/null 2>&1 || true
  fix_xray_permissions >/dev/null 2>&1 || true

  # 1. Убедиться, что subscription server установлен и запущен
  echo '=== Subscription server ===' >&2
  if [[ ! -f /usr/local/etc/xray/.subscription_installed ]]; then
    if ! install_subscription_server >/dev/null 2>&1; then
      echo '{"ok":false,"error":"Не удалось установить subscription server"}'
      return 1
    fi
  fi
  if ! _subscription_restart_service; then
    echo '{"ok":false,"error":"Не удалось запустить xrayebator-sub.service"}'
    return 1
  fi

  # 2. Создать/найти multi-route профиль (7 маршрутов)
  echo '=== HAPP multi-route профиль ===' >&2
  if ! _happ_ensure_default_multiroute_profile >/dev/null 2>&1; then
    echo '{"ok":false,"error":"Не удалось создать HAPP multi-route профиль"}'
    return 1
  fi
  local _profile_name="$HAPP_DEFAULT_PROFILE"
  local _token
  _token=$(jq -r '.sub_token' "$PROFILES_DIR/$_profile_name.json")

  # P1-happ-fix: НЕ фабрикуем markers подписки, если они потеряны. Раньше здесь
  # безусловно писался ip_tls(8443) с текущим server_ip — на свежем VPS без реального
  # сертификата и TLS vhost команда возвращала ok:true с мёртвым https://IP:8443 URL.
  # Теперь: markers восстанавливаются ТОЛЬКО если публичный TLS endpoint реально
  # существует (наш nginx xrayebator-sub слушает 8443 + сертификат выпущен и живой).
  # Иначе — понятная ошибка вместо ложного успеха.
  if [[ ! -f /usr/local/etc/xray/.subscription_domain || ! -f /usr/local/etc/xray/.subscription_port ]]; then
    local _srv_addr
    _srv_addr=$(get_server_ip)
    if _subscription_public_tls_endpoint_verified "$_srv_addr"; then
      _subscription_write_markers "8443" "$_srv_addr" "$_srv_addr" "ip_tls"
    else
      echo "{\"ok\":false,\"error\":\"Публичный TLS endpoint подписки не подтверждён. Выполните 'xrayebator quickstart --email <email>' или настройте подписку через меню — happ-setup не выдаёт мёртвые URL.\"}"
      return 1
    fi
  fi

  # «Сторона» сервера (country/city) — быстрое обновление, если маркер отсутствует/протух.
  _geo_detect_country >/dev/null 2>&1 || true

  # 3. База URL подписки
  local _base
  _base=$(_subscription_base_url)

  local _route_count
  _route_count=$(jq -r '(.routes // []) | length' "$PROFILES_DIR/$_profile_name.json")

  # «Сторона» сервера для GUI (country/city/flag) + ОС.
  local _sub_country _sub_city _sub_flag _sub_os
  _sub_country=$(_geo_country_name)
  _sub_city=$(_geo_city)
  _sub_flag=$(_geo_flag_emoji "$(_geo_country_code)")
  _sub_os=$(awk -F'"' '/^PRETTY_NAME=/{print $2; exit}' /etc/os-release 2>/dev/null)

  echo "{\"ok\":true,\"profile\":\"$_profile_name\",\"routes\":$_route_count,\"subscription_url\":\"${_base}/sub/${_token}\",\"country\":\"${_sub_country}\",\"city\":\"${_sub_city}\",\"flag\":\"${_sub_flag}\",\"os\":\"${_sub_os}\"}"
  return 0
}

# ────────────────────────────────────────────────────────────────────────────────
# CLI для управления профилями (используется GUI «Настройки сервера»).
# Команды переиспользуют примитивы (add_inbound, backup_config, safe_restart_xray)
# и печатают ЧИСТЫЙ JSON в stdout — никаких цветных баннеров и read-пауз.
# ────────────────────────────────────────────────────────────────────────────────

_profile_cli_subscription_url() {
  local token="$1"
  if [[ ! -f /usr/local/etc/xray/.subscription_installed || ! "$token" =~ ^[a-f0-9]{32}$ ]]; then
    return 1
  fi
  echo "$(_subscription_base_url)/sub/${token}"
}

# xrayebator profiles → JSON-массив всех профилей.
profiles_command() {
  export TERM=dumb
  export XRAYEBATOR_NONINTERACTIVE=1

  local base
  base=$(_subscription_base_url 2>/dev/null || true)

  local first=1
  printf '['
  for file in "$PROFILES_DIR"/*.json; do
    [[ -f "$file" ]] || continue
    [[ "$first" -eq 0 ]] && printf ','
    first=0

    local name uuid transport port fingerprint sni created sub_token multi_route rcount pq expire expire_date expire_disabled
    name=$(basename "$file" .json)
    uuid=$(jq -r '.uuid // ""' "$file" 2>/dev/null)
    transport=$(jq -r '.transport // ""' "$file" 2>/dev/null)
    port=$(jq -r '.port // 0' "$file" 2>/dev/null)
    fingerprint=$(jq -r '.fingerprint // ""' "$file" 2>/dev/null)
    sni=$(jq -r '.sni // ""' "$file" 2>/dev/null)
    created=$(jq -r '.created // ""' "$file" 2>/dev/null)
    sub_token=$(jq -r '.sub_token // ""' "$file" 2>/dev/null)
    multi_route=$(jq -r '(.multi_route // false)' "$file" 2>/dev/null)
    rcount=$(jq -r '((.routes // []) | length)' "$file" 2>/dev/null)
    pq=$(jq -r '(.pq_enabled // false)' "$file" 2>/dev/null)
    expire=$(_profile_expire_epoch "$file" 2>/dev/null || printf '0')
    [[ "$expire" =~ ^[0-9]+$ ]] || expire=0
    expire_date=""
    if (( expire > 0 )); then
      expire_date=$(date -d "@$expire" +%F 2>/dev/null || true)
      [[ "$expire_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || expire_date=""
    fi
    if _profile_is_expire_disabled "$file" 2>/dev/null; then
      expire_disabled=true
    else
      expire_disabled=false
    fi
    [[ "$rcount" =~ ^[0-9]+$ ]] || rcount=0

    # Мультибэкенд: аддитивный объект .backends профиля (гранты hysteria2/awg).
    local backends
    backends=$(jq -c '.backends // {}' "$file" 2>/dev/null)
    [[ -n "$backends" ]] || backends="{}"

    local sub_url=""
    if _profile_cli_subscription_url "$sub_token" >/dev/null 2>&1; then
      sub_url="$base/sub/$sub_token"
    fi

    jq -n \
      --arg name "$name" --arg uuid "$uuid" --arg transport "$transport" \
      --argjson port "$port" --arg fingerprint "$fingerprint" --arg sni "$sni" \
      --arg created "$created" --arg sub_token "$sub_token" \
      --argjson multi_route "$multi_route" --argjson routes "$rcount" \
      --argjson pq "$pq" --arg subscription_url "$sub_url" \
      --argjson expire "$expire" --arg expire_date "$expire_date" \
      --argjson expire_disabled "$expire_disabled" \
      --argjson backends "$backends" \
      '{name: $name, uuid: $uuid, transport: $transport, port: $port,
        fingerprint: $fingerprint, sni: $sni, created: $created,
        sub_token: $sub_token, multi_route: $multi_route, routes: $routes,
        pq_enabled: $pq, subscription_url: $subscription_url,
        expire: $expire, expire_date: $expire_date, expire_disabled: $expire_disabled,
        expire_supported: true, backends: $backends}'
  done
  printf ']\n'
  return 0
}

# xrayebator profile-create --name NAME [--transport T] [--port P] [--count N]
#   T: tcp|tcp-utls|tcp-xudp|tcp-mux|grpc|xhttp (по умолчанию xhttp)
#   N: количество копий (по умолчанию 1); имена: name, name-2, name-3, ...
# При N>1 каждый профиль получает отдельный случайный порт (или заданный --port).
profile_create_command() {
  export TERM=dumb
  export DEBIAN_FRONTEND=noninteractive
  export XRAYEBATOR_NONINTERACTIVE=1

  local name="" transport="xhttp" port="" count=1 expire_raw=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --transport) transport="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --count) count="$2"; shift 2 ;;
      --expire) expire_raw="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if [[ -z "$name" ]] || ! [[ "$name" =~ ^[a-zA-Z0-9_-]{1,48}$ ]]; then
    echo '{"ok":false,"error":"Некорректное имя профиля (1-48 симв.: a-z, 0-9, _ -)"}'
    return 1
  fi
  case "$transport" in
    tcp|tcp-utls|tcp-xudp|tcp-mux|grpc|xhttp) ;;
    *)
      echo '{"ok":false,"error":"Некорректный транспорт: tcp|tcp-utls|tcp-xudp|tcp-mux|grpc|xhttp"}'
      return 1
      ;;
  esac
  if ! [[ "$count" =~ ^[0-9]+$ ]] || [[ "$count" -lt 1 ]] || [[ "$count" -gt 50 ]]; then
    echo '{"ok":false,"error":"Некорректное количество (1-50)"}'
    return 1
  fi
  if [[ -n "$port" ]] && ! [[ "$port" =~ ^[0-9]+$ ]] || [[ -n "$port" && "$port" -lt 1 ]] || [[ -n "$port" && "$port" -gt 65535 ]]; then
    echo '{"ok":false,"error":"Некорректный порт (1-65535)"}'
    return 1
  fi
  if [[ -n "$port" && "$port" == "443" && "$transport" =~ ^tcp|tcp-utls|tcp-xudp$ ]]; then
    echo '{"ok":false,"error":"Порт 443 + Vision требует интерактивного подтверждения — используйте меню сервера"}'
    return 1
  fi

  local profile_names=()
  local i
  for ((i=1; i<=count; i++)); do
    if [[ "$i" -eq 1 ]]; then
      profile_names+=("$name")
    else
      profile_names+=("${name}-${i}")
    fi
  done

  local results_file
  results_file=$(mktemp /tmp/xrayebator-create.XXXXXX) || {
    echo '{"ok":false,"error":"mktemp failed"}'
    return 1
  }

  # CLI-режим: статусы helper-функций (backup_config, add_inbound, open_firewall_port,
  # safe_restart_xray) печатают цветной мусор в stdout и ломали JSON-парсинг в GUI.
  # Перенаправляем stdout в stderr на время создания — в stdout попадёт только JSON.
  exec 3>&1
  exec 1>&2

  local created_names=() errors=()
  local expire_value=0
  if [[ -n "$expire_raw" ]]; then
    if ! expire_value=$(_normalize_expire_value "$expire_raw"); then
      exec 1>&3 3>&-
      rm -f "$results_file"
      echo '{"ok":false,"error":"Некорректный --expire: нужен epoch (сек/мс) или дата 2006-12-31[ 23:59]"}'
      return 1
    fi
    local now_epoch
    now_epoch=$(date +%s)
    if [[ "$expire_value" -le "$now_epoch" ]]; then
      exec 1>&3 3>&-
      rm -f "$results_file"
      echo '{"ok":false,"error":"Срок действия уже в прошлом"}'
      return 1
    fi
  fi
  for pname in "${profile_names[@]}"; do
    if [[ -f "$PROFILES_DIR/$pname.json" ]]; then
      errors+=("$pname: уже существует")
      continue
    fi
    if _profile_cli_create_one "$pname" "$transport" "$port" "$results_file" "$expire_value"; then
      created_names+=("$pname")
    else
      errors+=("$pname: не удалось создать")
    fi
  done

  exec 1>&3 3>&-

  jq -n \
    --argjson ok true \
    --argjson names "$(printf '%s\n' "${created_names[@]}" | jq -R -s -c 'split("\n") | map(select(length > 0))')" \
    --argjson error_list "$(printf '%s\n' "${errors[@]}" | jq -R -s -c 'split("\n") | map(select(length > 0))')" \
    '{ok: $ok, names: $names, errors: $error_list}'
  rm -f "$results_file"
  return 0
}

# Один профиль: файл JSON + inbound + safe_restart_xray. Возвращает 0/1.
# $5 — expire (epoch-секунды, 0 = бессрочный).
_profile_cli_create_one() {
  local pname="$1" transport="$2" fixed_port="${3:-}" results_file="${4:-}" expire_value="${5:-0}"
  local uuid sub_token grpc_service_name xhttp_path port default_sni
  uuid=$(uuidgen)
  sub_token=$(openssl rand -hex 16)
  if [[ ! "$sub_token" =~ ^[a-f0-9]{32}$ ]]; then
    echo -e "${RED}✗ Не удалось сгенерировать sub_token${NC}" >&2
    return 1
  fi

  if [[ -n "$fixed_port" ]]; then
    port="$fixed_port"
  else
    local defaults
    defaults=$(build_transport_defaults "$transport") || return 1
    IFS='|' read -r port grpc_service_name xhttp_path <<< "$defaults"
    reserve_port "$port"
  fi

  case "$transport" in
    grpc)
      [[ -z "$grpc_service_name" ]] && grpc_service_name="grpc"
      ;;
    xhttp)
      [[ -z "$xhttp_path" ]] && xhttp_path="/xhttp"
      ;;
  esac

  default_sni=$(_default_sni_for_transport "$transport")
  local fingerprint="$DEFAULT_CLIENT_FINGERPRINT"

  local jq_args=(
    --arg name "$pname"
    --arg uuid "$uuid"
    --arg transport "$transport"
    --argjson port "$port"
    --arg fingerprint "$fingerprint"
    --arg sni "$default_sni"
    --arg sub_token "$sub_token"
    --arg created "$(date +%Y-%m-%d\ %H:%M:%S)"
  )
  local jq_expr='{name: $name, uuid: $uuid, transport: $transport, port: $port, fingerprint: $fingerprint, sni: $sni'
  if [[ "$transport" == "grpc" ]]; then
    jq_args+=(--arg grpc_service_name "$grpc_service_name")
    jq_expr+=', grpc_service_name: $grpc_service_name'
  elif [[ "$transport" == "xhttp" ]]; then
    jq_args+=(--arg xhttp_path "$xhttp_path")
    jq_expr+=', xhttp_path: $xhttp_path'
    jq_args+=(--argjson schema_v 2 --argjson pq_enabled true)
    jq_expr+=', schema_version: $schema_v, pq_enabled: $pq_enabled'
  fi
  jq_expr+=', sub_token: $sub_token, created: $created'
  if [[ "$expire_value" -gt 0 ]]; then
    jq_args+=(--argjson expire "$expire_value")
    jq_expr+=', expire: $expire'
  fi
  jq_expr+='}'
  if ! jq -n "${jq_args[@]}" "$jq_expr" > "$PROFILES_DIR/$pname.json"; then
    rm -f "$PROFILES_DIR/$pname.json"
    echo -e "${RED}✗ Не удалось создать JSON профиля${NC}" >&2
    return 1
  fi

  local rollback_config=""
  if ! backup_config "cli_create_$pname" rollback_config; then
    rm -f "$PROFILES_DIR/$pname.json"
    return 1
  fi

  if ! add_inbound "$uuid" "$transport" "$port" "$default_sni" "$fingerprint" "$grpc_service_name" "$xhttp_path"; then
    rm -f "$PROFILES_DIR/$pname.json"
    echo -e "${RED}✗ Inbound не создан — профиль удалён${NC}" >&2
    return 1
  fi

  if ! safe_restart_xray "$rollback_config"; then
    rm -f "$PROFILES_DIR/$pname.json"
    close_firewall_port "$port"
    echo -e "${RED}✗ Xray не принял конфиг — профиль удалён, конфиг откачен${NC}" >&2
    return 1
  fi

  fix_xray_permissions
  # Мультибэкенд: грант hysteria2 новому профилю (после успешной Xray-части).
  _backend_apply_profile_lifecycle "$pname" created
  local sub_url=""
  if _profile_cli_subscription_url "$sub_token" >/dev/null 2>&1; then
    sub_url="$(_subscription_base_url)/sub/${sub_token}"
  fi
  jq -n \
    --arg name "$pname" --arg uuid "$uuid" --arg transport "$transport" \
    --argjson port "$port" --arg fingerprint "$fingerprint" --arg sni "$default_sni" \
    --arg sub_token "$sub_token" --arg subscription_url "$sub_url" \
    --argjson expire "$expire_value" \
    '{name: $name, uuid: $uuid, transport: $transport, port: $port,
      fingerprint: $fingerprint, sni: $sni, sub_token: $sub_token,
      subscription_url: $subscription_url}
     + (if $expire > 0 then {expire: $expire} else {} end)' >> "$results_file"
  return 0
}

# xrayebator profile-delete --name NAME
profile_delete_command() {
  export TERM=dumb
  export XRAYEBATOR_NONINTERACTIVE=1

  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$name" ]] || { echo '{"ok":false,"error":"Не указано имя профиля (--name)"}'; return 1; }

  local profile_file="$PROFILES_DIR/$name.json"
  if [[ ! -f "$profile_file" ]]; then
    echo '{"ok":false,"error":"Профиль не найден"}'
    return 1
  fi

  local uuid route_count ports_json
  uuid=$(jq -r '.uuid // empty' "$profile_file")
  route_count=$(_profile_route_count "$profile_file")
  if [[ "$route_count" =~ ^[0-9]+$ ]] && [[ "$route_count" -gt 0 ]]; then
    ports_json=$(jq -c '[.routes[]?.port | select(type == "number")] | unique' "$profile_file" 2>/dev/null)
  else
    ports_json=$(jq -c '[.port | select(type == "number")] | unique' "$profile_file" 2>/dev/null)
  fi

  if [[ -z "$uuid" || "$uuid" == "null" ]] ||
     ! jq -e 'type == "array" and length > 0' <<< "$ports_json" >/dev/null 2>&1; then
    echo '{"ok":false,"error":"Профиль повреждён: нет корректных uuid/port"}'
    return 1
  fi

  # CLI-режим: статусы helpers (backup_config, safe_restart_xray, close_firewall_port)
  # печатают цветной мусор в stdout и ломали JSON-парсинг в GUI — душим их в stderr.
  # Redirect ДО backup_config: её цветная строка тоже мусор для парсера GUI.
  exec 3>&1
  exec 1>&2

  local rollback_config=""
  if ! backup_config "cli_delete_$name" rollback_config; then
    echo '{"ok":false,"error":"Не удалось создать бэкап config.json"}' >&3
    exec 1>&3 3>&-
    return 1
  fi

  if ! _remove_profile_uuid_from_config "$uuid" "$ports_json"; then
    echo '{"ok":false,"error":"Ошибка обновления конфига"}' >&3
    exec 1>&3 3>&-
    return 1
  fi

  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    echo '{"ok":false,"error":"Xray не принял конфиг — изменения откачены"}' >&3
    exec 1>&3 3>&-
    return 1
  fi

  exec 1>&3 3>&-

  if ! rm -f "$profile_file" || [[ -e "$profile_file" ]]; then
    echo '{"ok":false,"error":"Не удалось удалить profile JSON"}'
    return 1
  fi

  local p
  while IFS= read -r p; do
    if ! close_firewall_port "$p" >&2; then
      echo "{\"ok\":true,\"name\":\"$name\",\"warning\":\"Не удалось закрыть порт $p\"}"
      return 0
    fi
  done < <(jq -r '.[]' <<< "$ports_json")

  fix_xray_permissions
  # Мультибэкенд: снятие грантов удалённого профиля (реген по оставшимся).
  _backend_apply_profile_lifecycle "$name" deleted
  echo "{\"ok\":true,\"name\":\"$name\"}"
  return 0
}

# xrayebator profile-revoke --name NAME [--full]
#   без --full: перевыпуск sub_token (старая URL подписки умирает, uuid жив);
#   --full: + новый uuid во всех inbound'ах портов профиля — уже скачанные
#   конфиги отваливаются немедленно (реальный ремонт утечки ссылки в чат).
profile_revoke_command() {
  export TERM=dumb
  export XRAYEBATOR_NONINTERACTIVE=1

  local name="" full=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --full) full=true; shift ;;
      *) shift ;;
    esac
  done

  if [[ -z "$name" ]] || ! [[ "$name" =~ ^[a-zA-Z0-9_-]{1,48}$ ]]; then
    echo '{"ok":false,"error":"Некорректное имя профиля (1-48 симв.: a-z, 0-9, _ -)"}'
    return 1
  fi

  local profile_file="$PROFILES_DIR/$name.json"
  if [[ ! -f "$profile_file" ]]; then
    echo "{\"ok\":false,\"error\":\"Профиль $name не найден\"}"
    return 1
  fi

  local new_token
  new_token=$(openssl rand -hex 16)
  if [[ ! "$new_token" =~ ^[a-f0-9]{32}$ ]]; then
    echo '{"ok":false,"error":"Не удалось сгенерировать sub_token"}'
    return 1
  fi

  local old_uuid="" new_uuid="" ports_json=""
  if [[ "$full" == "true" ]]; then
    old_uuid=$(jq -r '.uuid // empty' "$profile_file")
    if [[ -z "$old_uuid" ]]; then
      echo '{"ok":false,"error":"Профиль повреждён: нет uuid"}'
      return 1
    fi
    new_uuid=$(uuidgen)
    if [[ ! "$new_uuid" =~ ^[0-9a-fA-F-]{36}$ ]]; then
      echo '{"ok":false,"error":"Не удалось сгенерировать uuid"}'
      return 1
    fi
    ports_json=$(_profile_ports_json "$profile_file")
    if ! jq -e 'type == "array" and length > 0' <<< "$ports_json" >/dev/null 2>&1; then
      echo '{"ok":false,"error":"Профиль повреждён: нет корректных портов"}'
      return 1
    fi
    # Полный отзыв должен выключать и уже истёкший по сроку профиль.
    if _profile_is_expire_disabled "$profile_file"; then
      echo '{"ok":false,"error":"Профиль отключён по сроку — сначала продлите срок (profile-expire)"}'
      return 1
    fi
  fi

  # CLI-режим: статусы helpers (backup_config, safe_restart_xray, safe_jq_write)
  # печатают цветной мусор в stdout — душим в stderr (контракт JSON-only).
  # Бэкап тоже внутри redirect: его "-> Бэкап конфига" иначе ломает JSON.
  exec 3>&1
  exec 1>&2

  local rollback_config=""
  if ! backup_config "cli_revoke_$name" rollback_config; then
    echo '{"ok":false,"error":"Не удалось создать бэкап config.json"}' >&3
    exec 1>&3 3>&-
    return 1
  fi

  # Профиль-JSON: новый токен всегда; при --full ещё и uuid (top-level + routes).
  # Порядок при full: сначала конфиг+рестарт, потом профиль; сбой записи профиля
  # при full откатывает конфиг — иначе uuid разедутся.
  local jq_args=(--arg t "$new_token")
  local jq_expr='.sub_token = $t'
  if [[ "$full" == "true" ]]; then
    jq_args+=(--arg old "$old_uuid" --arg new "$new_uuid")
    # ВАЖНО: (.routes // []) |= map(...) — невалидный path в jq («Invalid path
    # expression with result []» на single-route профилях, где routes = null).
    # Каноничный guard has("routes") — как в update_all_profiles_on_port.
    jq_expr+=' | .uuid = $new | if has("routes") then .routes |= map(if .uuid? == $old then .uuid = $new else . end) else . end'

    if ! _replace_uuid_in_config "$old_uuid" "$new_uuid" "$ports_json"; then
      echo '{"ok":false,"error":"Не удалось обновить clients в config.json"}' >&3
      exec 1>&3 3>&-
      return 1
    fi
    if ! safe_restart_xray "$rollback_config"; then
      echo '{"ok":false,"error":"Xray не принял конфиг — изменения откачены"}' >&3
      exec 1>&3 3>&-
      return 1
    fi
  fi

  if ! safe_jq_write "${jq_args[@]}" "$jq_expr" "$profile_file"; then
    if [[ "$full" == "true" ]]; then
      # Полусостояние недопустимо: конфиг уже с новым uuid, профиль — со старым.
      # Откатываем config.json из бэкапа транзакции.
      if [[ -n "$rollback_config" && -f "$rollback_config" ]]; then
        cp "$rollback_config" "$CONFIG_FILE"
        safe_restart_xray ""
      fi
    fi
    echo '{"ok":false,"error":"Не удалось записать profile JSON"}' >&3
    exec 1>&3 3>&-
    return 1
  fi
  chown root:root "$profile_file" 2>/dev/null || true

  fix_xray_permissions
  exec 1>&3 3>&-

  # Мультибэкенд: ротация грантов (hysteria2-пароль) при отзыве.
  _backend_apply_profile_lifecycle "$name" revoked
  local sub_url="" base
  base=$(_subscription_base_url 2>/dev/null || true)
  if [[ -n "$base" ]] && _profile_cli_subscription_url "$new_token" >/dev/null 2>&1; then
    sub_url="${base}/sub/${new_token}"
  fi
  jq -n \
    --arg name "$name" --arg token "$new_token" --arg url "$sub_url" \
    --argjson full "$full" --arg uuid "$new_uuid" \
    '{ok: true, name: $name, full: $full, sub_token: $token,
      subscription_url: $url}
     + (if $full then {uuid: $uuid} else {} end)'
  return 0
}

# ═══════════════════════════════════════════════════════════
# CLI сроков действия профилей (profile-expire / expire-check).
# Принуждение серверное: systemd-таймер раз в 10 мин вызывает expire-check,
# который удаляет клиента истёкшего профиля из inbound'ов (снимок в .expire_clients)
# и возвращает обратно при продлении. subhttp отдаёт .expire как subscription-userinfo.
# ═══════════════════════════════════════════════════════════

# xrayebator profile-expire --name NAME --expire VALUE|none
#   VALUE: unix-секунды | unix-мс (13 цифр) | "ГГГГ-ММ-ДД" | "ГГГГ-ММ-ДД HH:MM".
#   none — снять срок (вечный профиль). Смена статуса перезапускает xray.
profile_expire_command() {
  export TERM=dumb
  export XRAYEBATOR_NONINTERACTIVE=1

  local name="" raw=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --expire) raw="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if [[ -z "$name" ]] || ! [[ "$name" =~ ^[a-zA-Z0-9_-]{1,48}$ ]]; then
    echo '{"ok":false,"error":"Некорректное имя профиля (1-48 симв.: a-z, 0-9, _ -)"}'
    return 1
  fi
  if [[ -z "$raw" ]]; then
    echo '{"ok":false,"error":"Укажите --expire ГГГГ-ММ-ДД|epoch|none"}'
    return 1
  fi

  local expire=0
  if [[ "$raw" != "none" ]]; then
    if ! expire=$(_normalize_expire_value "$raw"); then
      echo '{"ok":false,"error":"Некорректный срок: нужен epoch (сек/мс) или дата 2006-12-31[ 23:59]"}'
      return 1
    fi
  fi

  local profile_file="$PROFILES_DIR/$name.json"
  if [[ ! -f "$profile_file" ]]; then
    echo "{\"ok\":false,\"error\":\"Профиль $name не найден\"}"
    return 1
  fi

  local now action=""
  now=$(date +%s)
  if [[ "$expire" -gt 0 && "$expire" -le "$now" ]]; then
    # Профиль уже помечен отключённым, но клиента снова нашли в конфиге
    # (вмешательство руками) — бан нужно наложить заново.
    if ! _profile_is_expire_disabled "$profile_file" || _profile_client_in_config "$profile_file"; then
      action="disable"
    fi
  else
    if _profile_is_expire_disabled "$profile_file"; then action="enable"; fi
  fi

  # Тот же контракт JSON-only: backup_config печатает статус — только после switch.
  exec 3>&1
  exec 1>&2

  local rollback_config=""
  if [[ -n "$action" ]] && ! backup_config "cli_expire_$name" rollback_config; then
    echo '{"ok":false,"error":"Не удалось создать бэкап config.json"}' >&3
    exec 1>&3 3>&-
    return 1
  fi

  if ! safe_jq_write --argjson e "$expire" \
      'if $e == 0 then del(.expire) else .expire = $e end' "$profile_file"; then
    echo "{\"ok\":false,\"error\":\"Не удалось записать expire в профиль\"}" >&3
    exec 1>&3 3>&-
    return 1
  fi
  chown root:root "$profile_file" 2>/dev/null || true

  local apply_rc=0
  if [[ "$action" == "disable" ]]; then
    _expire_disable_profile "$profile_file" || apply_rc=1
  elif [[ "$action" == "enable" ]]; then
    _expire_enable_profile "$profile_file" || apply_rc=1
  fi

  if [[ "$apply_rc" -ne 0 ]]; then
    echo "{\"ok\":false,\"error\":\"Не удалось применить отключение/включение профиля\"}" >&3
    exec 1>&3 3>&-
    return 1
  fi

  if [[ -n "$action" ]]; then
    fix_xray_permissions
    if ! safe_restart_xray "$rollback_config"; then
      echo '{"ok":false,"error":"Xray не принял конфиг — изменения откачены"}' >&3
      exec 1>&3 3>&-
      return 1
    fi
  fi
  exec 1>&3 3>&-

  local expired=false
  [[ "$expire" -gt 0 && "$expire" -le "$now" ]] && expired=true
  jq -n --arg name "$name" --argjson e "$expire" --argjson expired "$expired" \
    '{ok: true, name: $name, expire: $e, expired: $expired}'
  return 0
}

# xrayebator expire-check — пакетное принуждение сроков (вызывается таймером
# xrayebator-expire.timer и вручную). Идемпотентен: без изменений — без рестарта.
expire_check_command() {
  export TERM=dumb
  export XRAYEBATOR_NONINTERACTIVE=1

  local now
  now=$(date +%s)

  # Проход 1: только классификация (никаких мутаций конфига до общего бэкапа).
  local -a disable_files=() enable_files=()
  local profile_file expire
  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ -f "$profile_file" ]] || continue
    expire=$(_profile_expire_epoch "$profile_file" 2>/dev/null) || continue
    [[ "$expire" =~ ^[0-9]+$ ]] || continue
    if [[ "$expire" -gt 0 && "$expire" -le "$now" ]]; then
      # Кандидат на бан: не помечен ИЛИ помечен, но клиент снова в конфиге.
      if ! _profile_is_expire_disabled "$profile_file" || _profile_client_in_config "$profile_file"; then
        disable_files+=("$profile_file")
      fi
    elif _profile_is_expire_disabled "$profile_file"; then
      enable_files+=("$profile_file")
    fi
  done

  if [[ ${#disable_files[@]} -eq 0 && ${#enable_files[@]} -eq 0 ]]; then
    echo '{"ok":true,"disabled":[],"enabled":[]}'
    return 0
  fi

  exec 3>&1
  exec 1>&2

  local rollback_config=""
  if ! backup_config "expire_check" rollback_config; then
    echo '{"ok":false,"error":"Не удалось создать бэкап config.json"}' >&3
    exec 1>&3 3>&-
    return 1
  fi

  local -a done_disable=() done_enable=()
  for profile_file in "${disable_files[@]}"; do
    if _expire_disable_profile "$profile_file"; then
      done_disable+=("$(basename "$profile_file" .json)")
    fi
  done
  for profile_file in "${enable_files[@]}"; do
    if _expire_enable_profile "$profile_file"; then
      done_enable+=("$(basename "$profile_file" .json)")
    fi
  done

  fix_xray_permissions
  if ! safe_restart_xray "$rollback_config"; then
    echo '{"ok":false,"error":"Xray не принял конфиг — изменения откачены"}' >&3
    exec 1>&3 3>&-
    return 1
  fi
  exec 1>&3 3>&-

  jq -n \
    --argjson d "$(printf '%s\n' "${done_disable[@]}" | jq -R . | jq -s 'map(select(length > 0))')" \
    --argjson e "$(printf '%s\n' "${done_enable[@]}" | jq -R . | jq -s 'map(select(length > 0))')" \
    '{ok: true, disabled: $d, enabled: $e}'
  return 0
}

# systemd-таймер принуждения expire (2 unit'а, root-контекст: мутит config.json).
# Контракт no-op: таймер уже включён и ExecStart актуален → return 1 (no-op),
# установка прошла → return 0. Совпадает с контрактом run_migration.
_install_expire_timer() {
  local unit=/etc/systemd/system/xrayebator-expire.service
  local timer=/etc/systemd/system/xrayebator-expire.timer

  if [[ -f "$unit" && -f "$timer" ]] \
     && grep -q "ExecStart=/usr/local/bin/xrayebator expire-check" "$unit" \
     && systemctl is-enabled --quiet xrayebator-expire.timer 2>/dev/null; then
    return 1
  fi

  cat > "$unit" << 'SVCEOF'
[Unit]
Description=Xrayebator: enforce profile expiry dates
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/xrayebator expire-check
IOSchedulingClass=idle
SVCEOF
  chmod 644 "$unit"
  chown root:root "$unit" || return 2

  cat > "$timer" << 'TMREOF'
[Unit]
Description=Run Xrayebator profile-expiry enforcement every 10 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
AccuracySec=1min

[Install]
WantedBy=timers.target
TMREOF
  chmod 644 "$timer"
  chown root:root "$timer" || return 2

  systemctl daemon-reload || return 2
  systemctl enable --now xrayebator-expire.timer >/dev/null 2>&1 || return 2
  return 0
}

