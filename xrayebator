# Check whether a profile has route array
profile_has_routes() {
  local profile_file=$1
  jq -e '(.routes // []) | length > 0' "$profile_file" >/dev/null 2>&1
}

# Select one route from a multi-route profile.
# Sets global SELECTED_ROUTE_INDEX on success.
select_route_for_profile() {
  local profile_file=$1
  local action_label=${2:-"изменения"}
  local route_count
  route_count=$(_profile_route_count "$profile_file")
  SELECTED_ROUTE_INDEX=""

  if [[ ! "$route_count" =~ ^[0-9]+$ ]] || [[ "$route_count" -le 0 ]]; then
    return 1
  fi

  echo ""
  echo -e "${YELLOW}Профиль содержит несколько маршрутов. Выберите маршрут для ${action_label}:${NC}\n"
  jq -r '
    to_entries[] |
    "  \(.key + 1)) \(.value.label // .value.transport): \(.value.transport) :\(.value.port) sni=\(.value.sni // "n/a") fp=\(.value.fingerprint // "firefox")"
  ' < <(jq '.routes // []' "$profile_file")
  echo -e "  ${CYAN}0)${NC} Назад"
  echo ""
  echo -n -e "${YELLOW}Маршрут: ${NC}"
  local route_choice
  read -r route_choice
  [[ "$route_choice" == "0" ]] && return 1
  if [[ ! "$route_choice" =~ ^[0-9]+$ ]] || [[ "$route_choice" -lt 1 ]] || [[ "$route_choice" -gt "$route_count" ]]; then
    echo -e "${RED}✗ Неверный выбор маршрута${NC}"
    sleep 2
    return 1
  fi

  SELECTED_ROUTE_INDEX=$((route_choice - 1))
  return 0
}

# Check if a profile references a port either as top-level profile port or route port.
profile_uses_port() {
  local profile_file=$1
  local port=$2
  jq -e --argjson port "$port" '
    (.port == $port) or any((.routes // [])[]; .port == $port)
  ' "$profile_file" >/dev/null 2>&1
}

# Get list of profile names using a specific port
# Args: $1=port
# Returns: space-separated profile names
get_profiles_on_port() {
  local port=$1
  local profiles=()

  for pf in "$PROFILES_DIR"/*.json; do
    [[ ! -f "$pf" ]] && continue
    [[ "$pf" == *"_test.json" ]] && continue

    if profile_uses_port "$pf" "$port"; then
      profiles+=("$(basename "$pf" .json)")
    fi
  done

  echo "${profiles[@]}"
}

# Update field for all profiles on a specific port
# Args: $1=port, $2=field, $3=value
update_all_profiles_on_port() {
  local port=$1
  local field=$2
  local value=$3

  local profiles=($(get_profiles_on_port "$port"))
  local ok=true

  for pname in "${profiles[@]}"; do
    local pfile="$PROFILES_DIR/$pname.json"
    if safe_jq_write --argjson port "$port" --arg f "$field" --arg v "$value" '
      if .port == $port then .[$f] = $v else . end |
      if has("routes") then .routes |= map(if .port == $port then .[$f] = $v else . end) else . end
    ' "$pfile"; then
      echo -e "${CYAN}  → Обновлен: ${YELLOW}$pname${NC}"
    else
      echo -e "${RED}  ✗ Ошибка обновления: ${YELLOW}$pname${NC}"
      ok=false
    fi
  done
  [[ "$ok" == "true" ]]
}

# Update the client-side Reality fingerprint for exactly one profile route.
# Fingerprint controls the client's TLS ClientHello and is not an inbound/port setting.
# For route 0, keep the legacy top-level mirror in sync for older readers.
update_profile_fingerprint() {
  local profile_file=$1
  local route_index=$2
  local fingerprint=$3

  if [[ -n "$route_index" ]]; then
    safe_jq_write --argjson i "$route_index" --arg fp "$fingerprint" '
      if (.routes[$i] // null) == null then
        error("route not found")
      else
        .routes[$i].fingerprint = $fp |
        if $i == 0 then .fingerprint = $fp else . end
      end
    ' "$profile_file"
  else
    safe_jq_write --arg fp "$fingerprint" '.fingerprint = $fp' "$profile_file"
  fi
}

# Update the stored port for every profile/route that references old_port.
update_all_profiles_port_reference() {
  local old_port=$1
  local new_port=$2

  local profiles=($(get_profiles_on_port "$old_port"))
  local ok=true
  local pname
  for pname in "${profiles[@]}"; do
    local pfile="$PROFILES_DIR/$pname.json"
    if safe_jq_write --argjson old_port "$old_port" --argjson new_port "$new_port" '
      if .port == $old_port then .port = $new_port else . end |
      if has("routes") then .routes |= map(if .port == $old_port then .port = $new_port else . end) else . end
    ' "$pfile"; then
      echo -e "${CYAN}  → Обновлен порт: ${YELLOW}$pname${NC}"
    else
      echo -e "${RED}  ✗ Ошибка обновления порта: ${YELLOW}$pname${NC}"
      ok=false
    fi
  done
  [[ "$ok" == "true" ]]
}

# Проверяет отдельный sysctl.d-файл по одному из двух точных шаблонов,
# которые выпускал Xrayebator. Изменённый оператором файл удалять нельзя.
_is_known_legacy_tcp_tuning_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || return 1

  local content minimal extended
  content=$(<"$path") || return 1
  minimal=$'# Xrayebator minimal TCP tuning\nnet.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr'
  extended=$'# Xrayebator extended TCP tuning\nnet.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr\nnet.ipv4.tcp_fastopen=3\nnet.ipv4.tcp_slow_start_after_idle=0\nnet.ipv4.tcp_notsent_lowat=16384\nnet.ipv4.tcp_rmem=4096 87380 16777216\nnet.ipv4.tcp_wmem=4096 65536 16777216\nnet.core.rmem_max=16777216\nnet.core.wmem_max=16777216\nnet.core.rmem_default=1048576\nnet.core.wmem_default=1048576\nnet.ipv4.ip_local_port_range=1024 65535\nnet.ipv4.tcp_max_tw_buckets=2000000\nnet.ipv4.tcp_fin_timeout=10\nnet.ipv4.tcp_keepalive_time=600\nnet.ipv4.tcp_keepalive_intvl=30\nnet.ipv4.tcp_keepalive_probes=3\nnet.ipv4.tcp_mtu_probing=1\nnet.ipv4.tcp_syncookies=1\nnet.core.netdev_max_backlog=16384\nnet.ipv4.tcp_max_syn_backlog=8192'

  [[ "$content" == "$minimal" || "$content" == "$extended" ]]
}

# Удаляет только исторический блок, который старые версии добавляли в
# /etc/sysctl.conf после собственного marker-комментария.
# Returns: 0=block removed, 1=no block, 2=unexpected/unsafe block.
_strip_legacy_tcp_tuning_block() {
  local source_file="$1"
  local target_file="$2"

  awk '
    function is_known_key(line) {
      return line ~ /^net\.(core\.(default_qdisc|rmem_max|wmem_max|rmem_default|wmem_default|netdev_max_backlog)|ipv4\.(tcp_congestion_control|tcp_fastopen|tcp_slow_start_after_idle|tcp_notsent_lowat|tcp_rmem|tcp_wmem|ip_local_port_range|tcp_max_tw_buckets|tcp_fin_timeout|tcp_keepalive_time|tcp_keepalive_intvl|tcp_keepalive_probes|tcp_mtu_probing|tcp_syncookies|tcp_max_syn_backlog))=/
    }
    $0 == "# BBR TCP Congestion Control Optimization" {
      if (inside || found) {
        bad = 1
      }
      inside = 1
      found = 1
      next
    }
    inside && is_known_key($0) { next }
    inside && $0 ~ /^[[:space:]]*$/ {
      inside = 0
      next
    }
    inside {
      bad = 1
      inside = 0
    }
    { print }
    END {
      if (bad) {
        exit 2
      }
      if (!found) {
        exit 1
      }
    }
  ' "$source_file" > "$target_file"
}

_find_persistent_bbr_sources() {
  local scan_paths="${1:-$SYSCTL_SCAN_PATHS}"
  local -a paths
  local path candidate
  IFS=':' read -r -a paths <<< "$scan_paths"

  for path in "${paths[@]}"; do
    if [[ -f "$path" && ! -L "$path" ]]; then
      if grep -Eq '^[[:space:]]*net\.ipv4\.tcp_congestion_control[[:space:]]*=[[:space:]]*bbr([[:space:]]*(#.*)?)?$' "$path"; then
        printf '%s\n' "$path"
      fi
      continue
    fi
    [[ -d "$path" && ! -L "$path" ]] || continue
    for candidate in "$path"/*.conf; do
      [[ -f "$candidate" && ! -L "$candidate" ]] || continue
      if grep -Eq '^[[:space:]]*net\.ipv4\.tcp_congestion_control[[:space:]]*=[[:space:]]*bbr([[:space:]]*(#.*)?)?$' "$candidate"; then
        printf '%s\n' "$candidate"
      fi
    done
  done
}

# Одноразовая host-state migration для v3.0.
# Удаляет только точные файлы/блоки, созданные старыми версиями Xrayebator,
# немедленно уводит активный congestion control с BBR и не трогает чужие
# sysctl-конфиги. При чужом persistent BBR marker не ставится: миграция
# предупредит оператора и повторит проверку при следующем запуске.
migrate_remove_legacy_tcp_tuning_v3() {
  local marker="${1:-$HOST_TUNING_MIGRATION_MARKER}"
  local legacy_file="${2:-$LEGACY_TCP_TUNING_FILE}"
  local sysctl_conf="${3:-$SYSTEM_SYSCTL_CONF}"
  local active_file="${4:-$TCP_CC_ACTIVE_FILE}"
  local available_file="${5:-$TCP_CC_AVAILABLE_FILE}"
  local scan_paths="${6:-$SYSCTL_SCAN_PATHS}"
  local expected_uid="${7:-0}"

  if [[ -L "$marker" ]]; then
    echo -e "${RED}  ✗ Migration marker не должен быть symlink: $marker${NC}"
    return 1
  fi
  [[ -f "$marker" ]] && return 0
  if [[ -e "$marker" ]]; then
    echo -e "${RED}  ✗ Migration marker имеет неожиданный тип: $marker${NC}"
    return 1
  fi

  echo -e "${MAGENTA}[migration] Удаление legacy BBR/TCP tuning${NC}"

  local backup_dir=""
  local candidate=""
  local current_cc=""
  local available_cc=""
  local target_cc=""
  local remaining_sources=""
  local strip_rc=0
  local unsafe_config=0

  if [[ -e "$legacy_file" || -L "$legacy_file" ]]; then
    if [[ -L "$legacy_file" || ! -f "$legacy_file" ]] \
       || [[ "$(stat -c %u "$legacy_file" 2>/dev/null)" != "$expected_uid" ]] \
       || ! _is_known_legacy_tcp_tuning_file "$legacy_file"; then
      echo -e "${RED}  ✗ Неизвестный или изменённый файл оставлен без изменений: $legacy_file${NC}"
      unsafe_config=1
    else
      mkdir -p "$XRAY_BACKUPS_DIR" || return 1
      backup_dir=$(mktemp -d "$XRAY_BACKUPS_DIR/host-tuning-v3.XXXXXX") || return 1
      chmod 0700 "$backup_dir"
      cp -a -- "$legacy_file" "$backup_dir/99-xrayebator-tcp.conf" || return 1
      rm -f -- "$legacy_file" || return 1
      echo -e "${GREEN}  ✓ Удалён legacy sysctl.d-файл Xrayebator${NC}"
    fi
  fi

  if [[ -e "$sysctl_conf" || -L "$sysctl_conf" ]]; then
    if [[ -L "$sysctl_conf" || ! -f "$sysctl_conf" ]] \
       || [[ "$(stat -c %u "$sysctl_conf" 2>/dev/null)" != "$expected_uid" ]]; then
      echo -e "${RED}  ✗ Небезопасный системный конфиг оставлен без изменений: $sysctl_conf${NC}"
      unsafe_config=1
    else
      candidate=$(mktemp "$(dirname "$sysctl_conf")/.xrayebator-sysctl.XXXXXX") || return 1
      _strip_legacy_tcp_tuning_block "$sysctl_conf" "$candidate" || strip_rc=$?
      if [[ "$strip_rc" -eq 0 ]]; then
        if [[ -z "$backup_dir" ]]; then
          mkdir -p "$XRAY_BACKUPS_DIR" || { rm -f -- "$candidate"; return 1; }
          backup_dir=$(mktemp -d "$XRAY_BACKUPS_DIR/host-tuning-v3.XXXXXX") || {
            rm -f -- "$candidate"
            return 1
          }
          chmod 0700 "$backup_dir"
        fi
        cp -a -- "$sysctl_conf" "$backup_dir/sysctl.conf" || {
          rm -f -- "$candidate"
          return 1
        }
        chmod --reference="$sysctl_conf" "$candidate" \
          && chown --reference="$sysctl_conf" "$candidate" \
          && mv -fT -- "$candidate" "$sysctl_conf" || {
            rm -f -- "$candidate"
            return 1
          }
        echo -e "${GREEN}  ✓ Удалён legacy-блок Xrayebator из sysctl.conf${NC}"
      elif [[ "$strip_rc" -eq 1 ]]; then
        rm -f -- "$candidate"
      else
        rm -f -- "$candidate"
        unsafe_config=1
        echo -e "${RED}  ✗ Legacy sysctl-блок изменён вручную; файл оставлен без изменений${NC}"
      fi
    fi
  fi

  if [[ ! -r "$active_file" || ! -r "$available_file" ]]; then
    echo -e "${RED}  ✗ Ядро не предоставляет congestion-control state${NC}"
    return 1
  fi
  current_cc=$(<"$active_file")
  available_cc=$(<"$available_file")

  if [[ "$current_cc" == "bbr" ]]; then
    if [[ " $available_cc " == *" cubic "* ]]; then
      target_cc="cubic"
    elif [[ " $available_cc " == *" reno "* ]]; then
      target_cc="reno"
    else
      echo -e "${RED}  ✗ Не найден безопасный congestion-control fallback (cubic/reno)${NC}"
      return 1
    fi

    if ! sysctl -q -w "net.ipv4.tcp_congestion_control=$target_cc"; then
      echo -e "${RED}  ✗ Не удалось переключить congestion control на $target_cc${NC}"
      [[ -n "$backup_dir" ]] \
        && echo -e "${YELLOW}    Persistent-настройки удалены; backup: $backup_dir${NC}"
      return 1
    fi
    current_cc=$(<"$active_file")
    if [[ "$current_cc" == "bbr" ]]; then
      echo -e "${RED}  ✗ Congestion control остался BBR после переключения${NC}"
      return 1
    fi
    echo -e "${GREEN}  ✓ Активный congestion control: $current_cc${NC}"
  fi

  remaining_sources=$(_find_persistent_bbr_sources "$scan_paths")
  if [[ -n "$remaining_sources" ]]; then
    echo -e "${RED}  ✗ BBR задан сторонним sysctl-конфигом; файл не изменён:${NC}"
    printf '%s\n' "$remaining_sources" | sed 's/^/    /'
    echo -e "${YELLOW}    Удалите настройку вручную; migration повторится при следующем запуске.${NC}"
    return 1
  fi

  if [[ "$unsafe_config" -ne 0 ]]; then
    echo -e "${YELLOW}  ⚠ Часть persistent-конфигов требует ручной проверки; marker не установлен.${NC}"
    return 1
  fi

  mkdir -p "$(dirname "$marker")" || return 1
  if ! touch "$marker"; then
    echo -e "${RED}  ✗ Не удалось записать migration marker: $marker${NC}"
    return 1
  fi
  chown root:root "$marker" 2>/dev/null || true
  chmod 0640 "$marker" 2>/dev/null || true
  echo -e "${GREEN}  ✓ Legacy BBR/TCP tuning полностью отключён${NC}"
  return 0
}

# run_migration <marker_basename> <description> <fn_name>
# Centralized migration runner: backup → run fn → safe_restart → touch marker.
# Marker is created ONLY if all phases succeed (idempotency guarantee).
#
# Three-valued return contract for migration fns:
#   fn returns 0 = config changed → safe_restart_xray + touch marker
#   fn returns 1 = no-op (nothing to migrate) → touch marker WITHOUT restart
#   fn returns ≥2 = FAILED → do NOT touch marker (миграция повторится)
#
# Why three-valued: 5 of 6 existing fns return `return 1` для no-op case (нечего
# мигрировать на актуальной установке). Binary contract (0=ok, ≥1=fail) приводил
# бы к 5 RED false-positive ошибкам на каждом launch'е и маркеры никогда
# не выставлялись бы — миграции бесконечно перепроверялись.
#
# Args:
#   marker_basename — file inside /usr/local/etc/xray/, WITHOUT leading dot
#                     (e.g. "xhttp_migrated" → marker /usr/local/etc/xray/.xhttp_migrated)
#   description     — human-readable for logging (Russian, для пользователя)
#   fn_name         — bash function to call. Function MUST:
#                       - return 0 если config changed (рестарт нужен)
#                       - return 1 если no-op (нечего мигрировать, рестарт не нужен)
#                       - return ≥2 если миграция ФАЛЛЕНУЛА (НЕ touch marker)
#                     Function MUST NOT call backup_config or safe_restart_xray itself
#                     (helper делает это централизованно).
#
# Returns: 0=ok (marker set), 1=fn failed (≥2), 2=restart failed
run_migration() {
  local marker_basename="$1"
  local description="$2"
  local fn_name="$3"
  local rollback_config=""
  local profiles_snapshot=""

  local marker="/usr/local/etc/xray/.${marker_basename}"

  # Skip if already done (idempotent)
  if [[ -f "$marker" ]]; then
    return 0
  fi

  echo -e "${MAGENTA}[migration] ${description}${NC}"

  # Step 1: backup BEFORE any mutation (centralized per REQ-D07).
  if ! backup_config "$marker_basename" rollback_config; then
    echo -e "${RED}  ✗ Migration aborted: не удалось создать бэкап${NC}"
    return 1
  fi
  if ! _snapshot_profiles profiles_snapshot; then
    echo -e "${RED}  ✗ Migration aborted: не удалось создать снимок profile JSON${NC}"
    return 1
  fi

  # Step 2: run user-supplied migration fn
  "$fn_name"
  local fn_rc=$?

  case $fn_rc in
    0)
      # Changed config — needs restart
      if safe_restart_xray "$rollback_config"; then
        if ! touch "$marker"; then
          _discard_profiles_snapshot "$profiles_snapshot"
          echo -e "${RED}  ✗ Migration applied, но marker не записан: $marker${NC}"
          return 1
        fi
        chown root:root "$marker" 2>/dev/null || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${GREEN}  ✓ Migration applied: ${marker_basename}${NC}"
        return 0
      else
        _restore_profiles_snapshot "$profiles_snapshot" || true
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}  ✗ safe_restart_xray failed для ${description}${NC}"
        echo -e "${YELLOW}    Маркер НЕ выставлен — config откачен (auto-rollback), миграция повторится${NC}"
        return 2
      fi
      ;;
    1)
      # No change — skip restart, but still mark as done (idempotent no-op for next runs).
      # Без этого touch'а fn re-проверял бы (зря) каждый launch.
      if ! touch "$marker"; then
        _discard_profiles_snapshot "$profiles_snapshot"
        echo -e "${RED}  ✗ Не удалось записать migration marker: $marker${NC}"
        return 1
      fi
      chown root:root "$marker" 2>/dev/null || true
      _discard_profiles_snapshot "$profiles_snapshot"
      echo -e "${CYAN}  ✓ Nothing to migrate: ${marker_basename}${NC}"
      return 0
      ;;
    *)
      # fn вернула ≥2 — реальная ошибка (НЕ no-op).
      _restore_config_backup "$rollback_config" || true
      _restore_profiles_snapshot "$profiles_snapshot" || true
      _discard_profiles_snapshot "$profiles_snapshot"
      echo -e "${RED}  ✗ Migration fn '$fn_name' returned $fn_rc${NC}"
      echo -e "${YELLOW}    Config/profile JSON откачены; миграция повторится при следующем запуске${NC}"
      return 1
      ;;
  esac
}

# Remove the legacy server-side fingerprint field. Xray ignores this field for
# REALITY inbounds: the effective fingerprint lives only in profile/client URLs.
# Returns: 0=changed, 1=no-op, 2=write failure.
_remove_ignored_reality_server_fingerprints() {
  local config_file="${1:-$CONFIG_FILE}"
  [[ -f "$config_file" ]] || return 1

  if ! jq -e '
    any(.inbounds[]?; ((.streamSettings.realitySettings? // {}) | has("fingerprint")))
  ' "$config_file" >/dev/null 2>&1; then
    return 1
  fi

  if ! safe_jq_write '
    (.inbounds[]?
      | select((.streamSettings.realitySettings? // {}) | has("fingerprint"))
      | .streamSettings.realitySettings) |= del(.fingerprint)
  ' "$config_file"; then
    return 2
  fi

  return 0
}

# Upgrade old/default Chrome profile values to the current Firefox default.
# Explicit non-Chrome choices (Safari, Edge, random, etc.) are preserved.
# Returns: 0=changed, 1=no-op, 2=write failure.
_migrate_profile_fingerprints_to_firefox() {
  local changed=0
  local profile_file

  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ -f "$profile_file" ]] || continue
    if ! jq -e '
      ((.fingerprint // "chrome") == "chrome") or
      any((.routes // [])[]; ((.fingerprint // "chrome") == "chrome"))
    ' "$profile_file" >/dev/null 2>&1; then
      continue
    fi

    if ! safe_jq_write '
      if ((.routes // []) | length) > 0 then
        .routes |= map(
          if ((.fingerprint // "chrome") == "chrome")
          then .fingerprint = "firefox"
          else .
          end
        ) |
        .fingerprint = (.routes[0].fingerprint // "firefox")
      else
        if ((.fingerprint // "chrome") == "chrome")
        then .fingerprint = "firefox"
        else .
        end
      end
    ' "$profile_file"; then
      return 2
    fi
    changed=1
  done

  [[ "$changed" -eq 1 ]] && return 0
  return 1
}

# State-only migration: cleaning an ignored server field does not require an
# Xray restart and therefore must not use run_migration().
migrate_client_fingerprint_state_2026() {
  local marker="${1:-/usr/local/etc/xray/.client_fingerprint_state_2026}"
  [[ -f "$marker" ]] && return 0
  local changed=0
  local rollback_config=""
  local profiles_snapshot=""

  backup_config "client_fingerprint_state_2026" rollback_config || return 1
  _snapshot_profiles profiles_snapshot || return 1

  if jq -e '
    any(.inbounds[]?; ((.streamSettings.realitySettings? // {}) | has("fingerprint")))
  ' "$CONFIG_FILE" >/dev/null 2>&1; then
    if ! _remove_ignored_reality_server_fingerprints "$CONFIG_FILE"; then
      _restore_config_backup "$rollback_config" || true
      _restore_profiles_snapshot "$profiles_snapshot" || true
      _discard_profiles_snapshot "$profiles_snapshot"
      echo -e "${RED}  ✗ Не удалось удалить устаревший server-side fingerprint${NC}"
      return 1
    fi
    changed=1
  fi

  local profiles_rc=0
  _migrate_profile_fingerprints_to_firefox || profiles_rc=$?
  if [[ "$profiles_rc" -eq 0 ]]; then
    changed=1
  elif [[ "$profiles_rc" -ge 2 ]]; then
    _restore_config_backup "$rollback_config" || true
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}  ✗ Не удалось обновить profile fingerprints до Firefox${NC}"
    return 1
  fi

  if [[ "$changed" -eq 1 ]]; then
    echo -e "${GREEN}  ✓ Fingerprint переведён в client-only режим с default Firefox${NC}"
  fi

  if ! touch "$marker"; then
    _restore_config_backup "$rollback_config" || true
    _restore_profiles_snapshot "$profiles_snapshot" || true
    _discard_profiles_snapshot "$profiles_snapshot"
    echo -e "${RED}  ✗ Не удалось записать migration marker: $marker${NC}"
    return 1
  fi
  chown root:root "$marker" 2>/dev/null || true
  _discard_profiles_snapshot "$profiles_snapshot"
  return 0
}

migrate_transport_profile_metadata() {
  local migrated=0
  local profile_file

  echo -e "${CYAN}Проверка transport metadata профилей...${NC}"
  # backup_config удалён: централизован в run_migration (Phase 4 refactor, REQ-D07)

  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ ! -f "$profile_file" ]] && continue

    local transport
    transport=$(jq -r '.transport // ""' "$profile_file" 2>/dev/null)

    case "$transport" in
      grpc)
        if [[ "$(jq -r 'has("grpc_service_name")' "$profile_file" 2>/dev/null)" != "true" ]]; then
          echo -e "${YELLOW}  → Backfill grpc_service_name: $(basename "$profile_file" .json)${NC}"
          if safe_jq_write '.grpc_service_name = "grpc"' "$profile_file"; then
            ((migrated++))
          fi
        fi
        ;;
      xhttp)
        if [[ "$(jq -r 'has("xhttp_path")' "$profile_file" 2>/dev/null)" != "true" ]]; then
          echo -e "${YELLOW}  → Backfill xhttp_path: $(basename "$profile_file" .json)${NC}"
          if safe_jq_write '.xhttp_path = "/xhttp"' "$profile_file"; then
            ((migrated++))
          fi
        fi
        ;;
    esac
  done

  fix_xray_permissions

  # EXPLICIT return: 0=changed (restart нужен), 1=no-op (нечего мигрировать)
  # Раньше всегда return 0 — принудительный restart даже когда migrated==0
  if [[ $migrated -gt 0 ]]; then
    echo -e "${GREEN}✓ Transport metadata backfill: $migrated профилей${NC}"
    return 0
  else
    echo -e "${GREEN}✓ Transport metadata backfill не требуется${NC}"
    return 1
  fi
}

_migrate_xhttp_route_path_repair_2026() {
  local profile_files=("$PROFILES_DIR"/*.json)
  [[ -f "${profile_files[0]}" ]] || return 1

  local repairs
  if ! repairs=$(jq -s '
    [
      .[] as $profile |
      if (($profile.routes // []) | length) > 0 then
        $profile.routes[] |
        select(
          .transport == "xhttp" and
          (.port | type == "number") and
          ((.xhttp_path // "") | startswith("/"))
        ) |
        {port: .port, path: .xhttp_path, uuid: $profile.uuid}
      else
        $profile |
        select(
          .transport == "xhttp" and
          (.port | type == "number") and
          ((.xhttp_path // "") | startswith("/"))
        ) |
        {port: .port, path: .xhttp_path, uuid: .uuid}
      end
    ] |
    sort_by(.port) |
    group_by(.port) |
    map(
      select((map(.path) | unique | length) == 1) |
      {
        port: .[0].port,
        path: .[0].path,
        uuids: (map(.uuid) | map(select(type == "string" and length > 0)) | unique)
      }
    )
  ' "${profile_files[@]}" 2>/dev/null); then
    echo -e "${RED}  ✗ Не удалось собрать XHTTP path из profile JSON${NC}"
    return 2
  fi

  local repair_count
  if ! repair_count=$(jq -r --argjson repairs "$repairs" '
    [
      $repairs[] as $repair |
      .inbounds[]? |
      select(
        .port == $repair.port and
        .protocol == "vless" and
        .streamSettings.network == "xhttp" and
        ((.streamSettings.xhttpSettings.path // "") == "") and
        any(
          .settings.clients[]?;
          .id as $client_id |
          ($repair.uuids | index($client_id)) != null
        )
      )
    ] |
    length
  ' "$CONFIG_FILE" 2>/dev/null); then
    echo -e "${RED}  ✗ Не удалось проверить XHTTP inbound metadata${NC}"
    return 2
  fi

  if [[ "$repair_count" -eq 0 ]]; then
    return 1
  fi

  if ! safe_jq_write --argjson repairs "$repairs" '
    reduce $repairs[] as $repair (.;
      (
        .inbounds[] |
        select(
          .port == $repair.port and
          .protocol == "vless" and
          .streamSettings.network == "xhttp" and
          ((.streamSettings.xhttpSettings.path // "") == "") and
          any(
            .settings.clients[]?;
            .id as $client_id |
            ($repair.uuids | index($client_id)) != null
          )
        ) |
        .streamSettings.xhttpSettings.path
      ) = $repair.path
    )
  ' "$CONFIG_FILE"; then
    echo -e "${RED}  ✗ Не удалось восстановить XHTTP path в config.json${NC}"
    return 2
  fi

  echo -e "${GREEN}  ✓ Восстановлен XHTTP path для inbound: $repair_count${NC}"
  return 0
}

_migrate_dead_stealth_routes_2026() {
  local profile_file uuid ports_json removals_json='[]'
  local changed_profiles=()

  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ -f "$profile_file" ]] || continue
    if ! jq -e '
      any((.routes // [])[];
        .label == "tcp-stealth-8443" or .label == "tcp-stealth-2053"
      )
    ' "$profile_file" >/dev/null 2>&1; then
      continue
    fi

    uuid=$(jq -r '.uuid // empty' "$profile_file" 2>/dev/null)
    ports_json=$(jq -c '[
      (.routes // [])[] |
      select(.label == "tcp-stealth-8443" or .label == "tcp-stealth-2053") |
      .port |
      select(type == "number")
    ] | unique' "$profile_file" 2>/dev/null)
    if [[ -z "$uuid" ]] || ! jq -e 'type == "array" and length > 0' <<< "$ports_json" >/dev/null 2>&1; then
      echo -e "${RED}  ✗ Некорректный legacy stealth route: $(basename "$profile_file")${NC}"
      return 2
    fi

    removals_json=$(jq -c --arg uuid "$uuid" --argjson ports "$ports_json" \
      '. + [{uuid:$uuid, ports:$ports}]' <<< "$removals_json") || return 2
    changed_profiles+=("$profile_file")
  done

  [[ ${#changed_profiles[@]} -gt 0 ]] || return 1

  if ! safe_jq_write --argjson removals "$removals_json" '
    .inbounds |= map(
      . as $inbound |
      [
        $removals[] |
        select((.ports | index($inbound.port)) != null) |
        .uuid
      ] as $remove_uuids |
      if ($remove_uuids | length) > 0 then
        .settings.clients = (
          (.settings.clients // []) |
          map(. as $client | select(($remove_uuids | index($client.id)) == null))
        ) |
        if (.settings.clients | length) == 0 then empty else . end
      else
        .
      end
    )
  ' "$CONFIG_FILE"; then
    echo -e "${RED}  ✗ Не удалось удалить legacy stealth UUID из config.json${NC}"
    return 2
  fi

  for profile_file in "${changed_profiles[@]}"; do
    if ! safe_jq_write '
      .routes |= map(
        select(.label != "tcp-stealth-8443" and .label != "tcp-stealth-2053")
      ) |
      if (.routes | length) == 0 then
        error("profile would have no routes")
      else
        .transport = .routes[0].transport |
        .port = .routes[0].port |
        .fingerprint = (.routes[0].fingerprint // "firefox") |
        .sni = .routes[0].sni |
        .pq_enabled = (.routes[0].pq_enabled // false) |
        if .routes[0].transport == "xhttp" then
          .xhttp_path = .routes[0].xhttp_path | del(.grpc_service_name)
        elif .routes[0].transport == "grpc" then
          .grpc_service_name = .routes[0].grpc_service_name | del(.xhttp_path)
        else
          del(.xhttp_path, .grpc_service_name)
        end
      end
    ' "$profile_file"; then
      echo -e "${RED}  ✗ Не удалось удалить legacy stealth route: $(basename "$profile_file")${NC}"
      return 2
    fi
  done

  echo -e "${GREEN}  ✓ Удалены мёртвые tcp-stealth маршруты: ${#changed_profiles[@]} профилей${NC}"
  return 0
}

# Migration function for existing XHTTP profiles
migrate_xhttp_profiles() {
  local migrated=0

  echo -e "${CYAN}Проверка XHTTP профилей для миграции...${NC}"
  # backup_config удалён: централизован в run_migration (Phase 4 refactor, REQ-D07)

  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ ! -f "$profile_file" ]] && continue

    local transport=$(jq -r '.transport' "$profile_file")
    [[ "$transport" != "xhttp" ]] && continue

    local profile_sni=$(jq -r '.sni' "$profile_file")
    local port=$(jq -r '.port' "$profile_file")

    # Check if xhttpSettings.host matches profile SNI
    local config_host=$(jq -r --argjson port "$port" \
      '.inbounds[] | select(.port == $port) | .streamSettings.xhttpSettings.host' \
      "$CONFIG_FILE" 2>/dev/null)

    if [[ "$config_host" != "$profile_sni" ]]; then
      echo -e "${YELLOW}  → Миграция XHTTP: $(basename "$profile_file" .json)${NC}"

      if safe_jq_write --argjson port "$port" --arg sni "$profile_sni" '
        (.inbounds[] | select(.port == $port) | .streamSettings.xhttpSettings.host) |= $sni
