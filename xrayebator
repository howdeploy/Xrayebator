# SOURCE-SAFETY GUARD (Phase 7, REQ-C10)
# ═══════════════════════════════════════════════════════════
# Если xrayebator source-ится из другого скрипта (subhttp.sh для HAPP subscription),
# мы НЕ должны выполнять root-check, загружать ключи Reality или входить в интерактивное
# main_menu — нужны только определения функций и констант.
# Тест: BASH_SOURCE[0] (путь к sourced-файлу) != ${0} (имя процесса) → значит source.
# В source-режиме мы ПРОПУСКАЕМ top-level эффекты (root-check, key-load, CLI dispatch),
# но определения функций ниже регистрируются как обычно.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  XRAYEBATOR_SOURCED=1
else
  XRAYEBATOR_SOURCED=0
fi

# Проверка прав root + загрузка ключей выполняются только при прямом запуске.
if [[ "$XRAYEBATOR_SOURCED" -eq 0 ]]; then
  if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}✗ Требуются права root${NC}"
    echo -e "${YELLOW}Используйте: sudo xrayebator${NC}"
    exit 1
  fi

  # Загрузка ключей
  if [[ -f "$PRIVATE_KEY_FILE" ]] && [[ -f "$PUBLIC_KEY_FILE" ]]; then
    PRIVATE_KEY=$(cat "$PRIVATE_KEY_FILE")
    PUBLIC_KEY=$(cat "$PUBLIC_KEY_FILE")
    if [[ -z "$PRIVATE_KEY" ]] || [[ -z "$PUBLIC_KEY" ]]; then
      echo -e "${RED}✗ Ключи Reality пусты.${NC}"
      echo -e "${YELLOW}Пересоздайте ключи командой:${NC}"
      echo "  cd /usr/local/etc/xray/ && sudo /usr/local/bin/xray x25519 2>&1"
      exit 1
    fi
  else
    echo -e "${RED}✗ Ключи Reality не найдены. Запустите install.sh${NC}"
    exit 1
  fi
fi

# Встроенное в apt ожидание dpkg lock. На Ubuntu 22.04 apt уже ставит дефолт
# DPkg::Lock::Timeout=120 (видно в apt-config dump) — поднятием до 180 мы лишь
# страхуем системы без дефолта. Это НЕ основной механизм ожидания: entire
# очередь unattended-upgrades занимает lock ~10 минут (замер на живом VPS
# 2026-09-23), а apt с опцией ждёт только её окно. Основной механизм —
# _apt_wait_lock по процессу-воркеру.
APT_LOCK_OPTS=(-o "DPkg::Lock::Timeout=180")

# Ждёт освобождения apt/dpkg lock (apt-daily, unattended-upgrades и т.п.)
# до запуска собственной apt-команды. Возвращает 0, когда можно ставить пакеты,
# или 1 по истечении timeout (сек).
# Критично: на свежеподнятых Ubuntu unattended-upgrades прогоняет полный
# security-апгрейд (~90 пакетов, ~10 минут — dpkg вызывается отдельно на
# каждый). Между пакетами flock свободен секунды, голый flock проскакивает в
# такой зазор, apt стартует и умирает по своему lock-timeout или внешнему kill
# (зафиксировано на живом VPS 2026-09-23: quickstart падал с «apt-get install
# nginx failed» при формально «свободном» lock).
# Поэтому занятым считаем и активный рабочий процесс unattended-upgrade.
_apt_wait_lock() {
  local max_sec="${1:-300}"
  local deadline=$(( $(date +%s) + max_sec ))
  local locks=(
    /var/lib/dpkg/lock-frontend
    /var/lib/dpkg/lock
    /var/lib/apt/lists/lock
    /var/cache/apt/archives/lock
  )
  while (( $(date +%s) < deadline )); do
    local held=0
    local lock
    # Активный рабочий процесс unattended-upgrade = очередь пакетов ещё идёт.
    # По comm не различить (ядро обрезает до 15 символов «unattended-upgr» и у
    # воркера, и у резидентного shutdown-helper'а с самого бутa) — проверяем
    # cmdline: путь скрипта ровно «/usr/bin/unattended-upgrade» (helper'овский
    # «/usr/share/unattended-upgrades/unattended-upgrade-shutdown» не совпадает).
    if command -v pgrep >/dev/null 2>&1 && pgrep -f '/usr/bin/unattended-upgrade( |$)' >/dev/null 2>&1; then
      held=1
    fi
    if [[ "$held" -eq 0 ]]; then
      for lock in "${locks[@]}"; do
        # flock не создаёт файл — touch обязателен для несуществующих lock-путей.
        touch "$lock" 2>/dev/null || true
        if ! flock -n "$lock" true 2>/dev/null; then
          held=1
          break
        fi
      done
    fi
    if [[ "$held" -eq 0 ]]; then
      return 0
    fi
    sleep 5
  done
  return 1
}

# Получение внешнего IP
get_server_ip() {
  local ip=""
  # На IPv6-only VPS нет маршрута до IPv4-сервисов определения — тогда запрашиваем IPv6.
  if _detect_ipv6_only; then
    ip=$(curl -s6 --connect-timeout 5 --max-time 10 ifconfig.me 2>/dev/null || \
         curl -s6 --connect-timeout 5 --max-time 10 icanhazip.com 2>/dev/null)
  else
    ip=$(curl -s4 --connect-timeout 5 --max-time 10 ifconfig.me 2>/dev/null || \
         curl -s4 --connect-timeout 5 --max-time 10 icanhazip.com 2>/dev/null)
  fi
  if [[ -z "$ip" ]]; then
    if _detect_ipv6_only; then
      # BASH-1-fix: bare print печатал всю строку, exit вне условия → мусор.
      # Правильный синтаксис: if(match) { print $i; exit }.
      ip=$(hostname -I | awk '{for(i=1;i<=NF;i++) if ($i ~ /:/) { print $i; exit } }' | head -1)
    else
      ip=$(hostname -I | awk '{print $1}')
    fi
  fi
  echo "$ip"
}

# Заключает IPv6-адрес в квадратные скобки для использования в URL/hostname
# (nginx server_name, https://[addr]:port). Для IPv4 возвращает как есть.
_ip_bracket() {
  local addr="$1"
  if [[ "$addr" == *":"* ]]; then
    # Не брекетить повторно
    if [[ "$addr" == "["* ]]; then
      echo "$addr"
    else
      echo "[${addr}]"
    fi
  else
    echo "$addr"
  fi
}

# ═══════════════════════════════════════════════════════════
# Geo-определение страны/города сервера ("сторона")
# ═══════════════════════════════════════════════════════════
# Маркер-файл: "country_code|country_name|city" (например "DE|Germany|Frankfurt").
# Пишется один раз при quickstart/happ-setup (best-effort, сетевой запрос к
# бесплатным geo-API). Читается _generate_vless_url_pure для подписи имени vless
# маршрута и quickstart JSON для GUI. Если файла нет — подписка ведёт себя как раньше.
SERVER_COUNTRY_FILE="${SERVER_COUNTRY_FILE:-/usr/local/etc/xray/.server_country}"

# Best-effort: определяет страну/город по публичному IP сервера и пишет $SERVER_COUNTRY_FILE.
# Идемпотентен: если файл непустой и моложе 30 суток — сеть не трогает (subhttp source-ит
# xrayebator на каждый запрос, лишние curl'ы под xray:xray неприемлемы).
# Args: $1 = IP сервера (опционально; иначе get_server_ip).
# Возвращает 0 даже при недоступности API — вызывающий никогда не фейлится из-за страны.
_geo_detect_country() {
  local ip="${1:-}"
  local file="$SERVER_COUNTRY_FILE"

  if [[ -s "$file" ]]; then
    local now mtime
    now=$(date +%s 2>/dev/null || echo 0)
    mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
    if [[ "$now" -gt 0 && "$mtime" -gt 0 && $((now - mtime)) -lt 2592000 ]]; then
      return 0
    fi
  fi

  [[ -z "$ip" ]] && ip=$(get_server_ip)
  ip="${ip//\[/}"; ip="${ip//\]/}"
  [[ -n "$ip" ]] || return 0

  # ipwho.is первым (HTTPS, без ключа); ip-api.com как fallback (cache-burst 45/min).
  local json code country city
  json=$(curl -fsS --connect-timeout 5 --max-time 8 "https://ipwho.is/${ip}" 2>/dev/null) \
    || json=$(curl -fsS --connect-timeout 5 --max-time 8 \
                    "http://ip-api.com/json/${ip}?fields=status,country,countryCode,city" 2>/dev/null) \
    || return 0

  [[ "$(printf '%s' "$json" | jq -r '.status // .success // empty' 2>/dev/null)" != "false" ]] || return 0
  code=$(printf '%s' "$json" | jq -r '.country_code // .countryCode // empty' 2>/dev/null)
  country=$(printf '%s' "$json" | jq -r '.country // empty' 2>/dev/null)
  city=$(printf '%s' "$json" | jq -r '.city // empty' 2>/dev/null)
  [[ -n "$country" && "$country" != "null" ]] || return 0
  [[ -n "$code" && "$code" != "null" ]] || code=""
  [[ -n "$city" && "$city" != "null" ]] || city=""

  printf '%s|%s|%s\n' "$code" "$country" "$city" > "$file" 2>/dev/null || true
  chown xray:xray "$file" 2>/dev/null || true
  return 0
}

# Читает ISO-код страны из $SERVER_COUNTRY_FILE (пусто, если маркер отсутствует).
_geo_country_code() {
  if [[ -f "$SERVER_COUNTRY_FILE" ]]; then
    cut -d'|' -f1 "$SERVER_COUNTRY_FILE" 2>/dev/null || true
  fi
}

# Читает название страны из $SERVER_COUNTRY_FILE (пусто, если маркер отсутствует).
_geo_country_name() {
  if [[ -f "$SERVER_COUNTRY_FILE" ]]; then
    cut -d'|' -f2 "$SERVER_COUNTRY_FILE" 2>/dev/null || true
  fi
}

# Читает город из $SERVER_COUNTRY_FILE (пусто, если маркер отсутствует).
_geo_city() {
  if [[ -f "$SERVER_COUNTRY_FILE" ]]; then
    cut -d'|' -f3 "$SERVER_COUNTRY_FILE" 2>/dev/null || true
  fi
}

# Unicode-флаг страны из двух Regional Indicator Symbols (U+1F1E6..U+1F1FF).
# ISO-код "LV" → 🇱🇻 (Latvia). Bash printf \UXXXXXX + вычисление кодпоинта из букв.
# Пустой результат если код не ровно 2 латинских буквы — вызывающий просто не получит флаг.
_geo_flag_emoji() {
  local code="$1"
  [[ "${#code}" -eq 2 ]] || return 0
  local c1 c2 h1 h2
  c1=$(LC_ALL=C printf '%d' "'${code:0:1}")
  c2=$(LC_ALL=C printf '%d' "'${code:1:1}")
  # Только A-Z (65..90) — иначе не региональный индикатор.
  [[ "$c1" -ge 65 && "$c1" -le 90 && "$c2" -ge 65 && "$c2" -le 90 ]] || return 0
  h1=$(printf '%x' $((0x1F1E6 + c1 - 65)))
  h2=$(printf '%x' $((0x1F1E6 + c2 - 65)))
  printf "\\U$(printf '%08s' "$h1" | tr ' ' 0)\\U$(printf '%08s' "$h2" | tr ' ' 0)"
}

