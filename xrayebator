# SOURCE-SAFETY GUARD (Phase 7, REQ-C10)
# ═══════════════════════════════════════════════════════════
# Если xrayebator source-ится из другого скрипта (subhttp.sh для HAPP subscription),
# мы НЕ должны выполнять root-check, загружать ключи Reality или входить в интерактивное
# main_menu — нужны только определения функций и констант.
# Тест: BASH_SOURCE[0] (путь к sourced-файлу) != ${0} (имя процесса) → значит source.
# В source-режиме мы ПРОПУСКАЕМ top-level эффекты (root-check, key-load, CLI dispatch),
# но определения функций ниже регистрируются как обычно.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  XRAYEBATOR_SOURCED=1
else
  XRAYEBATOR_SOURCED=0
fi

# Проверка прав root + загрузка ключей выполняются только при прямом запуске.
if [[ "$XRAYEBATOR_SOURCED" -eq 0 ]]; then
  if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}✗ Требуются права root${NC}"
    echo -e "${YELLOW}Используйте: sudo xrayebator${NC}"
    exit 1
  fi

  # Загрузка ключей
  if [[ -f "$PRIVATE_KEY_FILE" ]] && [[ -f "$PUBLIC_KEY_FILE" ]]; then
    PRIVATE_KEY=$(cat "$PRIVATE_KEY_FILE")
    PUBLIC_KEY=$(cat "$PUBLIC_KEY_FILE")
    if [[ -z "$PRIVATE_KEY" ]] || [[ -z "$PUBLIC_KEY" ]]; then
      echo -e "${RED}✗ Ключи Reality пусты.${NC}"
      echo -e "${YELLOW}Пересоздайте ключи командой:${NC}"
      echo "  cd /usr/local/etc/xray/ && sudo /usr/local/bin/xray x25519 2>&1"
      exit 1
    fi
  else
    echo -e "${RED}✗ Ключи Reality не найдены. Запустите install.sh${NC}"
    exit 1
  fi
fi

# Получение внешнего IP
get_server_ip() {
  local ip=""
  # На IPv6-only VPS нет маршрута до IPv4-сервисов определения — тогда запрашиваем IPv6.
  if _detect_ipv6_only; then
    ip=$(curl -s6 --connect-timeout 5 --max-time 10 ifconfig.me 2>/dev/null || \
         curl -s6 --connect-timeout 5 --max-time 10 icanhazip.com 2>/dev/null)
  else
    ip=$(curl -s4 --connect-timeout 5 --max-time 10 ifconfig.me 2>/dev/null || \
         curl -s4 --connect-timeout 5 --max-time 10 icanhazip.com 2>/dev/null)
  fi
  if [[ -z "$ip" ]]; then
    if _detect_ipv6_only; then
      # BASH-1-fix: bare print печатал всю строку, exit вне условия → мусор.
      # Правильный синтаксис: if(match) { print $i; exit }.
      ip=$(hostname -I | awk '{for(i=1;i<=NF;i++) if ($i ~ /:/) { print $i; exit } }' | head -1)
    else
      ip=$(hostname -I | awk '{print $1}')
    fi
  fi
  echo "$ip"
}

# Заключает IPv6-адрес в квадратные скобки для использования в URL/hostname
# (nginx server_name, https://[addr]:port). Для IPv4 возвращает как есть.
_ip_bracket() {
  local addr="$1"
  if [[ "$addr" == *":"* ]]; then
    # Не брекетить повторно
    if [[ "$addr" == "["* ]]; then
      echo "$addr"
    else
      echo "[${addr}]"
    fi
  else
    echo "$addr"
  fi
}

