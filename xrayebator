# Update SNI for all transport types (transport-aware)
# Args: $1=port, $2=new_sni, $3=config_file
update_transport_settings_for_sni() {
  local port=$1
  local new_sni=$2
  local config_file=$3
  local reality_dest
  reality_dest=$(_reality_dest_for_sni "$new_sni")

  # Convert port to number for jq
  local port_num=$((port))

  # Detect transport type
  local transport=$(jq -r --argjson port "$port_num" \
    '.inbounds[] | select(.port == $port) | .streamSettings.network' \
    "$config_file")

  echo -e "${CYAN}  → Обновление SNI на порту $port (транспорт: $transport)...${NC}"

  # Base updates (ALL transports) - search by port number, not tag
  if ! safe_jq_write --argjson port "$port_num" --arg sni "$new_sni" --arg dest "$reality_dest" '
    (.inbounds[] | select(.port == $port) | .streamSettings.realitySettings.dest) |= $dest |
    (.inbounds[] | select(.port == $port) | .streamSettings.realitySettings.serverNames) |= [$sni]
  ' "$config_file"; then
    echo -e "${RED}  ✗ Ошибка обновления SNI${NC}"
    return 1
  fi
  echo -e "${GREEN}  ✓ Reality SNI обновлен → $new_sni${NC}"

  # Transport-specific updates
  if [[ "$transport" == "xhttp" ]]; then
    if safe_jq_write --argjson port "$port_num" --arg sni "$new_sni" '
      (.inbounds[] | select(.port == $port) | .streamSettings.xhttpSettings.host) |= $sni
    ' "$config_file"; then
      echo -e "${GREEN}  ✓ XHTTP host обновлен → $new_sni${NC}"
    else
      echo -e "${RED}  ✗ Ошибка обновления XHTTP host${NC}"
      return 1
    fi
  fi
}

find_profile_file_by_uuid() {
  local uuid=$1
  local profile_file

  for profile_file in "$PROFILES_DIR"/*.json; do
    [[ ! -f "$profile_file" ]] && continue
    if [[ "$(jq -r '.uuid // ""' "$profile_file" 2>/dev/null)" == "$uuid" ]]; then
      echo "$profile_file"
      return 0
    fi
  done

  return 1
}

find_available_random_port() {
  local min_port=30000
  local max_port=60000
  local attempts=0
  local port

  while [[ $attempts -lt 200 ]]; do
    port=$((min_port + ((RANDOM << 15 | RANDOM) % (max_port - min_port + 1))))
    # Проверяем и конфиг Xray, и реально слушающие порты, и уже зарезервированные
    # в этом процессе. ВНИМАНИЕ: назначение порта происходит в КОПИИ массива
    # XRAYEBATOR_RESERVED_PORTS (этот вызов часто идёт через командную подстановку,
    # т.е. в subshell). По-настоящему резервирует порт в родительском shell вызывающий
    # код через reserve_port() — иначе массив (изменённый в subshell) теряется.
    local reserved=0
    local rp
    for rp in "${XRAYEBATOR_RESERVED_PORTS[@]:-}"; do
      if [[ "$rp" == "$port" ]]; then reserved=1; break; fi
    done
    if [[ "$reserved" -eq 0 ]] && \
       ! jq -e --argjson port "$port" '.inbounds[] | select(.port == $port)' \
      "$CONFIG_FILE" >/dev/null 2>&1 && \
      ! ss -tuln 2>/dev/null | grep -q ":${port} "; then
      echo "$port"
      return 0
    fi
    ((attempts++))
  done

  echo -e "${RED}✗ Не удалось подобрать свободный случайный порт 30000-60000${NC}" >&2
  return 1
}

# P2-fix: резервирует порт в РОДИТЕЛЬСКОМ shell вызывающего. Причина: find_available_*,
# вызванный через `port=$(...)`, работает в subshell, и изменение глобального массива
# XRAYEBATOR_RESERVED_PORTS в нём ТЕРЯЕТСЯ. Вызывающий код после получения порта обязан
# вызвать reserve_port "$port" в своём shell, иначе соседние маршруты могут повторно
# получить тот же порт. Args: $1=port (целое, иначе игнор).
reserve_port() {
  local port=${1:-}
  [[ "$port" =~ ^[0-9]+$ ]] || return 0
  local existing=0
  local _rp
  for _rp in "${XRAYEBATOR_RESERVED_PORTS[@]:-}"; do
    [[ "$_rp" == "$port" ]] && existing=1
  done
  [[ "$existing" -eq 0 ]] && XRAYEBATOR_RESERVED_PORTS+=("$port") || true
}

generate_transport_token() {
  local prefix=$1
  local bytes=${2:-4}
  echo "${prefix}-$(openssl rand -hex "$bytes")"
}

build_transport_defaults() {
  local transport=$1
  local port
  local grpc_service_name=""
  local xhttp_path=""

  if ! port=$(find_available_random_port); then
    return 1
  fi

  case "$transport" in
    grpc)
      grpc_service_name=$(generate_transport_token "grpc")
      ;;
    xhttp)
      xhttp_path="/$(generate_transport_token "xhttp")"
      ;;
  esac

  printf '%s|%s|%s\n' "$port" "$grpc_service_name" "$xhttp_path"
}

read_inbound_transport_metadata() {
  local port=$1
  local transport=$2
  local grpc_service_name=""
  local xhttp_path=""

  case "$transport" in
    grpc)
      grpc_service_name=$(jq -r --argjson port "$port" \
        '.inbounds[] | select(.port == $port) | .streamSettings.grpcSettings.serviceName // "grpc"' \
        "$CONFIG_FILE" 2>/dev/null)
      [[ -z "$grpc_service_name" || "$grpc_service_name" == "null" ]] && grpc_service_name="grpc"
      ;;
    xhttp)
      xhttp_path=$(jq -r --argjson port "$port" \
        '.inbounds[] | select(.port == $port) | .streamSettings.xhttpSettings.path // "/xhttp"' \
        "$CONFIG_FILE" 2>/dev/null)
      [[ -z "$xhttp_path" || "$xhttp_path" == "null" ]] && xhttp_path="/xhttp"
      ;;
  esac

  printf '%s|%s\n' "$grpc_service_name" "$xhttp_path"
}

read_profile_transport_metadata() {
  local profile_file=$1
  local transport
  local grpc_service_name=""
  local xhttp_path=""

  transport=$(jq -r '.transport // "tcp"' "$profile_file" 2>/dev/null)

  case "$transport" in
    grpc)
      grpc_service_name=$(jq -r '.grpc_service_name // "grpc"' "$profile_file" 2>/dev/null)
      [[ -z "$grpc_service_name" || "$grpc_service_name" == "null" ]] && grpc_service_name="grpc"
      ;;
    xhttp)
      xhttp_path=$(jq -r '.xhttp_path // "/xhttp"' "$profile_file" 2>/dev/null)
      [[ -z "$xhttp_path" || "$xhttp_path" == "null" ]] && xhttp_path="/xhttp"
      ;;
  esac

  printf '%s|%s\n' "$grpc_service_name" "$xhttp_path"
}

_profile_route_matches_live_inbound() {
  local profile_file="$1"
  local route_index="${2:-}"
  [[ -f "$profile_file" && -f "$CONFIG_FILE" ]] || return 1

  local uuid transport port sni grpc_service_name xhttp_path pq_enabled
  uuid=$(jq -r '.uuid // empty' "$profile_file" 2>/dev/null) || return 1
  if [[ -n "$route_index" ]]; then
    transport=$(jq -r --argjson i "$route_index" '.routes[$i].transport // empty' "$profile_file" 2>/dev/null) || return 1
    port=$(jq -r --argjson i "$route_index" '.routes[$i].port // empty' "$profile_file" 2>/dev/null) || return 1
    sni=$(jq -r --argjson i "$route_index" '.routes[$i].sni // .sni // empty' "$profile_file" 2>/dev/null) || return 1
    grpc_service_name=$(jq -r --argjson i "$route_index" '.routes[$i].grpc_service_name // "grpc"' "$profile_file" 2>/dev/null) || return 1
    xhttp_path=$(jq -r --argjson i "$route_index" '.routes[$i].xhttp_path // "/xhttp"' "$profile_file" 2>/dev/null) || return 1
    pq_enabled=$(jq -r --argjson i "$route_index" '.routes[$i].pq_enabled // false' "$profile_file" 2>/dev/null) || return 1
  else
    transport=$(jq -r '.transport // empty' "$profile_file" 2>/dev/null) || return 1
    port=$(jq -r '.port // empty' "$profile_file" 2>/dev/null) || return 1
    sni=$(jq -r '.sni // empty' "$profile_file" 2>/dev/null) || return 1
    grpc_service_name=$(jq -r '.grpc_service_name // "grpc"' "$profile_file" 2>/dev/null) || return 1
    xhttp_path=$(jq -r '.xhttp_path // "/xhttp"' "$profile_file" 2>/dev/null) || return 1
    pq_enabled=$(jq -r '.pq_enabled // false' "$profile_file" 2>/dev/null) || return 1
  fi

  [[ -n "$uuid" && "$port" =~ ^[0-9]+$ && -n "$sni" ]] || return 1

  local network expected_flow
  case "$transport" in
    tcp|tcp-utls|tcp-xudp)
      network="tcp"
      expected_flow="xtls-rprx-vision"
      ;;
    tcp-mux)
      network="tcp"
      expected_flow=""
      ;;
    grpc)
      network="grpc"
      expected_flow=""
      ;;
    xhttp)
      network="xhttp"
      expected_flow=""
      ;;
    *)
      return 1
      ;;
  esac

  jq -e \
    --argjson port "$port" \
    --arg uuid "$uuid" \
    --arg transport "$transport" \
    --arg network "$network" \
    --arg flow "$expected_flow" \
    --arg sni "$sni" \
    --arg grpc_service_name "$grpc_service_name" \
    --arg xhttp_path "$xhttp_path" \
    --arg pq_enabled "$pq_enabled" '
      def contains_value($value):
        if type == "array" then index($value) != null else . == $value end;

      any(.inbounds[]?;
        .port == $port and
        .protocol == "vless" and
        .streamSettings.security == "reality" and
        .streamSettings.network == $network and
        any(.settings.clients[]?; .id == $uuid and ((.flow // "") == $flow)) and
        any(.streamSettings.realitySettings.serverNames[]?; . == $sni) and
        (
          $transport != "grpc" or
          ((.streamSettings.grpcSettings.serviceName // "grpc") == $grpc_service_name)
        ) and
        (
          $transport != "xhttp" or
          (
            (.streamSettings.xhttpSettings.path // "") == $xhttp_path and
            ((.streamSettings.xhttpSettings.host // "") | contains_value($sni)) and
            (
              if $pq_enabled == "true"
              then (.settings.decryption // "none") != "none"
              else (.settings.decryption // "none") == "none"
              end
            )
          )
        )
      )
    ' "$CONFIG_FILE" >/dev/null 2>&1
}

# ═══════════════════════════════════════════════════════════
# Pure VLESS URL builder (Phase 7, REQ-C10)
# ═══════════════════════════════════════════════════════════
# НЕ печатает цветной TUI, НЕ читает stdin, НЕ пишет файлы, НЕ зовёт qrencode.
# stdout: ровно одна vless:// строка (без trailing newline) на success.
# return: 0 на успех; 1 если profile_file не существует / транспорт неизвестен /
#         PQ-профиль без $VLESS_ENCRYPTION_FILE.
# Args: $1 = absolute path к profile JSON.
# Используется generate_connection() в интерактиве и subhttp.sh в Plan 7.2.
_generate_vless_url_pure() {
  local profile_file="$1"
  local route_index="${2:-}"
  [[ -f "$profile_file" ]] || return 1

  local profile_name uuid transport port fingerprint sni
  profile_name=$(basename "$profile_file" .json)
  uuid=$(jq -r '.uuid' "$profile_file") || return 1
  if [[ -z "$route_index" ]] && jq -e '(.routes // []) | length > 0' "$profile_file" >/dev/null 2>&1; then
    route_index=0
  fi

  local route_label=""
  if [[ -n "$route_index" ]]; then
    transport=$(jq -r --argjson i "$route_index" '.routes[$i].transport // empty' "$profile_file") || return 1
    port=$(jq -r --argjson i "$route_index" '.routes[$i].port // empty' "$profile_file") || return 1
    fingerprint=$(jq -r --argjson i "$route_index" '.routes[$i].fingerprint // .fingerprint // "firefox"' "$profile_file")
    sni=$(jq -r --argjson i "$route_index" '.routes[$i].sni // .sni // "www.ozon.ru"' "$profile_file")
    route_label=$(jq -r --argjson i "$route_index" '.routes[$i].label // .routes[$i].transport // empty' "$profile_file")
  else
    transport=$(jq -r '.transport' "$profile_file") || return 1
    port=$(jq -r '.port' "$profile_file") || return 1
    fingerprint=$(jq -r '.fingerprint // "firefox"' "$profile_file")
    sni=$(jq -r '.sni // "www.ozon.ru"' "$profile_file")
  fi
  [[ -n "$route_label" && "$route_label" != "null" ]] && profile_name="${profile_name}-${route_label}"

  local server_ip clean_public_key
  server_ip=$(_connection_server_address)
  [[ -n "$server_ip" ]] || return 1
  # A5-fix: IPv6-адрес в vless:// обязан быть в [скобках] (vless://uuid@[addr]:port).
  # Иначе клиенты (v2rayNG, HAPP, Shadowrocket) не распарсят URL.
  server_ip=$(_ip_bracket "$server_ip")

  # Transport metadata (grpc service name / xhttp path) и url-encoded path
  local transport_metadata grpc_service_name xhttp_path encoded_xhttp_path
  if [[ -n "$route_index" ]]; then
    grpc_service_name=$(jq -r --argjson i "$route_index" '.routes[$i].grpc_service_name // ""' "$profile_file")
    xhttp_path=$(jq -r --argjson i "$route_index" '.routes[$i].xhttp_path // "/xhttp"' "$profile_file")
  else
    transport_metadata=$(read_profile_transport_metadata "$profile_file")
    IFS='|' read -r grpc_service_name xhttp_path <<< "$transport_metadata"
  fi
  encoded_xhttp_path=$(jq -nr --arg path "$xhttp_path" '$path|@uri')

  # Live-config guard: profile JSON должен совпадать с inbound по UUID, transport,
  # SNI, flow и transport metadata. Одного совпадения порта недостаточно: оно
  # пропускало осиротевшие и рассинхронизированные маршруты в subscription.
  if ! _profile_route_matches_live_inbound "$profile_file" "$route_index"; then
    return 1
  fi

  clean_public_key=$(_inbound_public_key_for_port "$port") || return 1

  # short_id — читаем из config.json по порту (зеркало логики generate_connection)
  local short_id
  short_id=$(jq -r --argjson p "$port" \
    '.inbounds[] | select(.port == $p) | .streamSettings.realitySettings.shortIds[0]' \
    "$CONFIG_FILE" 2>/dev/null)
  [[ -z "$short_id" || "$short_id" == "null" ]] && short_id=""

  case "$transport" in
    tcp|tcp-utls)
      printf 'vless://%s@%s:%s?encryption=none&flow=xtls-rprx-vision&security=reality&sni=%s&fp=%s&pbk=%s&sid=%s&type=tcp&headerType=none#%s' \
        "$uuid" "$server_ip" "$port" "$sni" "$fingerprint" "$clean_public_key" "$short_id" "$profile_name"
      ;;
    tcp-xudp)
      printf 'vless://%s@%s:%s?encryption=none&flow=xtls-rprx-vision&security=reality&sni=%s&fp=%s&pbk=%s&sid=%s&type=tcp&headerType=none&packetEncoding=xudp#%s' \
        "$uuid" "$server_ip" "$port" "$sni" "$fingerprint" "$clean_public_key" "$short_id" "$profile_name"
      ;;
    tcp-mux)
      printf 'vless://%s@%s:%s?encryption=none&security=reality&sni=%s&fp=%s&pbk=%s&sid=%s&type=tcp&headerType=none#%s' \
        "$uuid" "$server_ip" "$port" "$sni" "$fingerprint" "$clean_public_key" "$short_id" "$profile_name"
      ;;
    grpc)
      printf 'vless://%s@%s:%s?encryption=none&security=reality&sni=%s&fp=%s&pbk=%s&sid=%s&type=grpc&serviceName=%s&mode=gun#%s' \
        "$uuid" "$server_ip" "$port" "$sni" "$fingerprint" "$clean_public_key" "$short_id" "$grpc_service_name" "$profile_name"
      ;;
    xhttp)
      local pq_enabled
      if [[ -n "$route_index" ]]; then
        pq_enabled=$(jq -r --argjson i "$route_index" '.routes[$i].pq_enabled // false' "$profile_file" 2>/dev/null)
      else
        pq_enabled=$(jq -r '.pq_enabled // false' "$profile_file" 2>/dev/null)
      fi
      if [[ "$pq_enabled" == "true" ]]; then
        [[ -f "$VLESS_ENCRYPTION_FILE" ]] || return 1
        local raw_encryption encoded_encryption
        raw_encryption=$(cat "$VLESS_ENCRYPTION_FILE")
        encoded_encryption=$(jq -nr --arg enc "$raw_encryption" '$enc|@uri')
        printf 'vless://%s@%s:%s?encryption=%s&security=reality&sni=%s&fp=%s&pbk=%s&sid=%s&type=xhttp&path=%s&host=%s&mode=auto#%s' \
          "$uuid" "$server_ip" "$port" "$encoded_encryption" "$sni" "$fingerprint" "$clean_public_key" "$short_id" "$encoded_xhttp_path" "$sni" "$profile_name"
      else
        printf 'vless://%s@%s:%s?encryption=none&security=reality&sni=%s&fp=%s&pbk=%s&sid=%s&type=xhttp&path=%s&host=%s&mode=auto#%s' \
          "$uuid" "$server_ip" "$port" "$sni" "$fingerprint" "$clean_public_key" "$short_id" "$encoded_xhttp_path" "$sni" "$profile_name"
      fi
      ;;
    *)
      return 1
      ;;
  esac

  return 0
}

_profile_route_count() {
  local profile_file="$1"
  jq -r '(.routes // []) | length' "$profile_file" 2>/dev/null || echo 0
}

_generate_vless_urls_for_profile() {
  local profile_file="$1"
  [[ -f "$profile_file" ]] || return 1

  local old_addr_override="${XRAYEBATOR_SERVER_ADDR_OVERRIDE-}"
  local had_addr_override=0
  if [[ -n "${XRAYEBATOR_SERVER_ADDR_OVERRIDE+x}" ]]; then
    had_addr_override=1
  fi
  if [[ -z "${XRAYEBATOR_SERVER_ADDR_OVERRIDE:-}" ]]; then
    local resolved_addr
    resolved_addr=$(_connection_server_address) || return 1
    [[ -n "$resolved_addr" ]] || return 1
    XRAYEBATOR_SERVER_ADDR_OVERRIDE="$resolved_addr"
  fi

  local route_count
  route_count=$(_profile_route_count "$profile_file")
  local emitted=0
  if [[ "$route_count" =~ ^[0-9]+$ ]] && [[ "$route_count" -gt 0 ]]; then
    local i url
    for ((i=0; i<route_count; i++)); do
      if url=$(_generate_vless_url_pure "$profile_file" "$i"); then
        printf '%s\n' "$url"
        emitted=1
      fi
    done
  else
    local url
    if url=$(_generate_vless_url_pure "$profile_file"); then
      printf '%s\n' "$url"
      emitted=1
    fi
  fi

  if [[ "$had_addr_override" -eq 1 ]]; then
    XRAYEBATOR_SERVER_ADDR_OVERRIDE="$old_addr_override"
  else
    unset XRAYEBATOR_SERVER_ADDR_OVERRIDE
  fi

  [[ "$emitted" -eq 1 ]] || return 1
}

_profile_has_pq_route() {
  local profile_file="$1"
  jq -e '(.pq_enabled == true) or any((.routes // [])[]; .pq_enabled == true)' "$profile_file" >/dev/null 2>&1
}

_profile_live_route_count() {
  local profile_file="$1"
  [[ -f "$profile_file" ]] || { echo 0; return 1; }

  local route_count
  route_count=$(_profile_route_count "$profile_file")
  if [[ "$route_count" =~ ^[0-9]+$ ]] && [[ "$route_count" -gt 0 ]]; then
    local live=0
    local i
    for ((i=0; i<route_count; i++)); do
      if _profile_route_matches_live_inbound "$profile_file" "$i"; then
        ((live++))
      fi
    done
    echo "$live"
    [[ "$live" -gt 0 ]]
    return
  fi

  if _profile_route_matches_live_inbound "$profile_file"; then
    echo 1
    return 0
  fi

  echo 0
  return 1
}

# ═══════════════════════════════════════════════════════════
# Subscription base URL builder (Phase 7, Plan 7.2 / REQ-C03)
# ═══════════════════════════════════════════════════════════
# Читает /usr/local/etc/xray/.subscription_domain и .subscription_port (создаются Plan 7.3
# после установки публичного TLS). Возвращает на stdout канонично-сформированный base URL
# (без trailing slash, без /sub/<token>). Контракт:
#   - "http://127.0.0.1:8080"   — если domain == "127.0.0.1" (local-only fallback);
#   - "https://<domain>"        — если port == "443" (без явного указания порта в URL);
#   - "https://<domain>:<port>" — иначе (public TLS на 8443 и пр.).
# return: 0 всегда (даже при отсутствии маркеров — отдаёт default http://127.0.0.1:8080).
# Единственный источник истины для Plan 7.3 (manage_subscription_menu / create_profile
# success-screen / happ_subscription_menu status-line) и для subhttp.sh self-test.
_subscription_base_url() {
  local domain port
  domain=$(cat /usr/local/etc/xray/.subscription_domain 2>/dev/null || echo "127.0.0.1")
  port=$(cat /usr/local/etc/xray/.subscription_port 2>/dev/null || echo "8080")
  local host="$domain"
  if [[ "$host" == *:* && "$host" != \[* ]]; then
    host="[$host]"
  fi
  if [[ "$domain" == "127.0.0.1" ]]; then
    echo "http://${host}:${port}"
  elif [[ "$port" == "443" ]]; then
    echo "https://${host}"
  else
    echo "https://${host}:${port}"
  fi
  return 0
}

_subscription_is_local_only() {
  local domain port
  domain=$(cat /usr/local/etc/xray/.subscription_domain 2>/dev/null || echo "127.0.0.1")
  port=$(cat /usr/local/etc/xray/.subscription_port 2>/dev/null || echo "8080")
  [[ "$domain" == "127.0.0.1" || "$domain" == "localhost" || "$port" == "8080" ]]
}

# Пишет маркеры .subscription_* atomically и выставляет владельца xray.
# Args: $1=port, $2=domain, $3=server_addr, $4=mode (ip_tls|domain_tls|local_only)
_subscription_write_markers() {
  local port=$1 domain=$2 addr=$3 mode=$4
  printf '%s' "$port" > /usr/local/etc/xray/.subscription_port
  printf '%s' "$domain" > /usr/local/etc/xray/.subscription_domain
  printf '%s' "$addr" > /usr/local/etc/xray/.subscription_server_addr
  printf '%s' "$mode" > /usr/local/etc/xray/.subscription_mode
  chown root:root \
    /usr/local/etc/xray/.subscription_port \
    /usr/local/etc/xray/.subscription_domain \
    /usr/local/etc/xray/.subscription_server_addr \
    /usr/local/etc/xray/.subscription_mode 2>/dev/null || true
}

# Публичный TLS endpoint подписки реально подтверждён (P1-happ-fix)?
# Проверяем, что наш nginx vhost xrayebator-sub слушает 8443 ssl И сертификат для
# сервера выпущен и действует. Используется happ_setup_command вместо фабрикации
# маркеров: если endpoint не подтверждён — happ-setup вернёт ошибку, а не мёртвый URL.
# Args: $1=server_addr (IPv4/hostname)
_subscription_public_tls_endpoint_verified() {
  local server_addr="${1:-}"
  [[ -z "$server_addr" ]] && return 1
  # 1) Наш nginx vhost с TLS на 8443 существует.
  local vhost="/etc/nginx/sites-available/xrayebator-sub"
  if [[ ! -f "$vhost" ]] || ! grep -q "listen 8443 ssl" "$vhost" 2>/dev/null; then
    return 1
  fi
  # 2) Сертификат для адреса выпущен и файлы на месте.
  local cert_dir="/etc/letsencrypt/live/${server_addr}"
  if [[ ! -f "$cert_dir/fullchain.pem" || ! -f "$cert_dir/privkey.pem" ]]; then
    return 1
  fi
  # 3) nginx реально слушает 8443 (не просто конфиг).
  if command -v ss >/dev/null 2>&1; then
    if ! ss -ltn 2>/dev/null | grep -q ':8443'; then
      return 1
    fi
  fi
  # 4) Сертификат не истёк (openssl доступен).
  if command -v openssl >/dev/null 2>&1; then
    local end
    end=$(openssl x509 -enddate -noout -in "$cert_dir/fullchain.pem" 2>/dev/null | sed 's/notAfter=//')
    local now_epoch end_epoch
    now_epoch=$(date -u +%s)
    end_epoch=$(date -u -d "$end" +%s 2>/dev/null || echo 0)
    if [[ -z "$end_epoch" || "$end_epoch" -eq 0 || "$end_epoch" -le "$now_epoch" ]]; then
      return 1
    fi
  fi
  return 0
}

_connection_server_address() {
  if [[ -n "${XRAYEBATOR_SERVER_ADDR_OVERRIDE:-}" ]]; then
    echo "$XRAYEBATOR_SERVER_ADDR_OVERRIDE"
    return 0
  fi
  local selfsteal_domain mode domain saved_addr
  selfsteal_domain=$(_selfsteal_domain_value 2>/dev/null || true)
  if [[ -n "$selfsteal_domain" && "$selfsteal_domain" != "127.0.0.1" && "$selfsteal_domain" != "localhost" ]]; then
    echo "$selfsteal_domain"
    return 0
  fi

  mode=$(cat /usr/local/etc/xray/.subscription_mode 2>/dev/null || true)
  domain=$(cat /usr/local/etc/xray/.subscription_domain 2>/dev/null || true)
  if [[ "$mode" == "domain_tls" && -n "$domain" && "$domain" != "127.0.0.1" && "$domain" != "localhost" ]]; then
    echo "$domain"
    return 0
  fi

  saved_addr=$(cat /usr/local/etc/xray/.subscription_server_addr 2>/dev/null || true)
  if [[ -n "$saved_addr" && "$saved_addr" != "127.0.0.1" && "$saved_addr" != "localhost" ]]; then
    echo "$saved_addr"
    return 0
  fi

  if [[ "$mode" == "ip_tls" && "$domain" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "$domain"
    return 0
  fi

  if [[ -n "${SERVER_IP:-}" ]]; then
    echo "$SERVER_IP"
    return 0
  fi

  get_server_ip
}

_inbound_public_key_for_port() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] || return 1

  local inbound_private global_private global_public derived
  inbound_private=$(jq -r --argjson p "$port" \
    '.inbounds[]? | select(.port == $p) | .streamSettings.realitySettings.privateKey // empty' \
    "$CONFIG_FILE" 2>/dev/null) || return 1
  [[ -n "$inbound_private" && "$inbound_private" != "null" ]] || return 1

  global_private=$(cat "$PRIVATE_KEY_FILE" 2>/dev/null || true)
  global_public=$(cat "$PUBLIC_KEY_FILE" 2>/dev/null || true)
  if [[ -n "$global_private" && "$inbound_private" == "$global_private" && -n "$global_public" ]]; then
    echo "$global_public"
    return 0
  fi

  local xray_bin x25519_output
  if [[ -x /usr/local/bin/xray ]]; then
    xray_bin="/usr/local/bin/xray"
  else
    xray_bin=$(command -v xray 2>/dev/null || true)
  fi
  [[ -n "$xray_bin" ]] || return 1

  x25519_output=$("$xray_bin" x25519 -i "$inbound_private" 2>/dev/null) || return 1
  derived=$(echo "$x25519_output" | awk -F': ' '/^Public [Kk]ey:/ || /^Password/ {print $2; exit}')
  if [[ -z "$derived" ]]; then
    derived=$(echo "$x25519_output" | grep -oE '[A-Za-z0-9_+/=-]{43,44}' | tail -1)
  fi
  [[ -n "$derived" ]] || return 1
  echo "$derived"
}

_certbot_supports_ip_address() {
  local certbot_bin="${1:-certbot}"
  # Для IP-сертификатов нужен certbot 5.4+, который поддерживает И --ip-address,
  # И --preferred-profile (shortlived). Проверяем оба флага, иначе старый apt-certbot
  # упадёт с "unrecognized arguments" уже после установки nginx.
  "$certbot_bin" --help all 2>/dev/null | grep -q -- '--ip-address' \
    && "$certbot_bin" --help all 2>/dev/null | grep -q -- '--preferred-profile'
}

_ensure_certbot_ip_tls() {
  CERTBOT_IP_BIN=""

  local candidate
  for candidate in /snap/bin/certbot "$(command -v certbot 2>/dev/null || true)"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    if _certbot_supports_ip_address "$candidate"; then
      CERTBOT_IP_BIN="$candidate"
      return 0
    fi
  done

  echo -e "${YELLOW}  → Системный certbot не поддерживает IP certificates; ставлю актуальный certbot через snap...${NC}"
  if ! apt-get install -y snapd >/dev/null 2>&1; then
    echo -e "${RED}✗ Не удалось установить snapd для Certbot 5.4+${NC}"
    return 1
  fi

  systemctl enable --now snapd.socket >/dev/null 2>&1 || true
  export PATH="/snap/bin:$PATH"

  if command -v snap >/dev/null 2>&1; then
    if snap list core >/dev/null 2>&1; then
      snap refresh core >/tmp/snap-core.log 2>&1 || true
    elif ! snap install core >/tmp/snap-core.log 2>&1; then
      echo -e "${RED}✗ snap install core не удался. Лог: /tmp/snap-core.log${NC}"
      tail -20 /tmp/snap-core.log
      return 1
    fi

    if snap list certbot >/dev/null 2>&1; then
      snap refresh certbot >/tmp/snap-certbot.log 2>&1 || true
    elif ! snap install --classic certbot >/tmp/snap-certbot.log 2>&1; then
      echo -e "${RED}✗ snap install certbot не удался. Лог: /tmp/snap-certbot.log${NC}"
      tail -20 /tmp/snap-certbot.log
      return 1
    fi
  else
    echo -e "${RED}✗ snap command не найден после установки snapd${NC}"
    return 1
  fi

  for candidate in /snap/bin/certbot "$(command -v certbot 2>/dev/null || true)"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    if _certbot_supports_ip_address "$candidate"; then
      CERTBOT_IP_BIN="$candidate"
      return 0
    fi
  done

  echo -e "${RED}✗ Не найден Certbot 5.4+ с поддержкой --ip-address${NC}"
  return 1
}

# Устанавливает systemd timer, который каждые 12 часов пытается продлить shortlived
# IP-сертификаты (~6 дней жизни) и перезагружает nginx при успехе.
# Args: $1=certbot_bin, $2=cert_name, $3=webroot
_install_ip_cert_renew_timer() {
  local certbot_bin=$1 cert_name=$2 webroot=$3
  local unit="/etc/systemd/system/xrayebator-ip-renew.service"
  local timer="/etc/systemd/system/xrayebator-ip-renew.timer"

  cat > "$unit" << RENEWSVCEOF
[Unit]
Description=Xrayebator: renew shortlived IP TLS certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=${certbot_bin} renew --cert-name ${cert_name} --preferred-profile shortlived --webroot -w ${webroot}
ExecStartPost=/bin/systemctl reload nginx
RENEWSVCEOF

  cat > "$timer" << RENEWTIMEREOF
[Unit]
Description=Xrayebator: hourly shortlived IP TLS renewal attempt

[Timer]
OnBootSec=10min
OnUnitActiveSec=12h
# A10-fix: Persistent=true — отработать пропущенные срабатывания после простоя/выключения VPS.
# Иначе long-lived серт (~6 дней) тихо умирает, если машина не имела wake-up на своём расписании.
Persistent=true

[Install]
WantedBy=timers.target
RENEWTIMEREOF

  chmod 644 "$unit" "$timer"
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now "$(basename "$timer")" >/dev/null 2>&1 || true
}

# Проверяет активность renew timer для ip_tls подписки (для статус-строки TUI).
_ip_renew_timer_active() {
  systemctl is-active xrayebator-ip-renew.timer >/dev/null 2>&1
}

# ═══════════════════════════════════════════════════════════
# Certbot ownership manifest (P0-privilege-boundary fix)
# ═══════════════════════════════════════════════════════════
# Xrayebator регистрирует в root-owned манифесте /usr/local/etc/xray/.certbot_owned
# каждый сертификат, который ОН создал. uninstall.sh удаляет ТОЛЬКО перечисленные
# имена — чужие сертификаты на VPS (сайты, почта, другие сервисы) не затрагиваются.
# Манифест root:root 644 — подделать его может только root, поэтому содержимое
# доверенное. Вызывать СРАЗУ после успешного certbot certonly.
# Args: $1=cert_name (без слешей — валидируется в uninstall)
_certbot_register() {
  local cert_name="${1:-}"
  [[ -z "$cert_name" ]] && return 0
  local manifest="${CERTBOT_MANIFEST:-/usr/local/etc/xray/.certbot_owned}"
  # Идемпотентность: не дублируем имя при повторных запусках quickstart.
  if [[ ! -f "$manifest" ]]; then
    printf '%s\n' "$cert_name" > "$manifest"
  else
    if ! grep -qxF "$cert_name" "$manifest" 2>/dev/null; then
      printf '%s\n' "$cert_name" >> "$manifest"
    fi
  fi
  chmod 644 "$manifest" 2>/dev/null || true
  chown root:root "$manifest" 2>/dev/null || true
}

write_profile_transport_metadata() {
  local profile_file=$1
  local grpc_service_name=$2
  local xhttp_path=$3

  if ! safe_jq_write --arg grpc_service_name "$grpc_service_name" --arg xhttp_path "$xhttp_path" '
    if .transport == "grpc" then
      .grpc_service_name = ($grpc_service_name | select(length > 0))
    elif .transport == "xhttp" then
      .xhttp_path = ($xhttp_path | select(length > 0))
    else
      .
    end
  ' "$profile_file"; then
    return 1
  fi

  return 0
}

confirm_vision_443_risk() {
