    fi

    local selected="${profiles[$((pchoice-1))]}"

    while true; do
      show_ascii
      echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
      echo -e "${BLUE}    ДЕЙСТВИЯ С ПРОФИЛЕМ: $selected${NC}"
      echo -e "${BLUE}═══════════════════════════════════════════════${NC}\n"
      echo -e "${CYAN} 1)${NC} Изменить SNI (домен маскировки)"
      echo -e "${CYAN} 2)${NC} Изменить Fingerprint (браузер)"
      echo -e "${CYAN} 3)${NC} Изменить порт"
